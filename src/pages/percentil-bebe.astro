---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import PercentilBebeCalculator from '../components/calculators/PercentilBebeCalculator';

const faqs = [
  { q: '¿Qué es el percentil de un bebé?', a: 'El percentil compara el peso o la talla de tu bebé con los de otros bebés de su misma edad y sexo. Un percentil 50 significa que está justo en la media; un percentil 75, que supera al 75% de los bebés.' },
  { q: '¿Qué percentil es normal en un bebé?', a: 'Cualquier percentil entre 3 y 97 se considera dentro de la normalidad. Lo importante no es el número en sí, sino que tu bebé siga su propia curva de crecimiento de forma estable a lo largo del tiempo.' },
  { q: '¿Es malo que mi bebé tenga un percentil bajo?', a: 'No necesariamente. Hay bebés sanos en percentiles bajos, igual que en altos. Lo que preocupa al pediatra es una caída brusca de percentil o un estancamiento, no un valor bajo pero estable.' },
  { q: '¿Cómo se calcula el percentil?', a: 'Se compara la medida del bebé con las tablas de crecimiento de la OMS para su edad y sexo. Esta calculadora ofrece una estimación basada en la mediana y la desviación de esos estándares.' },
  { q: '¿Cada cuánto se mide el percentil?', a: 'En las revisiones del niño sano: con más frecuencia durante el primer año (al nacer, al mes, a los 2, 4, 6, 9 y 12 meses) y luego de forma más espaciada. La tendencia importa más que un dato aislado.' },
];
---

<CalculatorLayout
  title="Percentil del Bebé — Peso y Talla (OMS) | CalcFit"
  description="Calcula el percentil estimado de peso o talla de tu bebé según las tablas de la OMS por edad y sexo (0-24 meses). Gratis."
  calculatorName="Percentil del Bebé"
  breadcrumbSlug="percentil-bebe"
  ogImage="/og/percentil-bebe.jpg"
  keywords="percentil bebé, percentil peso bebé, percentil talla bebé, tablas crecimiento OMS, calcular percentil bebé"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Percentil<br><span style="color: var(--acid);">del Bebé</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Estima el percentil de peso o talla de tu bebé según los estándares de crecimiento de la OMS.
    </p>
  </div>

  <PercentilBebeCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se interpreta el percentil?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      El percentil sitúa a tu bebé respecto a una población de referencia de la misma edad y sexo. Esta calculadora ofrece una <strong>estimación</strong> a partir de la mediana y la dispersión de las tablas de la OMS (0-24 meses). No sustituye la valoración del pediatra, que analiza la curva completa de crecimiento.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Qué significa cada percentil</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Percentil</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Interpretación</th>
        </tr>
      </thead>
      <tbody>
        {[
          { p: '< P3', i: 'Por debajo de lo esperado' },
          { p: 'P3–P15', i: 'Rango bajo de la normalidad' },
          { p: 'P15–P85', i: 'Rango normal' },
          { p: '> P97', i: 'Por encima de lo esperado' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.p}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.i}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
