---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import CalcioDiarioCalculator from '../components/calculators/CalcioDiarioCalculator';

const faqs = [
  { q: '¿Cuánto calcio se necesita al día?', a: 'Un adulto sano necesita unos 1.000 mg de calcio al día. La cifra sube a 1.200 mg en mujeres mayores de 50 años y hombres mayores de 70, y a 1.300 mg en adolescentes.' },
  { q: '¿Qué alimentos tienen más calcio?', a: 'Los lácteos (leche, yogur, queso) son la fuente más conocida, pero también lo aportan las sardinas con espina, el tofu, las almendras, el sésamo y las verduras de hoja verde como el brócoli o la col rizada.' },
  { q: '¿Qué pasa si falta calcio?', a: 'Un déficit prolongado debilita los huesos y favorece la osteopenia y la osteoporosis, especialmente tras la menopausia. El cuerpo extrae calcio del hueso cuando la dieta no lo aporta suficiente.' },
  { q: '¿El calcio necesita vitamina D?', a: 'Sí. La vitamina D es imprescindible para absorber el calcio en el intestino. Por eso ambos nutrientes se valoran juntos en la salud ósea; puedes calcular tus minutos de sol en nuestra calculadora de vitamina D.' },
  { q: '¿Se puede tomar demasiado calcio?', a: 'El límite superior tolerable en adultos es de 2.500 mg al día. Pasarse de forma habitual, sobre todo con suplementos, puede causar cálculos renales y problemas digestivos. Prioriza el calcio de los alimentos.' },
];
---

<CalculatorLayout
  title="Calcio Diario Recomendado por Edad y Sexo | CalcFit"
  description="Calcula cuánto calcio necesitas al día según tu edad, sexo y etapa. Recomendación en mg para una buena salud ósea. Gratis."
  calculatorName="Calcio Diario"
  breadcrumbSlug="calcio-diario"
  ogImage="/og/calcio-diario.jpg"
  keywords="calcio diario, cuánto calcio al día, calcio recomendado por edad, calcio mujeres menopausia, necesidades de calcio"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Calcio<br><span style="color: var(--acid);">Diario</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Descubre cuántos miligramos de calcio necesitas al día según tu edad, sexo y etapa de la vida.
    </p>
  </div>

  <CalcioDiarioCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cuánto calcio necesitas?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Las recomendaciones de calcio varían con la edad y el sexo, y aumentan en la adolescencia (crecimiento óseo) y en la tercera edad (pérdida de masa ósea). El calcio trabaja junto con la vitamina D, que facilita su absorción. La mejor estrategia es cubrirlo con la alimentación.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Calcio recomendado (mg/día)</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Grupo</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Calcio</th>
        </tr>
      </thead>
      <tbody>
        {[
          { g: 'Niños 4–8 años', v: '1.000 mg' },
          { g: 'Adolescentes 9–18', v: '1.300 mg' },
          { g: 'Adultos 19–50', v: '1.000 mg' },
          { g: 'Mujeres > 50 / hombres > 70', v: '1.200 mg' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.g}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.v}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
