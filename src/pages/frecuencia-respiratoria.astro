---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import FrecuenciaRespiratoriaCalculator from '../components/calculators/FrecuenciaRespiratoriaCalculator';

const faqs = [
  { q: '¿Cuál es la frecuencia respiratoria normal?', a: 'En un adulto en reposo es de 12 a 20 respiraciones por minuto. En niños es más alta y disminuye con la edad: un recién nacido respira entre 30 y 60 veces por minuto.' },
  { q: '¿Cómo se mide la frecuencia respiratoria?', a: 'Cuenta cuántas veces se eleva el pecho durante 60 segundos, en reposo y sin que la persona lo note (porque al saberse observada tiende a alterar el ritmo). Cada ciclo de inspirar y espirar cuenta como una respiración.' },
  { q: '¿Qué significa una frecuencia respiratoria alta?', a: 'Más de 20 rpm en adultos se llama taquipnea. Puede deberse a esfuerzo, fiebre, ansiedad, dolor o problemas respiratorios. Si es persistente o se acompaña de dificultad para respirar, consulta a un profesional.' },
  { q: '¿Qué es una frecuencia respiratoria baja?', a: 'Menos de 12 rpm en adultos es bradipnea. Puede ser normal durante el sueño profundo o en personas muy entrenadas, pero también puede indicar efecto de fármacos o problemas neurológicos si es marcada.' },
  { q: '¿La frecuencia respiratoria cambia con la edad?', a: 'Sí. Los bebés y niños pequeños respiran mucho más rápido que los adultos. A medida que crecen, el rango normal va bajando hasta estabilizarse en 12-20 rpm en la adolescencia y la edad adulta.' },
];
---

<CalculatorLayout
  title="Frecuencia Respiratoria Normal por Edad | CalcFit"
  description="Comprueba si tu frecuencia respiratoria es normal según tu edad. Rangos para bebés, niños y adultos en respiraciones por minuto. Gratis."
  calculatorName="Frecuencia Respiratoria"
  breadcrumbSlug="frecuencia-respiratoria"
  ogImage="/og/frecuencia-respiratoria.jpg"
  keywords="frecuencia respiratoria normal, respiraciones por minuto, frecuencia respiratoria por edad, taquipnea, frecuencia respiratoria niños"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Frecuencia<br><span style="color: var(--acid);">Respiratoria</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Comprueba si tus respiraciones por minuto están dentro del rango normal para tu edad.
    </p>
  </div>

  <FrecuenciaRespiratoriaCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se interpreta?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      La frecuencia respiratoria es una de las constantes vitales básicas, junto con el pulso, la temperatura y la presión arterial. Se compara con el rango normal para la edad: por debajo se denomina <strong>bradipnea</strong> y por encima, <strong>taquipnea</strong>. Esta herramienta es orientativa y no sustituye una valoración médica.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Frecuencia respiratoria normal por edad</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Edad</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Rango normal (rpm)</th>
        </tr>
      </thead>
      <tbody>
        {[
          { e: 'Recién nacido (< 1 año)', r: '30–60' },
          { e: '1–3 años', r: '24–40' },
          { e: '3–6 años', r: '22–34' },
          { e: '6–12 años', r: '18–30' },
          { e: 'Adolescente y adulto', r: '12–20' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.e}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.r}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
