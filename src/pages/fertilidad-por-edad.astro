---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import FertilidadPorEdadCalculator from '../components/calculators/FertilidadPorEdadCalculator';

const faqs = [
  { q: '¿Cómo afecta la edad a la fertilidad?', a: 'La fertilidad de la mujer es máxima antes de los 30 y desciende de forma gradual a partir de ahí, con una caída más marcada después de los 35 y especialmente tras los 40, por la menor cantidad y calidad de óvulos.' },
  { q: '¿Cuál es la probabilidad de embarazo por ciclo?', a: 'En menores de 30 ronda el 20-25% por ciclo; entre 30 y 35 baja al 15%; entre 35 y 40, al 7-10%; y después de los 40, por debajo del 5%. Son cifras orientativas en parejas sanas.' },
  { q: '¿Cuándo debo consultar a un especialista?', a: 'Si tienes menos de 35 años y llevas un año buscando sin éxito, o si tienes 35 o más y llevas 6 meses, conviene consultar a un especialista en reproducción para valorar la situación.' },
  { q: '¿La edad del hombre también influye?', a: 'Sí, aunque de forma más lenta. A partir de los 45-50 años disminuyen la calidad y movilidad de los espermatozoides, lo que puede alargar el tiempo hasta el embarazo y aumentar ciertos riesgos.' },
  { q: '¿Qué es la reserva ovárica?', a: 'Es la cantidad de óvulos disponibles en los ovarios, que disminuye con la edad. Se puede valorar con análisis (hormona antimülleriana, AMH) y ecografía. Una reserva baja reduce las probabilidades de embarazo natural.' },
];
---

<CalculatorLayout
  title="Fertilidad según la Edad — Probabilidad | CalcFit"
  description="Descubre tu probabilidad de embarazo por ciclo y en un año según tu edad. Cómo cambia la fertilidad femenina con los años. Gratis."
  calculatorName="Fertilidad según la Edad"
  breadcrumbSlug="fertilidad-por-edad"
  ogImage="/og/fertilidad-por-edad.jpg"
  keywords="fertilidad por edad, probabilidad de embarazo por edad, fertilidad femenina edad, reserva ovárica, edad y embarazo"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Fertilidad<br><span style="color: var(--acid);">por Edad</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Estima tu probabilidad de concebir por ciclo y en un año según tu edad.
    </p>
  </div>

  <FertilidadPorEdadCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo cambia la fertilidad con la edad?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      La mujer nace con un número finito de óvulos que disminuye con los años, tanto en cantidad como en calidad. Por eso la probabilidad de embarazo por ciclo baja de forma progresiva y más rápidamente a partir de los 35 años. Estas cifras son orientativas y no contemplan problemas concretos de fertilidad.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Probabilidad orientativa de embarazo</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Edad</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Por ciclo</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">En 1 año</th>
        </tr>
      </thead>
      <tbody>
        {[
          { e: '< 30', c: '20–25%', a: '~91–96%' },
          { e: '30–34', c: '~15%', a: '~86%' },
          { e: '35–37', c: '~10%', a: '~78%' },
          { e: '> 40', c: '< 5%', a: '~40%' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.e}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.c}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.a}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
