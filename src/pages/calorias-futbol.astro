---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import CaloriasFutbolCalculator from '../components/calculators/CaloriasFutbolCalculator';

const faqs = [
  { q: '¿Cuántas calorías se queman jugando fútbol?', a: 'Una persona de 70 kg quema unas 515 kcal en un partido recreativo de 60 minutos y hasta 735 kcal en uno competitivo. El fútbol combina carrera continua, sprints y cambios de ritmo, lo que dispara el gasto.' },
  { q: '¿El fútbol adelgaza?', a: 'Sí. Es un ejercicio de alta intensidad que quema muchas calorías y mejora la resistencia, la agilidad y la salud cardiovascular. Para perder grasa, acompáñalo de una alimentación con déficit calórico.' },
  { q: '¿Cuántas calorías quema un partido de fútbol 7 o sala?', a: 'En fútbol sala o fútbol 7 el ritmo suele ser más intenso y continuo, con un gasto similar o superior al del fútbol 11 recreativo: entre 500 y 800 kcal por hora según tu peso y esfuerzo.' },
  { q: '¿Quema más el fútbol o correr?', a: 'A intensidad alta el fútbol puede igualar o superar a la carrera continua, porque suma sprints y aceleraciones. Sin embargo, incluye pausas, así que el gasto medio depende mucho del ritmo del partido.' },
  { q: '¿Cuántas veces a la semana jugar para estar en forma?', a: 'Jugar 2-3 veces por semana, junto con algo de fuerza y movilidad, es una excelente base de actividad. Recuerda calentar bien para reducir el riesgo de lesiones musculares típicas del fútbol.' },
];
---

<CalculatorLayout
  title="Calorías Jugando Fútbol — Cuántas Quemas | CalcFit"
  description="Calcula cuántas calorías quemas jugando fútbol según tu peso, los minutos y la intensidad del partido. Recreativo o competitivo. Gratis."
  calculatorName="Calorías Jugando Fútbol"
  breadcrumbSlug="calorias-futbol"
  ogImage="/og/calorias-futbol.jpg"
  keywords="calorías jugando fútbol, cuántas calorías quema el fútbol, gasto calórico fútbol, fútbol adelgaza, calorías partido de fútbol"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Calorías<br><span style="color: var(--acid);">Fútbol</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Descubre cuántas calorías quemas jugando fútbol, según tu peso, el tiempo y la intensidad del partido.
    </p>
  </div>

  <CaloriasFutbolCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Se usa la fórmula de los METs: <strong>kcal = MET × 3,5 × peso(kg) ÷ 200 × minutos</strong>. El fútbol recreativo tiene un MET de 7,0 y el competitivo, de 10,0. Como alterna carrera, sprints y cambios de dirección, su gasto medio es elevado.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Calorías por 60 minutos según peso</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Peso</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Recreativo</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Competitivo</th>
        </tr>
      </thead>
      <tbody>
        {[
          { p: '55 kg', r: '~404 kcal', c: '~578 kcal' },
          { p: '70 kg', r: '~515 kcal', c: '~735 kcal' },
          { p: '85 kg', r: '~625 kcal', c: '~893 kcal' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.p}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.r}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.c}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
