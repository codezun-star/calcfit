---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import CaloriasBailandoCalculator from '../components/calculators/CaloriasBailandoCalculator';

const faqs = [
  { q: '¿Cuántas calorías se queman bailando una hora?', a: 'Una persona de 70 kg quema unas 310 kcal con baile social, unas 380 kcal con zumba y hasta 440 kcal con baile intenso en una hora. El gasto sube con la intensidad y el peso corporal.' },
  { q: '¿Cuántas calorías quema una clase de zumba?', a: 'Una clase de zumba de 45-60 minutos quema entre 300 y 500 kcal según tu peso y la intensidad. Su carácter interválico la convierte en un cardio muy efectivo y divertido.' },
  { q: '¿Bailar adelgaza?', a: 'Sí, bailar de forma regular ayuda a crear el déficit calórico necesario para perder grasa, además de mejorar la coordinación, el ánimo y la salud cardiovascular. Combínalo con una alimentación adecuada.' },
  { q: '¿Qué tipo de baile quema más calorías?', a: 'Los estilos más enérgicos y continuos (zumba, aeróbic, bachata rápida, hip-hop) queman más que los bailes lentos. Cuanto más muevas todo el cuerpo y menos pausas hagas, mayor será el gasto.' },
  { q: '¿Es mejor bailar o caminar para quemar grasa?', a: 'Bailar a intensidad media-alta suele quemar más por minuto que caminar a ritmo ligero, y resulta más motivador para muchas personas. Lo mejor es el ejercicio que disfrutes y mantengas en el tiempo.' },
];
---

<CalculatorLayout
  title="Calorías Bailando — Zumba y Baile | CalcFit"
  description="Calcula cuántas calorías quemas bailando o en una clase de zumba según tu peso, el tiempo y el estilo. Cardio divertido y efectivo. Gratis."
  calculatorName="Calorías Bailando"
  breadcrumbSlug="calorias-bailando"
  ogImage="/og/calorias-bailando.jpg"
  keywords="calorías bailando, calorías zumba, cuántas calorías quema bailar, bailar adelgaza, gasto calórico baile"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Calorías<br><span style="color: var(--acid);">Bailando</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Descubre cuántas calorías quemas bailando o en una clase de zumba, según tu peso, el tiempo y el estilo.
    </p>
  </div>

  <CaloriasBailandoCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Se aplica la fórmula de los METs: <strong>kcal = MET × 3,5 × peso(kg) ÷ 200 × minutos</strong>. El baile social ronda un MET de 5,0; la zumba, 7,3; y el baile intenso o aeróbico, 8,5. A más intensidad y peso, mayor gasto.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Calorías por 60 minutos según estilo (70 kg)</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Estilo</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">MET</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Calorías</th>
        </tr>
      </thead>
      <tbody>
        {[
          { e: 'Social / salsa', met: '5,0', c: '~310 kcal' },
          { e: 'Zumba', met: '7,3', c: '~447 kcal' },
          { e: 'Baile intenso', met: '8,5', c: '~520 kcal' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.e}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.met}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.c}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
