---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import TiempoJuntosCalculator from '../components/calculators/TiempoJuntosCalculator';

const faqs = [
  { q: '¿Cuánto tiempo llevamos juntos?', a: 'Introduce la fecha en que empezó vuestra relación y la calculadora te dice los años, meses y días exactos que lleváis juntos, además del total de días y horas y los días que faltan para vuestro próximo aniversario.' },
  { q: '¿Cómo se calcula el tiempo desde una fecha?', a: 'Se compara la fecha de inicio con el día de hoy y se desglosa la diferencia en años, meses y días, ajustando los meses con distinto número de días. También se muestra el total acumulado en días y horas.' },
  { q: '¿Sirve para aniversarios de cualquier tipo?', a: 'Sí. Aunque es ideal para parejas, también puedes usarla para saber cuánto llevas en un trabajo, desde un viaje, desde que dejaste un hábito o desde cualquier fecha importante para ti.' },
  { q: '¿Cuándo es mi próximo aniversario?', a: 'La calculadora indica cuántos días faltan para que se cumpla un nuevo año desde la fecha de inicio, perfecto para no olvidar la celebración.' },
  { q: '¿Cuenta los años bisiestos?', a: 'Sí. El cálculo de días totales tiene en cuenta los años bisiestos, por lo que el resultado en días y horas es exacto.' },
];
---

<CalculatorLayout
  title="Tiempo Juntos — Calculadora de Aniversario | CalcFit"
  description="Calcula cuánto tiempo llevas en pareja o desde cualquier fecha: años, meses, días y horas, más tu próximo aniversario. Gratis."
  calculatorName="Tiempo Juntos"
  breadcrumbSlug="tiempo-juntos"
  ogImage="/og/tiempo-juntos.jpg"
  keywords="tiempo juntos, cuánto tiempo llevamos juntos, calculadora aniversario, tiempo desde una fecha, días en pareja"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Tiempo<br><span style="color: var(--acid);">Juntos</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Calcula cuánto tiempo llevas en pareja o desde cualquier fecha especial, hasta el día de hoy.
    </p>
  </div>

  <TiempoJuntosCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      La calculadora resta la fecha de inicio a la fecha de hoy y descompone el resultado en años, meses y días, ajustando los meses con distinto número de días. Además te ofrece el total acumulado en días y horas y los días que faltan para tu siguiente aniversario.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Aniversarios populares</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Aniversario</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Equivale a</th>
        </tr>
      </thead>
      <tbody>
        {[
          { a: '1 año', e: '365 días' },
          { a: '5 años', e: '~1.826 días' },
          { a: '10 años', e: '~3.652 días' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.a}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.e}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
