---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import ConversorTiempoCalculator from '../components/calculators/ConversorTiempoCalculator';

const faqs = [
  { q: '¿Cómo convierto minutos a horas?', a: 'Divide los minutos entre 60. Por ejemplo, 90 minutos son 1,5 horas y 150 minutos son 2,5 horas. La calculadora hace la conversión a todas las unidades a la vez.' },
  { q: '¿Cuántos segundos tiene una hora?', a: 'Una hora tiene 3.600 segundos (60 minutos × 60 segundos). Un día tiene 86.400 segundos y una semana, 604.800 segundos.' },
  { q: '¿Cuántas horas tiene un día y una semana?', a: 'Un día tiene 24 horas y una semana tiene 168 horas (24 × 7). La calculadora te permite convertir entre segundos, minutos, horas, días y semanas al instante.' },
  { q: '¿Para qué sirve un conversor de tiempo?', a: 'Es útil para deportes (pasar minutos a segundos), estudios, programación, planificación de proyectos o simplemente para entender una duración en la unidad que prefieras.' },
  { q: '¿Convierte decimales?', a: 'Sí. Puedes introducir valores con decimales, como 1,5 horas o 2,25 días, y obtendrás el equivalente exacto en el resto de unidades.' },
];
---

<CalculatorLayout
  title="Conversor de Tiempo — Segundos, Horas, Días | CalcFit"
  description="Convierte entre segundos, minutos, horas, días y semanas al instante. Conversor de unidades de tiempo gratis y sin registro."
  calculatorName="Conversor de Tiempo"
  breadcrumbSlug="conversor-tiempo"
  ogImage="/og/conversor-tiempo.jpg"
  keywords="conversor de tiempo, convertir minutos a horas, segundos a horas, horas a días, conversor unidades tiempo"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Conversor<br><span style="color: var(--acid);">de Tiempo</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Convierte entre segundos, minutos, horas, días y semanas al instante.
    </p>
  </div>

  <ConversorTiempoCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo funciona?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Introduce un valor y su unidad, y la calculadora lo convierte a segundos, minutos, horas, días y semanas usando los factores estándar. Todas las equivalencias se basan en que 1 minuto = 60 segundos, 1 hora = 60 minutos, 1 día = 24 horas y 1 semana = 7 días.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Equivalencias de tiempo</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Unidad</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">En segundos</th>
        </tr>
      </thead>
      <tbody>
        {[
          { u: '1 minuto', s: '60 s' },
          { u: '1 hora', s: '3.600 s' },
          { u: '1 día', s: '86.400 s' },
          { u: '1 semana', s: '604.800 s' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.u}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.s}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
