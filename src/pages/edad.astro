---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import EdadCalculator from '../components/calculators/EdadCalculator';
---

<CalculatorLayout
  title="Calculadora de Edad Exacta en Años, Meses y Días | CalcFit"
  description="Calcula tu edad exacta en años, meses, días y horas. También te dice cuántos días faltan para tu próximo cumpleaños."
  calculatorName="Calculadora de Edad"
  breadcrumbSlug="edad"
  ogImage="/og/edad.jpg"
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: 64px; color: white; line-height: 0.92; margin-bottom: 12px;">
      Calculadora<br><span style="color: var(--acid);">de Edad</span>
    </h1>
    <p style="font-size: 13px; color: #666; max-width: 480px; line-height: 1.7;">
      Descubre tu edad exacta en años, meses y días, junto con el total de días que has vivido y cuándo es tu próximo cumpleaños.
    </p>
  </div>

  <EdadCalculator client:load />

  <div slot="seo">
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted);">
      Esta calculadora determina tu edad exacta comparando tu fecha de nacimiento con la fecha actual, teniendo en cuenta los años bisiestos y los meses de diferente duración.
    </p>
  </div>
</CalculatorLayout>
