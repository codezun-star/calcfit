---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import MasaMagraCalculator from '../components/calculators/MasaMagraCalculator';

const faqs = [
  { q: '¿Qué es la masa corporal magra?', a: 'La masa magra (LBM) es el peso de tu cuerpo sin contar la grasa: músculos, huesos, órganos, agua y tejido conectivo. Es un indicador clave del estado físico y del metabolismo basal.' },
  { q: '¿Cómo se calcula la masa magra?', a: 'Esta calculadora usa la fórmula de Boer, que estima la masa magra a partir del peso, la altura y el sexo. Para hombres: 0,407×peso + 0,267×altura − 19,2; para mujeres: 0,252×peso + 0,473×altura − 48,3.' },
  { q: '¿Cuál es un porcentaje de masa magra saludable?', a: 'En hombres suele situarse entre el 75% y el 90% del peso corporal, y en mujeres entre el 70% y el 85%, según el nivel de grasa. Cuanta más masa magra y menos grasa, mejor composición corporal.' },
  { q: '¿En qué se diferencia de la masa muscular?', a: 'La masa muscular es solo el tejido muscular, mientras que la masa magra incluye además huesos, órganos y agua. Por eso la masa magra siempre es mayor que la masa muscular.' },
  { q: '¿Para qué sirve conocer la masa magra?', a: 'Es útil para ajustar la ingesta de proteína, calcular dosis de medicamentos, estimar el metabolismo y seguir tu progreso en recomposición corporal. Perder grasa manteniendo la masa magra es el objetivo ideal.' },
];
---

<CalculatorLayout
  title="Masa Corporal Magra (LBM) — Fórmula Boer | CalcFit"
  description="Calcula tu masa corporal magra y tu masa grasa con la fórmula de Boer a partir de tu peso, altura y sexo. Conoce tu composición corporal. Gratis."
  calculatorName="Masa Corporal Magra (LBM)"
  breadcrumbSlug="masa-magra"
  ogImage="/og/masa-magra.jpg"
  keywords="masa magra, masa corporal magra, LBM, calcular masa magra, fórmula de Boer, masa libre de grasa"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Masa<br><span style="color: var(--acid);">Magra</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Estima tu masa corporal magra (sin grasa) y tu masa grasa con la fórmula de Boer a partir de tu peso, altura y sexo.
    </p>
  </div>

  <MasaMagraCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      La fórmula de Boer estima la masa libre de grasa con el peso, la altura y el sexo. Es uno de los métodos más utilizados en clínica por su buena correlación con técnicas de referencia como la densitometría (DEXA). La masa grasa se obtiene restando la masa magra al peso total.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Porcentaje de masa magra orientativo</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Nivel</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Hombres</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Mujeres</th>
        </tr>
      </thead>
      <tbody>
        {[
          { n: 'Atlético', h: '88–90%', m: '82–85%' },
          { n: 'Saludable', h: '82–88%', m: '75–82%' },
          { n: 'Mejorable', h: '< 80%', m: '< 73%' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.n}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.h}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.m}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
