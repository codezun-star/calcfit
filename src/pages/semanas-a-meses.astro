---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import SemanasAMesesCalculator from '../components/calculators/SemanasAMesesCalculator';

const faqs = [
  { q: '¿Cómo se convierten las semanas de embarazo en meses?', a: 'No es una división exacta por 4, porque el embarazo dura 40 semanas repartidas en 9 meses de forma irregular. Por ejemplo, el quinto mes abarca de la semana 18 a la 22 aproximadamente.' },
  { q: '¿Cuántas semanas tiene cada mes de embarazo?', a: 'Los primeros meses tienen 4-5 semanas y los del segundo trimestre suelen abarcar 4-5 semanas también. El último mes (el noveno) cubre de la semana 36 a la 40, e incluso hasta la 42.' },
  { q: '¿De cuántos meses estoy si tengo 20 semanas?', a: 'A las 20 semanas estás en el quinto mes de embarazo y en pleno segundo trimestre, justo en el ecuador de la gestación. Es cuando suele hacerse la ecografía morfológica.' },
  { q: '¿En qué semana empieza el tercer trimestre?', a: 'El tercer trimestre comienza en la semana 28 y dura hasta el parto. El primer trimestre va de la semana 1 a la 13, y el segundo de la 14 a la 27.' },
  { q: '¿Por qué el embarazo dura 9 meses pero 40 semanas?', a: '40 semanas equivalen a unos 9 meses y una semana del calendario. La cuenta en semanas es más precisa para el seguimiento médico, por eso los profesionales hablan de semanas y no de meses.' },
];
---

<CalculatorLayout
  title="Semanas a Meses de Embarazo — Conversor | CalcFit"
  description="Convierte tus semanas de embarazo en meses y descubre tu trimestre. Tabla de equivalencias semana a mes de gestación. Gratis."
  calculatorName="Semanas a Meses de Embarazo"
  breadcrumbSlug="semanas-a-meses"
  ogImage="/og/semanas-a-meses.jpg"
  keywords="semanas a meses embarazo, cuántos meses son las semanas de embarazo, conversor semanas meses, de cuántos meses estoy, trimestre embarazo"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Semanas a<br><span style="color: var(--acid);">Meses</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Convierte tus semanas de embarazo en meses y descubre en qué trimestre te encuentras.
    </p>
  </div>

  <SemanasAMesesCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se cuentan los meses de embarazo?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Los médicos cuentan el embarazo en semanas porque es más preciso, pero socialmente seguimos hablando de meses. La equivalencia no es exacta: 40 semanas se reparten en 9 meses con un número variable de semanas cada uno. Esta calculadora usa la correspondencia obstétrica habitual.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Tabla de equivalencias</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Mes</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Semanas</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Trimestre</th>
        </tr>
      </thead>
      <tbody>
        {[
          { m: 'Mes 1–3', s: '1–13', t: '1.º' },
          { m: 'Mes 4–6', s: '14–27', t: '2.º' },
          { m: 'Mes 7–9', s: '28–40', t: '3.º' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.m}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.s}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.t}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
