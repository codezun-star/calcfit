---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import ContadorContraccionesCalculator from '../components/calculators/ContadorContraccionesCalculator';

const faqs = [
  { q: '¿Cuándo debo ir al hospital por las contracciones?', a: 'La referencia más usada es la regla 5-1-1: cuando las contracciones llegan cada 5 minutos, duran alrededor de 1 minuto y se mantienen así durante 1 hora. En embarazos de riesgo o segundos partos, tu médico puede indicarte acudir antes.' },
  { q: '¿Cómo se mide la frecuencia de las contracciones?', a: 'La frecuencia se mide desde el inicio de una contracción hasta el inicio de la siguiente, no desde que termina una. Esta calculadora lo hace automáticamente: solo pulsas al empezar y al terminar cada contracción.' },
  { q: '¿Cuánto dura una contracción de parto?', a: 'Las contracciones del trabajo de parto activo suelen durar entre 45 y 70 segundos. Si son muy cortas (menos de 30 s) e irregulares, probablemente sean contracciones de práctica (Braxton Hicks) y no parto verdadero.' },
  { q: '¿Cómo distingo el parto real de las contracciones falsas?', a: 'Las contracciones de parto real son regulares, se acortan los intervalos, aumentan en intensidad y no ceden al cambiar de postura o reposar. Las de Braxton Hicks son irregulares, no se intensifican y suelen desaparecer al descansar o hidratarse.' },
  { q: '¿Se guardan mis datos en algún lugar?', a: 'No. Todo el registro ocurre en tu navegador y no se envía a ningún servidor ni se almacena al cerrar la página. Es una herramienta orientativa y no sustituye la valoración de tu matrona o médico.' },
];
---

<CalculatorLayout
  title="Contador de Contracciones de Parto | CalcFit"
  description="Cronometra tus contracciones de parto y mide su frecuencia y duración. Aplica la regla 5-1-1 para saber cuándo ir al hospital. Gratis, sin registro."
  calculatorName="Contador de Contracciones"
  breadcrumbSlug="contador-contracciones"
  ogImage="/og/contador-contracciones.jpg"
  keywords="contador de contracciones, cada cuánto son las contracciones, contracciones de parto, regla 5-1-1, cronómetro de contracciones"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Contador de<br><span style="color: var(--acid);">Contracciones</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Cronometra tus contracciones con un solo botón y conoce su frecuencia y duración media. Te avisa cuándo cumples la regla 5-1-1 para acudir al hospital.
    </p>
  </div>

  <ContadorContraccionesCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo funciona el contador de contracciones?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Pulsa el botón al iniciar una contracción y vuelve a pulsarlo cuando termine. La herramienta registra la <strong>duración</strong> de cada una y la <strong>frecuencia</strong> (tiempo entre el inicio de una y el inicio de la siguiente), promediando las últimas contracciones. Cuando el patrón se acerca a la regla 5-1-1, te lo indica con una alerta de color.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Fases del trabajo de parto</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 340px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Fase</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Frecuencia</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Qué hacer</th>
        </tr>
      </thead>
      <tbody>
        {[
          { f: 'Temprana', fr: 'Cada >10 min', q: 'Descansar e hidratarse' },
          { f: 'Activa', fr: 'Cada 5-10 min', q: 'Prepararse para salir' },
          { f: 'Ir al hospital', fr: 'Cada ≤5 min, ~1 min', q: 'Acudir / llamar al médico' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.f}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.fr}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.q}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
    <p style="font-size: 12px; color: var(--muted); line-height: 1.7; margin-bottom: 24px;">
      Esta herramienta es orientativa y no sustituye la valoración médica. Ante cualquier duda, sangrado, fiebre o reducción de movimientos del bebé, contacta de inmediato con tu matrona o servicio de urgencias.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
