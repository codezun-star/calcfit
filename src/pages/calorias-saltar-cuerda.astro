---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import CaloriasSaltarCuerdaCalculator from '../components/calculators/CaloriasSaltarCuerdaCalculator';

const faqs = [
  { q: '¿Cuántas calorías se queman saltando la cuerda?', a: 'Una persona de 70 kg quema unas 130 kcal saltando 10 minutos a ritmo moderado y hasta 200 kcal a ritmo rápido. Es uno de los ejercicios con mayor gasto calórico por minuto.' },
  { q: '¿Saltar la cuerda quema más que correr?', a: 'A intensidad alta, saltar la cuerda puede igualar o superar el gasto de correr, con un MET de 11-12 frente a los 8-10 de la carrera moderada. Además trabaja coordinación, pantorrillas y core.' },
  { q: '¿Cuánto tiempo debo saltar para quemar grasa?', a: 'Empieza con 5-10 minutos en series cortas e incrementa hasta 20-30 minutos. Quemar grasa depende del déficit calórico semanal total, no solo de una sesión aislada.' },
  { q: '¿Saltar la cuerda adelgaza la barriga?', a: 'No existe la pérdida localizada de grasa. Saltar la cuerda quema calorías que ayudan a reducir la grasa corporal global, incluida la abdominal, si hay déficit calórico.' },
  { q: '¿Es malo saltar la cuerda todos los días?', a: 'Para la mayoría es seguro con técnica correcta y buen calzado, pero conviene alternar intensidades y dar descanso a tobillos y rodillas. Si tienes sobrepeso o lesiones, empieza con sesiones cortas.' },
];
---

<CalculatorLayout
  title="Calorías Saltando la Cuerda — Cuántas Quemas | CalcFit"
  description="Calcula cuántas calorías quemas saltando la cuerda según tu peso, los minutos y la intensidad. Uno de los ejercicios más eficientes. Gratis."
  calculatorName="Calorías Saltando la Cuerda"
  breadcrumbSlug="calorias-saltar-cuerda"
  ogImage="/og/calorias-saltar-cuerda.jpg"
  keywords="calorías saltar la cuerda, cuántas calorías quema saltar cuerda, comba calorías, saltar cuerda adelgaza, gasto calórico comba"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Saltar la<br><span style="color: var(--acid);">Cuerda</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Descubre cuántas calorías quemas con la comba según tu peso, el tiempo y la intensidad del salto.
    </p>
  </div>

  <CaloriasSaltarCuerdaCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      El gasto se calcula con la fórmula de los METs: <strong>kcal = MET × 3,5 × peso(kg) ÷ 200 × minutos</strong>. Saltar la cuerda tiene un MET de entre 8,8 (suave) y 12,3 (rápido), uno de los más altos entre los ejercicios populares, lo que lo convierte en una opción muy eficiente.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Calorías por 15 minutos según peso</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Peso</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Moderado</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Rápido</th>
        </tr>
      </thead>
      <tbody>
        {[
          { p: '55 kg', m: '~170 kcal', r: '~180 kcal' },
          { p: '70 kg', m: '~217 kcal', r: '~226 kcal' },
          { p: '85 kg', m: '~263 kcal', r: '~275 kcal' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.p}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.m}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.r}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
