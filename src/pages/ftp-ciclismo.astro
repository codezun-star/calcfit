---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import FTPCiclismoCalculator from '../components/calculators/FTPCiclismoCalculator';

const faqs = [
  { q: '¿Qué es el FTP en ciclismo?', a: 'El FTP (Umbral de Potencia Funcional) es la potencia máxima que puedes mantener durante 1 hora sin fatigarte. Es la métrica de referencia para planificar el entrenamiento por potencia en ciclismo y triatlón.' },
  { q: '¿Cómo se calcula el FTP con el test de 20 minutos?', a: 'Calientas 15–20 minutos, luego pedaleas al máximo esfuerzo sostenible durante 20 minutos y multiplicas la potencia media por 0.95. Este factor corrige la diferencia entre 20 y 60 minutos de esfuerzo.' },
  { q: '¿Qué son las zonas de entrenamiento FTP?', a: 'Son 6 rangos de intensidad basados en porcentajes del FTP: Z1 recuperación (<55%), Z2 base aeróbica (55–75%), Z3 tempo (76–90%), Z4 umbral (91–105%), Z5 VO₂ máx (106–120%) y Z6 anaeróbico (>120%). Cada zona estimula adaptaciones fisiológicas distintas.' },
  { q: '¿Cada cuánto tiempo debo repetir el test FTP?', a: 'Se recomienda repetir el test cada 6–8 semanas de entrenamiento estructurado. El FTP mejora con el entrenamiento y las zonas deben actualizarse para seguir siendo efectivas.' },
  { q: '¿Qué W/kg es un buen FTP?', a: 'Para ciclistas amateur, 2.5–3.4 W/kg es un nivel intermedio (categorías 3–4). Los ciclistas profesionales de Grand Tour alcanzan 5.5–6.5 W/kg. Mejorar el FTP requiere combinar entrenamiento Z2 de base con intervalos en Z4–Z5.' },
];
---

<CalculatorLayout
  title="Calculadora FTP Ciclismo — Umbral de Potencia y Zonas | CalcFit"
  description="Calcula tu FTP con test de 20 min, 8 min o rampa. Obtén tus 6 zonas de entrenamiento por potencia en vatios. Gratis, sin registro."
  calculatorName="FTP Ciclismo"
  breadcrumbSlug="ftp-ciclismo"
  ogImage="/og/ftp-ciclismo.jpg"
  keywords="calculadora FTP ciclismo, umbral de potencia funcional, zonas entrenamiento ciclismo, test FTP 20 minutos, vatios por kilo ciclismo"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      FTP<br><span style="color: var(--acid);">Ciclismo</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Calcula tu Umbral de Potencia Funcional (FTP) y tus 6 zonas de entrenamiento por vatios según tu protocolo de test.
    </p>
  </div>

  <FTPCiclismoCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Qué es el FTP y cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      El FTP (Functional Threshold Power) es la potencia máxima sostenible durante 60 minutos. Fue popularizado por el Dr. Andrew Coggan y es la base del entrenamiento por potencia en ciclismo. Existen tres protocolos principales: test de 20 minutos (FTP = potencia × 0.95), test de 8 minutos (FTP = potencia × 0.90) y test de rampa (FTP = potencia pico × 0.75).
    </p>

    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px;">
      <thead>
        <tr style="background: var(--ink); color: var(--acid);">
          <th style="padding: 10px 14px; text-align: left; font-family: var(--font-mono); font-weight: 400;">Zona</th>
          <th style="padding: 10px 14px; text-align: left;">% FTP</th>
          <th style="padding: 10px 14px; text-align: left;">Objetivo</th>
        </tr>
      </thead>
      <tbody>
        {[
          ['Z1 — Recuperación', '<55%', 'Recuperación activa, días fáciles'],
          ['Z2 — Base aeróbica', '55–75%', 'Resistencia fundamental, mejora mitocondrial'],
          ['Z3 — Tempo', '76–90%', 'Eficiencia aeróbica, rodadas largas'],
          ['Z4 — Umbral', '91–105%', 'Intervalos al umbral de lactato'],
          ['Z5 — VO₂ máx', '106–120%', 'Potencia aeróbica máxima, series cortas'],
          ['Z6 — Anaeróbico', '>120%', 'Sprints y potencia neuromuscular'],
        ].map(([z, p, o], i) => (
          <tr style={`background: ${i % 2 === 0 ? 'white' : '#f9f6f0'};`}>
            <td style="padding: 10px 14px; font-family: var(--font-mono); font-size: 12px;">{z}</td>
            <td style="padding: 10px 14px;">{p}</td>
            <td style="padding: 10px 14px; color: var(--muted);">{o}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
