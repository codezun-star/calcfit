---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import SumarRestarDiasCalculator from '../components/calculators/SumarRestarDiasCalculator';

const faqs = [
  { q: '¿Cómo sumo días a una fecha?', a: 'Selecciona la fecha de partida, elige la operación "sumar" e introduce el número de días, meses o años que quieres añadir. La calculadora te devuelve la fecha resultante y el día de la semana exacto al instante.' },
  { q: '¿La calculadora tiene en cuenta los años bisiestos?', a: 'Sí. El cálculo usa el calendario real del navegador, por lo que respeta los meses de distinta duración y los años bisiestos (febrero con 29 días). El resultado es exacto para cualquier fecha pasada o futura.' },
  { q: '¿Para qué sirve sumar o restar días a una fecha?', a: 'Es útil para calcular vencimientos de plazos legales o administrativos, fechas de entrega, garantías, periodos de prueba, aniversarios o cualquier evento que dependa de "X días a partir de hoy".' },
  { q: '¿Qué diferencia hay con la calculadora de días entre fechas?', a: 'Esta calcula una fecha NUEVA sumando o restando un periodo a una fecha conocida. La calculadora de días entre fechas hace lo contrario: mide cuántos días hay ENTRE dos fechas que ya conoces.' },
  { q: '¿Cuenta el día inicial dentro del resultado?', a: 'No. El desplazamiento se aplica a partir de la fecha base, que no se cuenta como día 1. Si sumas 7 días a un lunes, obtienes el lunes siguiente, tal como se cuenta habitualmente en plazos.' },
];
---

<CalculatorLayout
  title="Sumar o Restar Días a una Fecha | CalcFit"
  description="Calcula qué fecha será al sumar o restar días, meses o años a una fecha. Muestra el día de la semana exacto. Ideal para plazos y vencimientos. Gratis."
  calculatorName="Sumar o Restar Días"
  breadcrumbSlug="sumar-restar-dias"
  ogImage="/og/sumar-restar-dias.jpg"
  keywords="sumar días a una fecha, restar días a una fecha, calcular fecha futura, qué día será, calculadora de fechas"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Sumar o Restar<br><span style="color: var(--acid);">Días</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Añade o quita días, meses o años a cualquier fecha y descubre el día exacto resultante. Perfecta para plazos, vencimientos y planificación.
    </p>
  </div>

  <SumarRestarDiasCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula la fecha resultante?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      La calculadora parte de la fecha que indiques y le aplica el desplazamiento (días, meses y/o años) en la dirección elegida. Usa el calendario gregoriano real, por lo que respeta automáticamente los meses de 28, 30 y 31 días y los años bisiestos. Además te indica en qué <strong>día de la semana</strong> cae el resultado.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Equivalencias rápidas</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 300px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Periodo</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Equivale a</th>
        </tr>
      </thead>
      <tbody>
        {[
          { p: '1 semana', e: '7 días' },
          { p: '1 mes', e: '~30-31 días' },
          { p: '1 trimestre', e: '~90 días' },
          { p: '6 meses', e: '~182 días' },
          { p: '1 año', e: '365 días (366 si es bisiesto)' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.p}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.e}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
