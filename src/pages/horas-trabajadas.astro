---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import HorasTrabajadasCalculator from '../components/calculators/HorasTrabajadasCalculator';

const faqs = [
  { q: '¿Cómo se calculan las horas trabajadas?', a: 'Se resta la hora de entrada a la de salida y se descuenta el tiempo de descanso o comida. La calculadora gestiona también los turnos nocturnos, en los que la salida es al día siguiente.' },
  { q: '¿Qué son las horas decimales?', a: 'Es el tiempo trabajado expresado en formato decimal en lugar de horas y minutos. Por ejemplo, 8 horas y 30 minutos equivalen a 8,5 horas decimales, el formato que usan muchas nóminas.' },
  { q: '¿Cómo paso minutos a formato decimal?', a: 'Divide los minutos entre 60. Así, 15 minutos son 0,25; 30 minutos son 0,5; y 45 minutos son 0,75. La calculadora te da automáticamente el valor en horas y minutos y en decimal.' },
  { q: '¿Cómo calculo un turno de noche?', a: 'Introduce la hora de entrada y la de salida normalmente, aunque la salida sea del día siguiente (por ejemplo, de 22:00 a 06:00). La calculadora detecta el cambio de día y suma las 24 horas necesarias.' },
  { q: '¿Se descuenta la pausa de la comida?', a: 'Sí, si indicas los minutos de descanso. Muchas jornadas incluyen una pausa para comer que no se contabiliza como tiempo trabajado; introdúcela para obtener las horas netas.' },
];
---

<CalculatorLayout
  title="Calculadora de Horas Trabajadas | CalcFit"
  description="Calcula tus horas trabajadas restando entrada, salida y descanso. Incluye turnos nocturnos y horas en formato decimal. Gratis."
  calculatorName="Horas Trabajadas"
  breadcrumbSlug="horas-trabajadas"
  ogImage="/og/horas-trabajadas.jpg"
  keywords="calculadora horas trabajadas, calcular horas de trabajo, horas trabajadas decimal, horas turno nocturno, contar horas trabajo"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Horas<br><span style="color: var(--acid);">Trabajadas</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Calcula las horas que has trabajado a partir de tu entrada, salida y descanso, también en turnos de noche.
    </p>
  </div>

  <HorasTrabajadasCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Se calcula la diferencia entre la hora de salida y la de entrada y se le resta el tiempo de descanso. Si la salida es anterior a la entrada (turno nocturno), se suman 24 horas. El resultado se muestra en horas y minutos y en <strong>horas decimales</strong>, útil para nóminas y partes de trabajo.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Minutos a formato decimal</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Minutos</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Decimal</th>
        </tr>
      </thead>
      <tbody>
        {[
          { m: '15 min', d: '0,25' },
          { m: '30 min', d: '0,50' },
          { m: '45 min', d: '0,75' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.m}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.d}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
