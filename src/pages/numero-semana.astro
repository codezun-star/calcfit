---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import NumeroSemanaCalculator from '../components/calculators/NumeroSemanaCalculator';

const faqs = [
  { q: '¿Qué es el número de semana del año?', a: 'Es la posición de una semana dentro del año, del 1 al 52 o 53. Según el estándar ISO 8601, las semanas empiezan en lunes y la semana 1 es la que contiene el primer jueves del año.' },
  { q: '¿En qué semana del año estamos?', a: 'Introduce la fecha de hoy y la calculadora te indica el número de semana ISO actual, junto con el día del año y el trimestre. Es habitual usarlo en empresas y logística.' },
  { q: '¿Cuántas semanas tiene un año?', a: 'La mayoría de los años tienen 52 semanas, pero algunos tienen 53. Esto ocurre cuando el año empieza en jueves, o en miércoles si es bisiesto.' },
  { q: '¿Por qué la semana 1 puede empezar en diciembre?', a: 'Porque la norma ISO asigna la semana 1 a la del primer jueves del año. Si ese jueves cae a principios de enero, los últimos días de diciembre pueden pertenecer ya a la semana 1 del año siguiente.' },
  { q: '¿Para qué se usa el número de semana?', a: 'Es muy común en logística, producción, planificación de proyectos y calendarios laborales europeos, donde se programan tareas y entregas por "semana 32" en lugar de por fechas concretas.' },
];
---

<CalculatorLayout
  title="Número de Semana del Año (ISO 8601) | CalcFit"
  description="Calcula en qué número de semana del año cae una fecha según el estándar ISO 8601, con el día del año y el trimestre. Gratis."
  calculatorName="Número de Semana del Año"
  breadcrumbSlug="numero-semana"
  ogImage="/og/numero-semana.jpg"
  keywords="número de semana, semana del año, en qué semana estamos, semana ISO 8601, calcular semana del año"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Número de<br><span style="color: var(--acid);">Semana</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Descubre en qué número de semana del año cae cualquier fecha según el estándar ISO 8601.
    </p>
  </div>

  <NumeroSemanaCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Se aplica el estándar internacional <strong>ISO 8601</strong>: las semanas comienzan en lunes y la semana 1 del año es la que contiene su primer jueves. Por eso es el sistema usado en calendarios laborales y software de gestión en gran parte del mundo.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Reglas del sistema ISO</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Regla</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Valor</th>
        </tr>
      </thead>
      <tbody>
        {[
          { r: 'Primer día de la semana', v: 'Lunes' },
          { r: 'Semana 1', v: 'La del primer jueves' },
          { r: 'Semanas al año', v: '52 o 53' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.r}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.v}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
