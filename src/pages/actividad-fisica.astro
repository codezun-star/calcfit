---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import ActividadFisicaCalculator from '../components/calculators/ActividadFisicaCalculator';
---

<CalculatorLayout
  title="Calculadora Actividad Física OMS — Recomendación Semanal | CalcFit"
  description="Compara tus minutos de actividad física con la recomendación de la OMS 2020. Calcula MET·min semanales y sabe si cumples el mínimo. Gratis."
  calculatorName="Actividad Física OMS"
  breadcrumbSlug="actividad-fisica"
  ogImage="/og/actividad-fisica.jpg"
  keywords="calculadora actividad física OMS, minutos ejercicio semana, recomendación OMS 2020, MET minutos semana, actividad moderada vigorosa"
  faqs={[
    { q: '¿Cuánto ejercicio recomienda la OMS para adultos?', a: 'La OMS 2020 recomienda para adultos de 18–64 años: al menos 150–300 minutos de actividad aeróbica moderada por semana, o 75–150 minutos de actividad vigorosa, o una combinación equivalente. Además, actividades de fortalecimiento muscular ≥2 días por semana. Cualquier cantidad de actividad es mejor que ninguna.' },
    { q: '¿Qué es la actividad moderada vs. vigorosa?', a: 'La actividad moderada requiere un esfuerzo notable pero permite mantener una conversación: caminar rápido (5–6 km/h), ciclismo suave, baile, natación recreacional (3–6 METs). La actividad vigorosa hace difícil hablar sin interrupciones: correr, natación rápida, ciclismo intenso, aeróbicos de alta intensidad (>6 METs). Una hora de moderada equivale a 30 min de vigorosa.' },
    { q: '¿Qué son los MET·minutos?', a: 'El MET (Equivalente Metabólico) es la unidad de medida del gasto energético relativo al reposo. Caminar consume ~4 METs, correr ~10 METs. Los MET·minutos (MET×tiempo) permiten sumar actividades de distinta intensidad. La OMS recomienda ≥600 MET·min/semana (mínimo) y ≥1200 MET·min/semana (óptimo para beneficio adicional).' },
    { q: '¿Qué beneficios ofrece cumplir la recomendación OMS?', a: 'Cumplir las recomendaciones reduce el riesgo de enfermedad cardiovascular en un 35%, diabetes tipo 2 en un 30–40%, algunos cánceres (colon, mama, endometrio) en un 20–30%, y la mortalidad por todas las causas en un 30% (WHO Global Action Plan 2018). También mejora la salud mental, el sueño y la densidad ósea.' },
    { q: '¿Cuántos pasos diarios equivalen a la recomendación OMS?', a: 'Aproximadamente 7.000–10.000 pasos diarios equivalen a la recomendación mínima de la OMS en personas que caminan a paso moderado. Sin embargo, los pasos son una medida incompleta pues no capturan la intensidad. 30 minutos diarios de caminata rápida (5 días) cubren los 150 minutos semanales mínimos de actividad moderada.' },
  ]}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Actividad Física<br><span style="color: var(--acid);">OMS 2020</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Compara tus minutos semanales de actividad con la recomendación oficial de la OMS 2020 para adultos. Calcula tu nivel y si cumples el mínimo.
    </p>
  </div>

  <ActividadFisicaCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula el nivel de actividad OMS?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      La calculadora usa la aproximación MET·min de la OMS: <strong>MET·min = minutos_moderada × 4 + minutos_vigorosa × 8</strong>. Umbral mínimo: 600 MET·min/sem (≈150 min moderada). Óptimo: ≥1200 MET·min/sem (≈300 min moderada). Se verifica también el cumplimiento de los 2 días semanales de fortalecimiento muscular.
    </p>

    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
      <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 300px;">
        <thead>
          <tr style="border-bottom: 2px solid var(--border);">
            <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Nivel OMS</th>
            <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">MET·min/semana</th>
            <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Equiv. moderada</th>
          </tr>
        </thead>
        <tbody>
          {[
            { nivel: 'Inactivo',     met: '0',           equiv: '0 min' },
            { nivel: 'Insuficiente', met: '1–599',       equiv: '< 150 min' },
            { nivel: 'Suficiente',   met: '600–1199',    equiv: '150–300 min' },
            { nivel: 'Óptimo',       met: '≥ 1200',      equiv: '≥ 300 min' },
          ].map(row => (
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: 10px 0; font-size: 13px; color: var(--ink); font-weight: 600;">{row.nivel}</td>
              <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.met}</td>
              <td style="padding: 10px 0; font-size: 12px; color: var(--muted);">{row.equiv}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {[
        { q: '¿Cuánto ejercicio recomienda la OMS para adultos?', a: 'La OMS 2020 recomienda para adultos de 18–64 años: al menos 150–300 minutos de actividad aeróbica moderada por semana, o 75–150 minutos de actividad vigorosa, o una combinación equivalente. Además, actividades de fortalecimiento muscular ≥2 días por semana. Cualquier cantidad de actividad es mejor que ninguna.' },
        { q: '¿Qué es la actividad moderada vs. vigorosa?', a: 'La actividad moderada requiere un esfuerzo notable pero permite mantener una conversación: caminar rápido (5–6 km/h), ciclismo suave, baile, natación recreacional (3–6 METs). La actividad vigorosa hace difícil hablar sin interrupciones: correr, natación rápida, ciclismo intenso, aeróbicos de alta intensidad (>6 METs). Una hora de moderada equivale a 30 min de vigorosa.' },
        { q: '¿Qué son los MET·minutos?', a: 'El MET (Equivalente Metabólico) es la unidad de medida del gasto energético relativo al reposo. Caminar consume ~4 METs, correr ~10 METs. Los MET·minutos (MET×tiempo) permiten sumar actividades de distinta intensidad. La OMS recomienda ≥600 MET·min/semana (mínimo) y ≥1200 MET·min/semana (óptimo para beneficio adicional).' },
        { q: '¿Qué beneficios ofrece cumplir la recomendación OMS?', a: 'Cumplir las recomendaciones reduce el riesgo de enfermedad cardiovascular en un 35%, diabetes tipo 2 en un 30–40%, algunos cánceres (colon, mama, endometrio) en un 20–30%, y la mortalidad por todas las causas en un 30% (WHO Global Action Plan 2018). También mejora la salud mental, el sueño y la densidad ósea.' },
        { q: '¿Cuántos pasos diarios equivalen a la recomendación OMS?', a: 'Aproximadamente 7.000–10.000 pasos diarios equivalen a la recomendación mínima de la OMS en personas que caminan a paso moderado. Sin embargo, los pasos son una medida incompleta pues no capturan la intensidad. 30 minutos diarios de caminata rápida (5 días) cubren los 150 minutos semanales mínimos de actividad moderada.' },
      ].map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
