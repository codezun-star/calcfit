---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import FechaPartoFIVCalculator from '../components/calculators/FechaPartoFIVCalculator';

const faqs = [
  { q: '¿Cómo se calcula la fecha de parto en una FIV?', a: 'Como en la FIV se conoce con exactitud el día de la concepción, la fecha de parto se calcula a partir de la transferencia y la edad del embrión. Para un blastocisto de día 5: transferencia + 261 días; para un embrión de día 3: + 263 días.' },
  { q: '¿La fecha de parto por FIV es más exacta?', a: 'Sí. En un embarazo natural la fecha se estima a partir de la última regla, que es variable. En la FIV se conoce el momento exacto de la fecundación, por lo que la fecha probable de parto es más precisa.' },
  { q: '¿Qué diferencia hay entre transferir en día 3 o día 5?', a: 'En día 3 se transfiere un embrión de 3 días; en día 5, un blastocisto más desarrollado. Esto cambia en 2 días el cálculo de la fecha de parto, ya que el embrión de día 5 es dos días "mayor".' },
  { q: '¿Desde cuándo se cuentan las semanas de embarazo en una FIV?', a: 'Por convención obstétrica, las semanas se cuentan como si la concepción hubiera ocurrido 14 días después de una regla teórica. Por eso, en el momento de la transferencia ya constas de unas 2-3 semanas de embarazo.' },
  { q: '¿La fecha calculada es definitiva?', a: 'Es una estimación muy fiable, pero la fecha real del parto puede variar. Igual que en cualquier embarazo, la mayoría de los bebés nace entre la semana 37 y la 42.' },
];
---

<CalculatorLayout
  title="Fecha de Parto FIV — Transferencia Embrionaria | CalcFit"
  description="Calcula tu fecha probable de parto por FIV a partir de la fecha de transferencia y el día del embrión (3 o 5). Más precisa que la regla. Gratis."
  calculatorName="Fecha de Parto por FIV"
  breadcrumbSlug="fecha-parto-fiv"
  ogImage="/og/fecha-parto-fiv.jpg"
  keywords="fecha de parto FIV, calcular parto FIV, fecha parto transferencia embrionaria, FIV semanas embarazo, parto blastocisto día 5"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Fecha Parto<br><span style="color: var(--acid);">FIV</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Calcula tu fecha probable de parto por FIV a partir de la transferencia y el día del embrión.
    </p>
  </div>

  <FechaPartoFIVCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      En la fecundación in vitro se conoce el día exacto de la concepción, lo que permite una fecha de parto más precisa que con la regla de Naegele. La fórmula parte de la transferencia y descuenta la edad del embrión: <strong>FPP = transferencia + (266 − día del embrión)</strong>.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Días a sumar según el embrión</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Transferencia</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Días a sumar</th>
        </tr>
      </thead>
      <tbody>
        {[
          { t: 'Embrión día 3', d: '+263 días' },
          { t: 'Blastocisto día 5', d: '+261 días' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.t}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.d}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
