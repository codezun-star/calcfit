---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import CaloriasElipticaCalculator from '../components/calculators/CaloriasElipticaCalculator';

const faqs = [
  { q: '¿Cuántas calorías se queman en la elíptica en 30 minutos?', a: 'Una persona de 70 kg quema unas 250 kcal en 30 minutos a intensidad moderada y hasta 295 kcal a intensidad alta. El gasto depende del peso, la resistencia y el ritmo de pedaleo.' },
  { q: '¿La elíptica adelgaza?', a: 'Sí, es un cardio de bajo impacto que ayuda a crear el déficit calórico necesario para perder grasa, cuidando rodillas y tobillos. Combínala con fuerza y una buena alimentación para mejores resultados.' },
  { q: '¿Es mejor la elíptica o la cinta de correr?', a: 'La cinta suele quemar algo más a igual percepción de esfuerzo, pero la elíptica es de menor impacto articular y trabaja también el tren superior. La mejor es la que te permita entrenar de forma constante y sin dolor.' },
  { q: '¿Cuánto tiempo en la elíptica para quemar grasa?', a: 'Entre 30 y 45 minutos, 3-5 veces por semana, es un buen punto de partida. Lo decisivo es el volumen total de actividad y el déficit calórico semanal, no una sesión concreta.' },
  { q: '¿La elíptica tonifica las piernas?', a: 'Ayuda a trabajar cuádriceps, glúteos e isquiotibiales, sobre todo si subes la resistencia. Para ganar masa muscular de forma notable, conviene añadir entrenamiento de fuerza específico.' },
];
---

<CalculatorLayout
  title="Calorías en Elíptica — Cuántas Quemas | CalcFit"
  description="Calcula cuántas calorías quemas en la elíptica según tu peso, los minutos y la intensidad. Cardio de bajo impacto y efectivo. Gratis."
  calculatorName="Calorías en Elíptica"
  breadcrumbSlug="calorias-eliptica"
  ogImage="/og/calorias-eliptica.jpg"
  keywords="calorías elíptica, cuántas calorías quema la elíptica, elíptica adelgaza, gasto calórico elíptica, elíptica 30 minutos calorías"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Calorías<br><span style="color: var(--acid);">Elíptica</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Descubre cuántas calorías quemas en la elíptica según tu peso, el tiempo y la intensidad del entrenamiento.
    </p>
  </div>

  <CaloriasElipticaCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Se usa la fórmula de los METs: <strong>kcal = MET × 3,5 × peso(kg) ÷ 200 × minutos</strong>. La elíptica tiene un MET de 5,0 (suave), 6,8 (moderada) y 8,0 (intensa). Subir la resistencia y el ritmo aumenta el gasto calórico.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Calorías por 30 minutos según peso</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Peso</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Moderada</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Intensa</th>
        </tr>
      </thead>
      <tbody>
        {[
          { p: '55 kg', m: '~196 kcal', i: '~231 kcal' },
          { p: '70 kg', m: '~250 kcal', i: '~294 kcal' },
          { p: '85 kg', m: '~303 kcal', i: '~357 kcal' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.p}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.m}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.i}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
