---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import HierroDiarioCalculator from '../components/calculators/HierroDiarioCalculator';

const faqs = [
  { q: '¿Cuánto hierro se necesita al día?', a: 'Un hombre adulto necesita unos 8 mg de hierro al día y una mujer en edad fértil, 18 mg, debido a las pérdidas menstruales. En el embarazo la cifra sube a 27 mg.' },
  { q: '¿Qué alimentos tienen más hierro?', a: 'La carne roja, el hígado, los mejillones y las sardinas aportan hierro hemo, que se absorbe muy bien. Las legumbres, espinacas, tofu y cereales integrales aportan hierro no hemo, mejor absorbido si se combina con vitamina C.' },
  { q: '¿Cómo se absorbe mejor el hierro?', a: 'Acompaña las fuentes vegetales con vitamina C (cítricos, pimiento, kiwi) para multiplicar su absorción. Evita tomar café o té justo en la comida, ya que sus taninos la reducen.' },
  { q: '¿Cuáles son los síntomas de falta de hierro?', a: 'El déficit de hierro causa cansancio, palidez, caída del cabello, uñas frágiles y, si avanza, anemia ferropénica. Es más frecuente en mujeres con menstruaciones abundantes, embarazadas y deportistas.' },
  { q: '¿Las mujeres necesitan más hierro que los hombres?', a: 'Sí, durante la edad fértil. Las pérdidas de sangre menstruales elevan sus necesidades a 18 mg/día frente a los 8 mg de los hombres. Tras la menopausia, las necesidades se igualan en 8 mg.' },
];
---

<CalculatorLayout
  title="Hierro Diario Recomendado por Edad y Sexo | CalcFit"
  description="Calcula cuánto hierro necesitas al día según tu edad, sexo y etapa. Recomendación en mg para prevenir la anemia. Gratis."
  calculatorName="Hierro Diario"
  breadcrumbSlug="hierro-diario"
  ogImage="/og/hierro-diario.jpg"
  keywords="hierro diario, cuánto hierro al día, hierro recomendado mujer, hierro embarazo, necesidades de hierro, prevenir anemia"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Hierro<br><span style="color: var(--acid);">Diario</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Descubre cuántos miligramos de hierro necesitas al día según tu edad, sexo y etapa de la vida.
    </p>
  </div>

  <HierroDiarioCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cuánto hierro necesitas?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      El hierro transporta el oxígeno en la sangre. Las necesidades dependen mucho del sexo y la etapa: las mujeres en edad fértil y las embarazadas requieren bastante más por las pérdidas y el aumento del volumen sanguíneo. Combinar fuentes vegetales con vitamina C mejora su absorción.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Hierro recomendado (mg/día)</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Grupo</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Hierro</th>
        </tr>
      </thead>
      <tbody>
        {[
          { g: 'Hombres 19–50', v: '8 mg' },
          { g: 'Mujeres 19–50', v: '18 mg' },
          { g: 'Embarazo', v: '27 mg' },
          { g: 'Mujeres > 50', v: '8 mg' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.g}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.v}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
