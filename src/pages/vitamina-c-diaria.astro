---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import VitaminaCDiariaCalculator from '../components/calculators/VitaminaCDiariaCalculator';

const faqs = [
  { q: '¿Cuánta vitamina C se necesita al día?', a: 'Un hombre adulto necesita 90 mg de vitamina C al día y una mujer, 75 mg. Los fumadores deben sumar 35 mg adicionales porque el tabaco aumenta el consumo de esta vitamina.' },
  { q: '¿Qué alimentos tienen más vitamina C?', a: 'El pimiento rojo, el kiwi, la guayaba, los cítricos (naranja, mandarina), las fresas, el brócoli y el perejil son fuentes excelentes. Una sola naranja grande ya cubre buena parte de la recomendación diaria.' },
  { q: '¿La vitamina C previene los resfriados?', a: 'No los previene en la población general, pero puede acortar ligeramente su duración. Su papel más importante es como antioxidante y como cofactor en la síntesis de colágeno y la absorción de hierro.' },
  { q: '¿Se puede tomar demasiada vitamina C?', a: 'El límite superior en adultos es de 2.000 mg al día. Dosis muy altas pueden causar molestias digestivas y diarrea. Al ser hidrosoluble, el exceso se elimina por la orina.' },
  { q: '¿Por qué los fumadores necesitan más vitamina C?', a: 'El humo del tabaco genera estrés oxidativo que consume más vitamina C. Por eso las recomendaciones añaden 35 mg diarios a fumadores para compensar esa mayor demanda.' },
];
---

<CalculatorLayout
  title="Vitamina C Diaria Recomendada por Edad | CalcFit"
  description="Calcula cuánta vitamina C necesitas al día según tu edad, sexo y si fumas. Recomendación en mg para tu sistema inmune. Gratis."
  calculatorName="Vitamina C Diaria"
  breadcrumbSlug="vitamina-c-diaria"
  ogImage="/og/vitamina-c-diaria.jpg"
  keywords="vitamina C diaria, cuánta vitamina C al día, vitamina C recomendada, necesidades vitamina C, vitamina C fumadores"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Vitamina C<br><span style="color: var(--acid);">Diaria</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Descubre cuántos miligramos de vitamina C necesitas al día según tu edad, sexo y si fumas.
    </p>
  </div>

  <VitaminaCDiariaCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cuánta vitamina C necesitas?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      La vitamina C es un potente antioxidante necesario para fabricar colágeno, cicatrizar heridas y absorber el hierro de origen vegetal. El cuerpo no la almacena, por lo que conviene tomarla a diario. Una dieta con frutas y verduras frescas cubre fácilmente las recomendaciones.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Vitamina C recomendada (mg/día)</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Grupo</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Vitamina C</th>
        </tr>
      </thead>
      <tbody>
        {[
          { g: 'Adolescentes 14–18 (H)', v: '75 mg' },
          { g: 'Hombres 19+', v: '90 mg' },
          { g: 'Mujeres 19+', v: '75 mg' },
          { g: 'Fumadores', v: '+35 mg' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.g}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.v}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
