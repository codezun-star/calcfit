---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import GeneracionCalculator from '../components/calculators/GeneracionCalculator';

const faqs = [
  { q: '¿Qué es una generación y cómo se define?', a: 'Una generación es un grupo de personas nacidas en un período similar que comparte experiencias históricas, culturales y tecnológicas formativas. Las fechas de corte no son universales: varían según el investigador o la institución. Las más usadas son las definiciones de Pew Research Center y Strauss-Howe.' },
  { q: '¿Cuáles son las fechas exactas de cada generación?', a: 'Las definiciones más aceptadas: Generación Silenciosa (1928–1945), Baby Boomers (1946–1964), Generación X (1965–1980), Millennials (1981–1996), Generación Z (1997–2012) y Generación Alpha (2013–actualidad). Estas fechas pueden variar ±2 años según la fuente consultada.' },
  { q: '¿Qué define a los Millennials respecto a la Generación Z?', a: 'Los Millennials crecieron con el surgimiento de internet y los móviles en su adolescencia o juventud. La Generación Z nació cuando internet ya era omnipresente y creció con smartphones desde la infancia. El resultado: la Gen Z es más pragmática financieramente (vivieron la pandemia COVID y la incertidumbre económica), mientras los Millennials tienden a ser más optimistas en su visión del mundo.' },
  { q: '¿Quiénes son los Baby Boomers?', a: 'Los Baby Boomers (1946–1964) son hijos del "baby boom" que siguió a la Segunda Guerra Mundial. Crecieron en un período de gran prosperidad económica en Occidente, fueron testigos de los derechos civiles, el rock clásico, el primer hombre en la Luna y el surgimiento de la televisión. Actualmente son la generación de mayor poder político y económico acumulado en muchos países.' },
  { q: '¿Cuándo termina la Generación Alpha?', a: 'La Generación Alpha comenzó en 2013 y los investigadores estiman que incluirá a quienes nazcan hasta aproximadamente 2025–2028. Es la generación más influenciada por la inteligencia artificial, los asistentes de voz y el aprendizaje digital desde temprana infancia. Será la generación más diversa y con mayor acceso a la tecnología de la historia.' },
];
---

<CalculatorLayout
  title="Calculadora de Generación — Baby Boomer, Millennial, Gen Z | CalcFit"
  description="Descubre a qué generación perteneces según tu año de nacimiento: Baby Boomer, Gen X, Millennial, Gen Z o Alpha. Características y rasgos clave. Gratis."
  calculatorName="Generación"
  breadcrumbSlug="generacion"
  ogImage="/og/generacion.jpg"
  keywords="calculadora de generación, a qué generación pertenezco, baby boomer millennial gen z, generaciones por año de nacimiento, generación alpha gen x"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Mi<br><span style="color: var(--acid);">Generación</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Introduce tu año de nacimiento y descubre a qué generación perteneces, con sus rasgos y características culturales clave.
    </p>
  </div>

  <GeneracionCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">Las generaciones y sus rangos de años</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Las generaciones se definen por los eventos históricos y tecnológicos que vivieron durante sus años formativos (aproximadamente de 10 a 20 años). Estas experiencias compartidas moldean actitudes, valores y comportamientos que distinguen a cada cohorte generacional.
    </p>

    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px;">
      <thead>
        <tr style="background: var(--ink); color: var(--acid);">
          <th style="padding: 10px 14px; text-align: left; font-family: var(--font-mono); font-weight: 400;">Generación</th>
          <th style="padding: 10px 14px; text-align: left;">Años de nacimiento</th>
          <th style="padding: 10px 14px; text-align: left;">Edad actual (aprox.)</th>
        </tr>
      </thead>
      <tbody>
        {[
          ['Generación Silenciosa', '1928–1945', '80–96 años'],
          ['Baby Boomer',           '1946–1964', '61–79 años'],
          ['Generación X',          '1965–1980', '45–60 años'],
          ['Millennial',            '1981–1996', '29–44 años'],
          ['Generación Z',          '1997–2012', '13–28 años'],
          ['Generación Alpha',      '2013–hoy',  '0–12 años'],
        ].map(([gen, años, edad], i) => (
          <tr style={`background: ${i % 2 === 0 ? 'white' : '#f9f6f0'};`}>
            <td style="padding: 10px 14px; font-weight: 600;">{gen}</td>
            <td style="padding: 10px 14px;">{años}</td>
            <td style="padding: 10px 14px; color: var(--muted);">{edad}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
