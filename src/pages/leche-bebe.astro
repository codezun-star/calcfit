---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import LecheBebeCalculator from '../components/calculators/LecheBebeCalculator';

const faqs = [
  { q: '¿Cuánta leche debe tomar un bebé al día?', a: 'Como referencia para lactancia artificial, un bebé toma unos 150 ml de leche por kilo de peso al día (rango 120-180 ml/kg) durante los primeros meses. Un bebé de 4 kg tomaría unos 600 ml diarios.' },
  { q: '¿Cuántos ml por toma necesita un recién nacido?', a: 'Depende de su peso y del número de tomas. Si un bebé de 4 kg hace 8 tomas, le corresponden unos 75 ml por toma. Los primeros días, las cantidades son mucho menores porque el estómago es diminuto.' },
  { q: '¿Cómo sé si mi bebé toma suficiente?', a: 'Las señales de que come bien son: gana peso de forma adecuada, moja 5-6 pañales al día, está activo y satisfecho tras las tomas. Ante dudas, consulta siempre con tu pediatra.' },
  { q: '¿Esta cantidad vale para lactancia materna?', a: 'La lactancia materna se rige por la demanda del bebé, no por mililitros. Esta estimación es útil sobre todo para la lactancia artificial o mixta, donde se mide la cantidad de fórmula.' },
  { q: '¿Cambia la cantidad cuando empieza la alimentación complementaria?', a: 'Sí. A partir de los 6 meses, al introducir alimentos sólidos, la cantidad de leche se reduce progresivamente, aunque sigue siendo el alimento principal hasta el año.' },
];
---

<CalculatorLayout
  title="Cantidad de Leche del Bebé — ml por Toma | CalcFit"
  description="Calcula cuánta leche necesita tu bebé al día y por toma según su peso y edad. Referencia para lactancia artificial. Gratis."
  calculatorName="Cantidad de Leche del Bebé"
  breadcrumbSlug="leche-bebe"
  ogImage="/og/leche-bebe.jpg"
  keywords="cuánta leche debe tomar un bebé, ml leche bebé, cantidad de leche por toma, leche recién nacido, fórmula bebé cantidad"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Leche del<br><span style="color: var(--acid);">Bebé</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Calcula cuántos mililitros de leche necesita tu bebé al día y por toma según su peso y edad.
    </p>
  </div>

  <LecheBebeCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      La referencia habitual para la lactancia artificial es de <strong>150 ml por kilo de peso al día</strong> (rango 120-180 ml/kg), que se reparte entre el número de tomas. A partir de los 6 meses, con la alimentación complementaria, la cantidad por kilo desciende. Es una orientación: cada bebé tiene su ritmo.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Leche diaria orientativa por peso</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Peso</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Total/día</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Por toma (8)</th>
        </tr>
      </thead>
      <tbody>
        {[
          { p: '3 kg', t: '~450 ml', x: '~56 ml' },
          { p: '4 kg', t: '~600 ml', x: '~75 ml' },
          { p: '5 kg', t: '~750 ml', x: '~94 ml' },
          { p: '6 kg', t: '~900 ml', x: '~113 ml' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.p}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.t}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.x}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
