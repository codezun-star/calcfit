---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import ZincDiarioCalculator from '../components/calculators/ZincDiarioCalculator';

const faqs = [
  { q: '¿Cuánto zinc se necesita al día?', a: 'Un hombre adulto necesita unos 11 mg de zinc al día y una mujer, 8 mg. Las necesidades aumentan durante el embarazo (11-12 mg) y la lactancia (12-13 mg).' },
  { q: '¿Qué alimentos tienen más zinc?', a: 'Las ostras son la fuente más concentrada, seguidas de la carne roja, el marisco, las semillas de calabaza, los frutos secos, las legumbres y los lácteos. En dietas vegetarianas conviene cuidar su aporte.' },
  { q: '¿Para qué sirve el zinc?', a: 'El zinc es esencial para el sistema inmunitario, la cicatrización de heridas, la síntesis de proteínas, el ADN y el sentido del gusto y el olfato. También influye en la fertilidad masculina.' },
  { q: '¿Cuáles son los síntomas de falta de zinc?', a: 'El déficit puede causar caída del cabello, mala cicatrización, pérdida de apetito, alteraciones del gusto y mayor propensión a las infecciones. Es más común en dietas vegetarianas mal planificadas.' },
  { q: '¿Se puede tomar demasiado zinc?', a: 'Sí. El límite superior en adultos es de 40 mg al día. El exceso prolongado interfiere con la absorción de cobre y puede afectar al sistema inmune. Evita suplementarte sin necesidad.' },
];
---

<CalculatorLayout
  title="Zinc Diario Recomendado por Edad y Sexo | CalcFit"
  description="Calcula cuánto zinc necesitas al día según tu edad, sexo y etapa. Recomendación en mg para inmunidad y cicatrización. Gratis."
  calculatorName="Zinc Diario"
  breadcrumbSlug="zinc-diario"
  ogImage="/og/zinc-diario.jpg"
  keywords="zinc diario, cuánto zinc al día, zinc recomendado, necesidades de zinc, déficit de zinc, zinc inmunidad"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Zinc<br><span style="color: var(--acid);">Diario</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Descubre cuántos miligramos de zinc necesitas al día según tu edad, sexo y etapa de la vida.
    </p>
  </div>

  <ZincDiarioCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cuánto zinc necesitas?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      El zinc es un mineral esencial que el cuerpo no almacena, por lo que debe aportarse a diario. Es clave para la inmunidad, la cicatrización y cientos de enzimas. Las personas vegetarianas pueden necesitar prestar más atención, ya que los fitatos de los vegetales reducen su absorción.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Zinc recomendado (mg/día)</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Grupo</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Zinc</th>
        </tr>
      </thead>
      <tbody>
        {[
          { g: 'Niños 4–8 años', v: '5 mg' },
          { g: 'Hombres 19+', v: '11 mg' },
          { g: 'Mujeres 19+', v: '8 mg' },
          { g: 'Embarazo / lactancia', v: '11–13 mg' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.g}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.v}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
