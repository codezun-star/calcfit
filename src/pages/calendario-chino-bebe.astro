---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import CalendarioChinoCalculator from '../components/calculators/CalendarioChinoCalculator';

const faqs = [
  { q: '¿Cómo funciona el calendario chino del embarazo?', a: 'Cruza la edad lunar de la madre (su edad más uno, aproximadamente) con el mes lunar de la concepción en una tabla tradicional que predice si el bebé será niño o niña. Es una tradición milenaria sin validez científica.' },
  { q: '¿El calendario chino acierta el sexo del bebé?', a: 'Su tasa de acierto es la del azar, en torno al 50%, como lanzar una moneda. No existe ninguna base biológica que lo respalde. Tómalo como un juego o curiosidad, no como un método fiable.' },
  { q: '¿Qué es la edad lunar de la madre?', a: 'En la tradición china se considera que el bebé tiene 1 año al nacer, así que la edad lunar suele ser la edad real más uno. Esta calculadora hace ese ajuste automáticamente.' },
  { q: '¿Cuál es el método fiable para saber el sexo?', a: 'La ecografía a partir de la semana 16-20 y los test de ADN fetal en sangre materna (desde la semana 10) son los métodos realmente fiables para conocer el sexo del bebé.' },
  { q: '¿Desde cuándo existe el calendario chino del bebé?', a: 'Según la leyenda, la tabla original tiene varios siglos de antigüedad y se atribuye a la dinastía Qing. Hoy circulan muchas versiones distintas, lo que ya evidencia su falta de rigor.' },
];
---

<CalculatorLayout
  title="Calendario Chino del Bebé — Predice el Sexo | CalcFit"
  description="Predice si tu bebé será niño o niña con el calendario chino del embarazo según tu edad y el mes de concepción. Un juego tradicional. Gratis."
  calculatorName="Calendario Chino del Bebé"
  breadcrumbSlug="calendario-chino-bebe"
  ogImage="/og/calendario-chino-bebe.jpg"
  keywords="calendario chino embarazo, calendario chino bebé, predecir sexo del bebé, niño o niña calendario chino, tabla china embarazo"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Calendario<br><span style="color: var(--acid);">Chino</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Descubre, según la tradición china, si tu bebé sería niño o niña a partir de tu edad y el mes de concepción.
    </p>
  </div>

  <CalendarioChinoCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Qué es el calendario chino del bebé?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Es una tabla tradicional china que pretende predecir el sexo del bebé cruzando la <strong>edad lunar de la madre</strong> con el <strong>mes lunar de la concepción</strong>. Aunque es muy popular como entretenimiento durante el embarazo, no tiene ninguna base científica: su acierto es estadísticamente equivalente al azar.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Métodos reales para conocer el sexo</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Método</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Desde</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Fiabilidad</th>
        </tr>
      </thead>
      <tbody>
        {[
          { m: 'Test ADN fetal', d: 'Semana 10', f: '>99%' },
          { m: 'Ecografía', d: 'Semana 16–20', f: '~95%' },
          { m: 'Calendario chino', d: '—', f: '~50% (azar)' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.m}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.d}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.f}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
