---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import DiaSemanaCalculator from '../components/calculators/DiaSemanaCalculator';

const faqs = [
  { q: '¿Qué día de la semana fue una fecha?', a: 'Introduce cualquier fecha pasada o futura y la calculadora te dice si fue lunes, martes, etc. Es útil para saber qué día naciste o qué día caerá un evento futuro.' },
  { q: '¿Cómo se calcula el día de la semana de una fecha?', a: 'La calculadora usa el calendario gregoriano para determinar el día exacto. Internamente convierte la fecha y obtiene el día correspondiente, teniendo en cuenta los años bisiestos.' },
  { q: '¿Qué día de la semana nací?', a: 'Selecciona tu fecha de nacimiento y obtendrás el día de la semana, la fecha en formato largo y el número de día dentro del año. Una curiosidad muy buscada.' },
  { q: '¿Funciona con fechas muy antiguas o futuras?', a: 'Sí, mientras estén dentro del calendario gregoriano. Puedes consultar fechas de hace décadas o de dentro de muchos años con total precisión.' },
  { q: '¿Sirve para saber si una fecha es fin de semana?', a: 'Sí. Además del día concreto, la calculadora indica si esa fecha cae en fin de semana (sábado o domingo) o en día laborable.' },
];
---

<CalculatorLayout
  title="Qué Día de la Semana Fue una Fecha | CalcFit"
  description="Descubre qué día de la semana cae cualquier fecha pasada o futura. Averigua qué día naciste en segundos. Gratis y sin registro."
  calculatorName="Qué Día de la Semana"
  breadcrumbSlug="dia-semana"
  ogImage="/og/dia-semana.jpg"
  keywords="qué día de la semana, qué día nací, día de la semana de una fecha, calcular día semana, qué día cae"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Día de la<br><span style="color: var(--acid);">Semana</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Averigua qué día de la semana cae cualquier fecha, pasada o futura. Descubre qué día naciste.
    </p>
  </div>

  <DiaSemanaCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      A partir de la fecha que introduces, la calculadora determina el día de la semana según el calendario gregoriano, teniendo en cuenta los años bisiestos. Además te muestra la fecha en formato largo, el número de día dentro del año y si es fin de semana.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Los días de la semana</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Día</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Tipo</th>
        </tr>
      </thead>
      <tbody>
        {[
          { d: 'Lunes a viernes', t: 'Laborable' },
          { d: 'Sábado y domingo', t: 'Fin de semana' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.d}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.t}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
