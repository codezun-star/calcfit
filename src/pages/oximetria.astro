---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import OximetriaCalculator from '../components/calculators/OximetriaCalculator';
---

<CalculatorLayout
  title="Calculadora de Oximetría (SpO2) — Saturación de Oxígeno | CalcFit"
  description="Interpreta tu saturación de oxígeno en sangre (SpO2) y conoce el nivel esperado según la altitud. Hipoxia leve, moderada o grave. Gratis."
  calculatorName="Oximetría (SpO2)"
  breadcrumbSlug="oximetria"
  ogImage="/og/oximetria.jpg"
  keywords="calculadora oximetría, SpO2 normal, saturación oxígeno sangre, oxímetro de pulso, hipoxia altitud"
  faqs={[
    { q: '¿Qué es el SpO2 y qué mide?', a: 'SpO2 (saturación de oxígeno periférico) es el porcentaje de hemoglobina en sangre que está unida al oxígeno. Se mide con un oxímetro de pulso que emite luz infrarroja a través del dedo. Un valor normal en adultos sanos a nivel del mar es ≥95%. Por debajo del 90% se considera hipoxia que requiere evaluación médica.' },
    { q: '¿Cuál es el SpO2 normal?', a: 'La saturación normal a nivel del mar es 95–100%. Valores de 91–94% indican hipoxia leve, 86–90% hipoxia moderada y <86% hipoxia grave con riesgo para la vida. A grandes altitudes (>2500 m) el SpO2 esperado puede ser 88–94% en personas aclimatadas, lo que se considera fisiológico en ese contexto.' },
    { q: '¿Cómo afecta la altitud al SpO2?', a: 'A mayor altitud, la presión parcial de oxígeno disminuye, lo que reduce la saturación arterial. A 3000 m el SpO2 puede caer a 92–94%, a 4500 m (como Cusco, Perú) puede llegar a 88–92%, y a la cima del Everest (8849 m) puede caer por debajo de 70%. La aclimatación gradual permite al cuerpo adaptarse produciendo más glóbulos rojos.' },
    { q: '¿Cuándo debo preocuparme por mi SpO2?', a: 'Busca atención médica si tu SpO2 está consistentemente por debajo del 94% a nivel del mar, especialmente si va acompañado de disnea (dificultad para respirar), confusión, labios azulados o aceleración cardíaca importante. Una lectura aislada baja puede deberse a mala circulación en los dedos, uñas pintadas o movimiento del sensor.' },
    { q: '¿El oxímetro de pulso es preciso?', a: 'Los oxímetros de dedo homologados tienen una precisión de ±2% en el rango 70–100% SpO2. El error puede ser mayor en personas con pigmentación oscura de la piel (sobreestimación), dedos fríos, nail polish oscuro o mala perfusión. Las aplicaciones móviles sin sensor dedicado no son fiables para uso clínico.' },
  ]}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Oximetría<br><span style="color: var(--acid);">SpO2</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Interpreta tu saturación de oxígeno en sangre y conoce el valor esperado según la altitud a la que te encuentras.
    </p>
  </div>

  <OximetriaCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se interpreta el SpO2?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      La calculadora clasifica el SpO2 según los criterios clínicos estándar: ≥95% normal, 91–94% hipoxia leve, 86–90% hipoxia moderada, &lt;86% hipoxia grave. Para altitudes superiores a 2500 m se calcula el SpO2 esperado como referencia: <strong>SpO2 esperado = 98 − (altitud/300) × 0.9</strong>.
    </p>

    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
      <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 300px;">
        <thead>
          <tr style="border-bottom: 2px solid var(--border);">
            <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">SpO2</th>
            <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Categoría</th>
            <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Acción</th>
          </tr>
        </thead>
        <tbody>
          {[
            { spo2: '≥ 95%',   cat: 'Normal',           accion: 'Sin acción necesaria' },
            { spo2: '91–94%',  cat: 'Hipoxia leve',     accion: 'Monitorizar, consultar si persiste' },
            { spo2: '86–90%',  cat: 'Hipoxia moderada', accion: 'Buscar atención médica pronto' },
            { spo2: '< 86%',   cat: 'Hipoxia grave',    accion: 'Emergencia médica inmediata' },
          ].map(row => (
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.spo2}</td>
              <td style="padding: 10px 0; font-size: 13px; color: var(--ink); font-weight: 600;">{row.cat}</td>
              <td style="padding: 10px 0; font-size: 12px; color: var(--muted);">{row.accion}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {[
        { q: '¿Qué es el SpO2 y qué mide?', a: 'SpO2 (saturación de oxígeno periférico) es el porcentaje de hemoglobina en sangre que está unida al oxígeno. Se mide con un oxímetro de pulso que emite luz infrarroja a través del dedo. Un valor normal en adultos sanos a nivel del mar es ≥95%. Por debajo del 90% se considera hipoxia que requiere evaluación médica.' },
        { q: '¿Cuál es el SpO2 normal?', a: 'La saturación normal a nivel del mar es 95–100%. Valores de 91–94% indican hipoxia leve, 86–90% hipoxia moderada y <86% hipoxia grave con riesgo para la vida. A grandes altitudes (>2500 m) el SpO2 esperado puede ser 88–94% en personas aclimatadas, lo que se considera fisiológico en ese contexto.' },
        { q: '¿Cómo afecta la altitud al SpO2?', a: 'A mayor altitud, la presión parcial de oxígeno disminuye, lo que reduce la saturación arterial. A 3000 m el SpO2 puede caer a 92–94%, a 4500 m (como Cusco, Perú) puede llegar a 88–92%, y a la cima del Everest (8849 m) puede caer por debajo de 70%. La aclimatación gradual permite al cuerpo adaptarse produciendo más glóbulos rojos.' },
        { q: '¿Cuándo debo preocuparme por mi SpO2?', a: 'Busca atención médica si tu SpO2 está consistentemente por debajo del 94% a nivel del mar, especialmente si va acompañado de disnea (dificultad para respirar), confusión, labios azulados o aceleración cardíaca importante. Una lectura aislada baja puede deberse a mala circulación en los dedos, uñas pintadas o movimiento del sensor.' },
        { q: '¿El oxímetro de pulso es preciso?', a: 'Los oxímetros de dedo homologados tienen una precisión de ±2% en el rango 70–100% SpO2. El error puede ser mayor en personas con pigmentación oscura de la piel (sobreestimación), dedos fríos, nail polish oscuro o mala perfusión. Las aplicaciones móviles sin sensor dedicado no son fiables para uso clínico.' },
      ].map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
