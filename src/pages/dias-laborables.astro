---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import DiasLaborablesCalculator from '../components/calculators/DiasLaborablesCalculator';

const faqs = [
  { q: '¿Cómo se calculan los días laborables entre dos fechas?', a: 'Se cuentan todos los días del periodo y se descuentan los fines de semana (sábado y domingo, o solo domingo si trabajas en sábado). La calculadora incluye ambas fechas en el conteo.' },
  { q: '¿La calculadora descuenta los festivos?', a: 'No, porque los días festivos varían según el país, la región e incluso la empresa. La herramienta calcula los días laborables descontando solo los fines de semana; deberás restar los festivos locales aparte.' },
  { q: '¿Qué se considera un día laborable?', a: 'Por defecto, de lunes a viernes. Si en tu sector se trabaja también el sábado, puedes elegir la opción "L-S" para que cuente el sábado como día laborable.' },
  { q: '¿Para qué sirve contar días laborables?', a: 'Es útil para planificar plazos de entrega, calcular vacaciones, periodos de preaviso, plazos administrativos o el tiempo efectivo de un proyecto, donde solo cuentan los días hábiles.' },
  { q: '¿Cuántos días laborables tiene un año?', a: 'Un año tiene aproximadamente 260-262 días laborables (lunes a viernes) antes de descontar los festivos. Tras restar los festivos nacionales y locales, suelen quedar entre 245 y 250.' },
];
---

<CalculatorLayout
  title="Días Laborables entre Fechas — Calculadora | CalcFit"
  description="Calcula los días laborables (hábiles) entre dos fechas descontando fines de semana. Elige si cuentas el sábado. Gratis."
  calculatorName="Días Laborables entre Fechas"
  breadcrumbSlug="dias-laborables"
  ogImage="/og/dias-laborables.jpg"
  keywords="días laborables entre fechas, días hábiles, calcular días laborables, contar días sin fines de semana, días de trabajo"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Días<br><span style="color: var(--acid);">Laborables</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Cuenta los días laborables entre dos fechas descontando los fines de semana.
    </p>
  </div>

  <DiasLaborablesCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      La calculadora recorre todos los días entre la fecha de inicio y la de fin (ambas incluidas) y cuenta solo los días hábiles, descontando los fines de semana. Puedes elegir entre semana de lunes a viernes o de lunes a sábado. No descuenta festivos, que varían según el lugar.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Días laborables por periodo</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Periodo</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Laborables (L-V)</th>
        </tr>
      </thead>
      <tbody>
        {[
          { p: '1 semana', l: '5 días' },
          { p: '1 mes', l: '~22 días' },
          { p: '1 año', l: '~260 días' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.p}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.l}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
