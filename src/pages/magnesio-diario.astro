---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import MagnesioDiarioCalculator from '../components/calculators/MagnesioDiarioCalculator';

const faqs = [
  { q: '¿Cuánto magnesio se necesita al día?', a: 'Un hombre adulto necesita entre 400 y 420 mg de magnesio al día, y una mujer entre 310 y 320 mg. Las necesidades aumentan ligeramente durante el embarazo.' },
  { q: '¿Qué alimentos tienen más magnesio?', a: 'Los frutos secos (almendras, anacardos), las semillas de calabaza, las legumbres, el chocolate negro, los cereales integrales y las verduras de hoja verde son las mejores fuentes de magnesio.' },
  { q: '¿Cuáles son los síntomas de falta de magnesio?', a: 'El déficit puede causar calambres musculares, fatiga, irritabilidad, alteraciones del sueño y palpitaciones. Es más frecuente con dietas ricas en ultraprocesados o consumo elevado de alcohol.' },
  { q: '¿El magnesio ayuda a dormir y con el estrés?', a: 'El magnesio participa en la regulación del sistema nervioso y muscular, y algunos estudios sugieren que puede mejorar la calidad del sueño y reducir la sensación de estrés cuando hay déficit previo.' },
  { q: '¿Debo tomar suplementos de magnesio?', a: 'La mayoría de las personas pueden cubrir sus necesidades con la dieta. Los suplementos pueden ser útiles ante un déficit confirmado, pero conviene no abusar, ya que en exceso provocan diarrea.' },
];
---

<CalculatorLayout
  title="Magnesio Diario Recomendado por Edad y Sexo | CalcFit"
  description="Calcula cuánto magnesio necesitas al día según tu edad, sexo y etapa. Recomendación en mg para músculos y sistema nervioso. Gratis."
  calculatorName="Magnesio Diario"
  breadcrumbSlug="magnesio-diario"
  ogImage="/og/magnesio-diario.jpg"
  keywords="magnesio diario, cuánto magnesio al día, magnesio recomendado, necesidades de magnesio, déficit de magnesio"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Magnesio<br><span style="color: var(--acid);">Diario</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Descubre cuántos miligramos de magnesio necesitas al día según tu edad, sexo y etapa de la vida.
    </p>
  </div>

  <MagnesioDiarioCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cuánto magnesio necesitas?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      El magnesio interviene en más de 300 reacciones del organismo: producción de energía, función muscular y nerviosa, y síntesis de proteínas. Las necesidades aumentan en la adolescencia y la edad adulta. Una dieta rica en frutos secos, legumbres y cereales integrales suele cubrirlas sin problema.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Magnesio recomendado (mg/día)</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Grupo</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Magnesio</th>
        </tr>
      </thead>
      <tbody>
        {[
          { g: 'Adolescentes 14–18 (H)', v: '410 mg' },
          { g: 'Hombres 19+', v: '400–420 mg' },
          { g: 'Mujeres 19+', v: '310–320 mg' },
          { g: 'Embarazo', v: '350–360 mg' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.g}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.v}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
