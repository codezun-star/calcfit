---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { calculadoras, categorias } from '../../lib/calcData';
import type { GetStaticPathsOptions, Page } from 'astro';
import type { Calc } from '../../lib/calcData';
import AdSlot from '../../components/ads/AdSlot.astro';
import { organizationSchema, websiteSchema, ORGANIZATION_ID, SITE_URL } from '../../lib/schema';

const cat = categorias.find(c => c.slug === 'nutricion')!;
const slugSet = new Set(cat.slugs);
const allCalcs = calculadoras.filter(c => slugSet.has(c.slug));

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const { calculadoras, categorias } = await import('../../lib/calcData');
  const cat = categorias.find(c => c.slug === 'nutricion')!;
  const slugSet = new Set(cat.slugs);
  const items = calculadoras.filter(c => slugSet.has(c.slug));
  return paginate(items, { pageSize: 20 });
}

const { page } = Astro.props as { page: Page<Calc> };
const titleSuffix = page.currentPage > 1 ? ` — Página ${page.currentPage}` : '';
// Sin esto las páginas 2, 3 y 4 de la categoría repetían palabra por palabra la
// meta description de la página 1 (descripciones duplicadas en Search Console).
const descSuffix = page.currentPage > 1 ? ` Página ${page.currentPage} de ${page.lastPage}.` : '';

const categoryUrl = `${SITE_URL}/nutricion`;
const pageUrl = page.currentPage > 1 ? `${categoryUrl}/${page.currentPage}` : categoryUrl;

// CollectionPage + ItemList: describe la categoría como listado y enumera las
// calculadoras de ESTA página, con su posición real dentro de la categoría.
const collectionSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationSchema,
    websiteSchema,
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#collection`,
      url: pageUrl,
      name: cat.label,
      description: `${allCalcs.length} calculadoras de ${cat.label.toLowerCase()} gratuitas, validadas científicamente y sin registro.`,
      inLanguage: 'es',
      isPartOf: { '@id': `${SITE_URL}/#website` },
      publisher: { '@id': ORGANIZATION_ID },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      mainEntity: {
        '@type': 'ItemList',
        name: cat.label,
        numberOfItems: allCalcs.length,
        itemListElement: page.data.map((calc, i) => ({
          '@type': 'ListItem',
          position: (page.currentPage - 1) * page.size + i + 1,
          name: calc.nombre,
          url: `${SITE_URL}${calc.slug}`,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
        { '@type': 'ListItem', position: 2, name: cat.label, item: categoryUrl },
      ],
    },
  ],
};
---

<Base
  title={`Calculadoras de Nutrición y Bienestar${titleSuffix} — ${allCalcs.length} Herramientas Gratis | CalcFit`}
  description={`${allCalcs.length} calculadoras de nutrición y bienestar gratuitas: macronutrientes, proteínas, déficit calórico, glucosa, colesterol y más. Validadas científicamente.${descSuffix}`}
  keywords="calculadoras nutrición, calculadora macronutrientes, proteínas diarias, déficit calórico, glucosa en sangre, calculadoras bienestar gratis"
  schema={collectionSchema}
>
  <Navbar back="/" title={cat.label} />

  <!-- Header -->
  <div style="background:var(--ink); padding:40px 20px 32px;">
    <div style="max-width:1200px; margin:0 auto;">
      <div style="display:flex; align-items:center; gap:6px; font-family:var(--font-mono); font-size:11px; color:#888; margin-bottom:16px; text-transform:uppercase; letter-spacing:0.08em;">
        <a href="/" style="color:#888; text-decoration:none;">Inicio</a>
        <span>/</span>
        <span style="color:var(--acid);">Nutrición & Bienestar</span>
      </div>
      <h1 style="font-family:var(--font-display); font-size:clamp(36px,6vw,64px); color:white; margin:0 0 10px; line-height:0.95;">
        Calculadoras de<br><span style="color:var(--acid);">Nutrición & Bienestar</span>
      </h1>
      <p style="font-size:13px; color:#999; margin:0; line-height:1.7; font-family:var(--font-body);">
        {allCalcs.length} herramientas gratuitas · Validadas científicamente · Sin registro
      </p>
    </div>
  </div>

  <!-- Publicidad — cabecera -->
  <div style="background: var(--cream); border-bottom: 1px solid var(--border);">
    <AdSlot format="leaderboard" mobile="mobile" eager gap="14px" />
  </div>

  <!-- Grid -->
  <main style="background:var(--cream); padding:32px 20px 64px;">
    <div style="max-width:1200px; margin:0 auto;">

      <div class="calc-grid">
        {page.data.map(calc => (
          <a href={calc.slug} class="calc-card">
            <div class={`calc-icon ${calc.destacada ? 'calc-icon--dest' : ''}`}>
              <Fragment set:html={calc.icon} />
            </div>
            <div class="calc-nombre">{calc.nombre}</div>
            <div class="calc-desc">{calc.desc}</div>
            {calc.badge && (
              <span class={`calc-badge calc-badge--${calc.badge}`}>
                {calc.badge === 'popular' ? 'Popular' : 'Esencial'}
              </span>
            )}
          </a>
        ))}
      </div>

      <!-- Paginación -->
      {page.lastPage > 1 && (
        <nav style="display:flex; align-items:center; justify-content:center; gap:8px; flex-wrap:wrap; margin-top:32px;">
          {page.url.prev && (
            <a href={page.url.prev} class="page-link">← Anterior</a>
          )}
          {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(n => (
            <a
              href={n === 1 ? '/nutricion' : `/nutricion/${n}`}
              class={`page-link ${n === page.currentPage ? 'page-link--active' : ''}`}
            >
              {n}
            </a>
          ))}
          {page.url.next && (
            <a href={page.url.next} class="page-link">Siguiente →</a>
          )}
        </nav>
      )}

      <!-- Índice completo de la categoría.
           La rejilla de arriba está paginada de 20 en 20, así que sin esta
           lista una calculadora de la página 4 sólo recibía enlaces desde esa
           página. Con ella todas quedan a un clic desde cualquier página
           de la categoría. -->
      {page.lastPage > 1 && (
        <nav class="cat-index" aria-label={`Todas las calculadoras de ${cat.label}`}>
          <p class="cat-index__title">Todas las calculadoras de {cat.label} ({allCalcs.length})</p>
          <ul class="cat-index__list">
            {allCalcs.map(calc => (
              <li>
                <a href={calc.slug} class="cat-index__link">{calc.nombre}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div style="max-width:860px; margin:0 auto;">
        <AdSlot format="native" gap="40px" />
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .calc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1px;
    background: var(--border);
    margin-bottom: 2px;
  }
  .calc-card {
    background: var(--cream);
    padding: 20px;
    text-decoration: none;
    display: block;
    position: relative;
  }
  .calc-card:hover { background: #EDE9E0; }
  .calc-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    background: var(--ink);
    color: var(--acid);
    flex-shrink: 0;
  }
  .calc-icon--dest { background: var(--acid); color: var(--ink); }
  .calc-nombre { font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 4px; }
  .calc-desc   { font-size: 11px; color: var(--muted); line-height: 1.5; margin-bottom: 8px; }
  .calc-badge {
    font-family: var(--font-mono);
    font-size: 9px;
    padding: 2px 7px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    display: inline-block;
  }
  .calc-badge--popular   { background: var(--acid); color: #1a1a00; }
  .calc-badge--essential { border: 1px solid var(--ink); color: var(--ink); }
  .page-link {
    padding: 6px 14px;
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--ink);
    text-decoration: none;
    background: transparent;
  }
  .page-link:hover { border-color: var(--ink); }
  .page-link--active { background: var(--ink); color: var(--acid); border-color: var(--ink); }
  .cat-index {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .cat-index__title {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .cat-index__list {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 4;
    column-gap: 24px;
  }
  .cat-index__list li { break-inside: avoid; margin-bottom: 7px; }
  .cat-index__link {
    font-size: 12.5px;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.5;
  }
  .cat-index__link:hover { text-decoration: underline; text-decoration-color: var(--acid); text-decoration-thickness: 2px; }
  @media (max-width: 900px) { .cat-index__list { columns: 2; } }
  @media (max-width: 600px) {
    .cat-index__list { columns: 1; }
  }
  /* Móvil: lista nativa (icono · nombre y descripción · chevron) */
  @media (max-width: 767px) {
    .calc-grid { grid-template-columns: 1fr; background: transparent; border-top: 1px solid var(--border); }
    .calc-card {
      display: grid;
      grid-template-columns: 40px minmax(0, 1fr) 16px;
      column-gap: 14px;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
    }
    .calc-card::after {
      content: '';
      grid-column: 3;
      grid-row: 1 / span 3;
      width: 8px;
      height: 8px;
      border-top: 1.75px solid var(--muted);
      border-right: 1.75px solid var(--muted);
      transform: rotate(45deg);
    }
    .calc-icon { grid-row: 1 / span 3; width: 40px; height: 40px; margin: 0; }
    .calc-nombre, .calc-desc, .calc-badge { grid-column: 2; }
    .calc-nombre { font-size: 15px; margin-bottom: 2px; }
    .calc-desc { font-size: 12px; margin-bottom: 0; }
    .calc-badge { justify-self: start; margin-top: 6px; }
    .page-link { min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }
    .cat-index__link { display: inline-block; padding: 6px 0; font-size: 14px; }
  }
</style>
