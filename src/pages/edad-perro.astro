---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import EdadMascotaCalculator from '../components/calculators/EdadMascotaCalculator';

const faqs = [
  { q: '¿Cómo se calcula la edad de un perro en años humanos?', a: 'El primer año de un perro equivale a unos 15 años humanos y el segundo a unos 9 más (24 en total). A partir de ahí, cada año suma entre 4 y 6 años humanos según el tamaño del perro.' },
  { q: '¿Es cierto que un año de perro son 7 humanos?', a: 'Es una simplificación antigua e imprecisa. La equivalencia real no es lineal: los perros maduran muy rápido los primeros dos años y luego envejecen a un ritmo que depende de su tamaño y raza.' },
  { q: '¿Los perros grandes envejecen más rápido?', a: 'Sí. Las razas grandes y gigantes envejecen antes y tienen una esperanza de vida menor que las pequeñas. Por eso la calculadora ajusta el cálculo según el tamaño del perro.' },
  { q: '¿Cómo se calcula la edad de un gato?', a: 'Igual que el perro al principio: el primer año equivale a 15 años humanos y el segundo a 9 más. A partir del tercer año, cada año de gato suma unos 4 años humanos, sin distinción de tamaño.' },
  { q: '¿Cuándo se considera senior a una mascota?', a: 'En general, a partir de los 7 años en perros (antes en razas grandes) y de los 10-11 en gatos. En la calculadora puedes ver la etapa vital aproximada de tu mascota.' },
];
---

<CalculatorLayout
  title="Edad del Perro y Gato en Años Humanos | CalcFit"
  description="Calcula la edad de tu perro o gato en años humanos según su tamaño y especie. Olvida el mito de multiplicar por 7. Gratis."
  calculatorName="Edad del Perro y Gato"
  breadcrumbSlug="edad-perro"
  ogImage="/og/edad-perro.jpg"
  keywords="edad perro años humanos, edad de mi perro, edad gato años humanos, calcular edad perro, años humanos mascota"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Edad del<br><span style="color: var(--acid);">Perro</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Calcula la edad de tu perro o gato en años humanos, ajustada por especie y tamaño.
    </p>
  </div>

  <EdadMascotaCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      La equivalencia no es lineal. Los animales maduran muy rápido los dos primeros años (15 y luego +9 años humanos) y después envejecen a un ritmo que depende del tamaño en perros y es más uniforme en gatos. La regla de "multiplicar por 7" es un mito que da resultados poco precisos.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Años humanos según tamaño (perro)</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Edad real</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Pequeño</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Grande</th>
        </tr>
      </thead>
      <tbody>
        {[
          { r: '2 años', p: '24', g: '24' },
          { r: '5 años', p: '36', g: '42' },
          { r: '10 años', p: '56', g: '72' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.r}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.p}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.g}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
