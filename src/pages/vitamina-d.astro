---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import VitaminaDCalculator from '../components/calculators/VitaminaDCalculator';

const faqs = [
  { q: '¿Cuánto sol necesito para producir vitamina D?', a: 'Depende del tipo de piel, la latitud, la estación y la superficie expuesta. Con piel de tipo III (oliva), en verano, en clima templado y con brazos y piernas expuestos, se necesitan aproximadamente 20–30 minutos al mediodía. Con piel más oscura o en invierno el tiempo se multiplica significativamente.' },
  { q: '¿En qué horas del día se sintetiza la vitamina D?', a: 'La síntesis de vitamina D ocurre cuando el índice UV es ≥3, generalmente entre las 10:00 y las 15:00 horas (hora solar). Fuera de ese horario, incluso en verano, la exposición es insuficiente para producir vitamina D de forma significativa.' },
  { q: '¿Puedo tomar vitamina D por el sol en invierno en Europa o Latinoamérica austral?', a: 'En latitudes superiores a 40° norte o sur durante el invierno (diciembre–febrero en norte, junio–agosto en sur), el ángulo solar es demasiado bajo y el índice UV insuficiente. En estas condiciones es casi imposible sintetizar vitamina D solar y se recomienda suplementación de 800–2000 UI/día.' },
  { q: '¿Cuánta vitamina D produce el sol en la piel?', a: 'Con todo el cuerpo expuesto y un índice UV de 5–6 (verano, clima templado), la piel de tipo III puede sintetizar hasta 10.000–20.000 UI en 20–30 minutos antes de saturarse. La ropa y el protector solar bloquean prácticamente toda la síntesis.' },
  { q: '¿Cuál es la diferencia entre vitamina D2 y D3?', a: 'La vitamina D3 (colecalciferol), sintetizada por la piel o procedente de alimentos animales, es 2–3 veces más efectiva que la D2 (ergocalciferol, de fuentes vegetales) para elevar los niveles séricos de 25-OH-vitamina D. Los suplementos de D3 son los de primera elección según la Endocrine Society.' },
];
---

<CalculatorLayout
  title="Vitamina D Solar — Minutos de Sol por Tipo de Piel | CalcFit"
  description="Calcula los minutos de exposición solar necesarios para sintetizar vitamina D según tu tipo de piel, latitud, estación y zona expuesta. Gratis."
  calculatorName="Vitamina D Solar"
  breadcrumbSlug="vitamina-d"
  ogImage="/og/vitamina-d.jpg"
  keywords="calculadora vitamina D solar, minutos sol vitamina D, tipo de piel vitamina D, síntesis vitamina D, déficit vitamina D sol"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Vitamina D<br><span style="color: var(--acid);">Solar</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Calcula cuántos minutos de sol necesitas para sintetizar vitamina D según tu tipo de piel, zona geográfica, estación y superficie expuesta.
    </p>
  </div>

  <VitaminaDCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se sintetiza la vitamina D con el sol?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      La vitamina D se produce cuando los rayos UVB (longitud de onda 290–315 nm) inciden sobre el 7-dehidrocolesterol de la piel y lo convierten en provitamina D3. La piel más clara requiere menos tiempo porque tiene menos melanina, que actúa como filtro natural. En invierno o a altas latitudes, el ángulo solar hace que los UVB sean absorbidos por la atmósfera antes de llegar a la superficie, imposibilitando la síntesis.
    </p>

    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 380px;">
      <thead>
        <tr style="background: var(--ink); color: var(--acid);">
          <th style="padding: 10px 14px; text-align: left; font-family: var(--font-mono); font-weight: 400;">Tipo de piel (Fitzpatrick)</th>
          <th style="padding: 10px 14px; text-align: left;">Descripción</th>
          <th style="padding: 10px 14px; text-align: left;">Tiempo base (verano/tropical)</th>
        </tr>
      </thead>
      <tbody>
        {[
          ['Tipo I', 'Muy clara, siempre se quema', '~10 min'],
          ['Tipo II', 'Clara, se quema fácilmente', '~14 min'],
          ['Tipo III', 'Oliva, se quema moderado', '~20 min'],
          ['Tipo IV', 'Morena, raramente se quema', '~28 min'],
          ['Tipo V', 'Oscura, muy raramente se quema', '~35 min'],
          ['Tipo VI', 'Muy oscura, nunca se quema', '~40 min'],
        ].map(([t, d, mins], i) => (
          <tr style={`background: ${i % 2 === 0 ? 'white' : '#f9f6f0'};`}>
            <td style="padding: 10px 14px; font-family: var(--font-mono); font-size: 12px;">{t}</td>
            <td style="padding: 10px 14px;">{d}</td>
            <td style="padding: 10px 14px; color: var(--muted);">{mins}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
