---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import EdadCorregidaCalculator from '../components/calculators/EdadCorregidaCalculator';

const faqs = [
  { q: '¿Qué es la edad corregida de un bebé prematuro?', a: 'Es la edad que tendría el bebé si hubiera nacido en la fecha prevista (semana 40). Se obtiene restando a la edad cronológica las semanas que se adelantó el nacimiento. Sirve para valorar su desarrollo de forma justa.' },
  { q: '¿Cómo se calcula la edad corregida?', a: 'Edad corregida = edad cronológica − semanas de prematuridad. Por ejemplo, un bebé nacido a las 32 semanas tiene 8 semanas de prematuridad, que se restan a su edad real.' },
  { q: '¿Hasta cuándo se usa la edad corregida?', a: 'Normalmente hasta los 2 años. A esa edad, la mayoría de los bebés prematuros ya ha alcanzado a los nacidos a término en peso, talla y desarrollo, por lo que deja de aplicarse la corrección.' },
  { q: '¿Por qué es importante la edad corregida?', a: 'Permite valorar los hitos del desarrollo (sonreír, sentarse, gatear) con expectativas realistas. Un prematuro de 6 meses de edad cronológica pero 4 corregida hará cosas propias de un bebé de 4 meses, lo cual es normal.' },
  { q: '¿Se considera prematuro cualquier nacimiento antes de la semana 40?', a: 'Se considera prematuro el nacimiento antes de la semana 37. Entre la 37 y la 42 se habla de bebé a término. Cuanto más prematuro, más relevante es usar la edad corregida.' },
];
---

<CalculatorLayout
  title="Edad Corregida del Bebé Prematuro | CalcFit"
  description="Calcula la edad corregida de tu bebé prematuro a partir de su fecha de nacimiento y las semanas de gestación. Valora su desarrollo. Gratis."
  calculatorName="Edad Corregida del Prematuro"
  breadcrumbSlug="edad-corregida"
  ogImage="/og/edad-corregida.jpg"
  keywords="edad corregida, edad corregida prematuro, calcular edad corregida bebé, edad gestacional corregida, desarrollo bebé prematuro"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Edad<br><span style="color: var(--acid);">Corregida</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Calcula la edad corregida de tu bebé prematuro para valorar su desarrollo con expectativas realistas.
    </p>
  </div>

  <EdadCorregidaCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Por qué usar la edad corregida?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Un bebé prematuro nació antes de completar su desarrollo, por lo que comparar sus hitos con los de un bebé nacido a término no sería justo. La <strong>edad corregida</strong> descuenta las semanas de prematuridad para reflejar su madurez real. Se calcula restando esas semanas a la edad cronológica.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Grados de prematuridad</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Tipo</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Semanas al nacer</th>
        </tr>
      </thead>
      <tbody>
        {[
          { t: 'Prematuro tardío', s: '34–36' },
          { t: 'Moderado', s: '32–33' },
          { t: 'Muy prematuro', s: '28–31' },
          { t: 'Extremo', s: '< 28' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.t}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.s}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
