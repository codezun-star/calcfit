  { slug: '/ritmo-maraton',      nombre: 'Ritmo de Maratón',            desc: 'Pace y splits para tu objetivo de maratón',         badge: 'new', destacada: false, num: '52', icon: I.ritmoMaraton },
  { slug: '/indice-conicidad',   nombre: 'Índice de Conicidad',         desc: 'Riesgo cardiovascular por distribución de grasa',   badge: 'new', destacada: false, num: '53', icon: I.indiceConicidad },
  { slug: '/tasa-sudoracion',    nombre: 'Tasa de Sudoración',          desc: 'Pérdida de líquidos y hidratación durante ejercicio',badge: 'new', destacada: false, num: '54', icon: I.tasaSudoracion },
  { slug: '/masa-osea',          nombre: 'Masa Ósea',                   desc: 'Estimación de masa ósea y porcentaje corporal',     badge: 'new', destacada: false, num: '55', icon: I.masaOsea },
  { slug: '/sindrome-metabolico',nombre: 'Síndrome Metabólico',         desc: 'Diagnóstico de síndrome metabólico (IDF 2006)',     badge: 'new', destacada: false, num: '56', icon: I.sindromeMetabolico },
  { slug: '/creatina',           nombre: 'Creatina',                    desc: 'Dosis de carga y mantenimiento según tu peso',      badge: 'new', destacada: false, num: '57', icon: I.creatina },
  { slug: '/calorias-bebidas',   nombre: 'Calorías en Bebidas',         desc: 'Calorías del alcohol en cerveza, vino y licores',   badge: 'new', destacada: false, num: '58', icon: I.calBebidas },
  { slug: '/riesgo-diabetes',    nombre: 'Riesgo de Diabetes',          desc: 'FINDRISC: probabilidad de diabetes tipo 2',         badge: 'new', destacada: false, num: '59', icon: I.riesgoDiabetes },
];

const categorias = [
  {
    label: 'Fitness & salud',
    slugs: [
      '/imc', '/peso-ideal', '/grasa-corporal', '/ffmi', '/complexion-corporal', '/somatotipo', '/indice-adiposidad',
      '/frecuencia-cardiaca', '/vo2-maximo', '/presion-arterial', '/riesgo-cardiovascular',
      '/cintura-cadera', '/cintura-estatura',
      '/1rm', '/volumen-entrenamiento', '/fuerza-relativa', '/masa-muscular',
      '/calorias-ejercicio', '/calorias-caminando', '/calorias-ciclismo', '/calorias-natacion', '/ritmo-carrera',
      '/agua-diaria', '/calorias-diarias',
      '/test-cooper', '/test-rockport', '/recuperacion-cardiaca', '/temperatura-corporal',
      '/presion-pulso', '/talla-predicha',
      '/vam', '/indice-masa-grasa', '/ritmo-maraton', '/indice-conicidad', '/tasa-sudoracion', '/masa-osea', '/sindrome-metabolico',
    ],
  },
  {
    label: 'Embarazo & fertilidad',
    slugs: ['/ovulacion', '/ciclo-menstrual', '/semana-embarazo', '/fecha-parto', '/peso-embarazo'],
  },
  {
    label: 'Fechas & tiempo',
    slugs: ['/edad', '/dias-fechas'],
  },
  {
    label: 'Nutrición & bienestar',
    slugs: ['/macronutrientes', '/proteinas', '/metabolismo-basal', '/deficit-calorico', '/resistencia-insulina', '/glucosa', '/colesterol', '/carga-glucemica', '/cafeina', '/sueno', '/ayuno-intermitente', '/alcoholemia', '/creatina', '/calorias-bebidas', '/riesgo-diabetes'],
  },
];

// Mapa slug → categoría para pasar al componente React
const catBySlug: Record<string, string> = {};
for (const cat of categorias) {
  for (const slug of cat.slugs) catBySlug[slug] = cat.label;
}
const calcWithCat = calculadoras.map(c => ({ ...c, categoria: catBySlug[c.slug] ?? '' }));
const catLabels = categorias.map(c => c.label);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'CalcFit',
      url: 'https://www.calcfit.com',
      description: 'Calculadoras de salud gratuitas y validadas científicamente para toda Latinoamérica',
      inLanguage: 'es',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: 'https://www.calcfit.com/?q={search_term_string}' },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      name: 'CalcFit',
      url: 'https://www.calcfit.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.calcfit.com/favicon.svg',
        width: 32,
        height: 32,
      },
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'codezun@gmail.com',
        contactType: 'customer support',
        availableLanguage: 'Spanish',
      },
      description: '59 calculadoras de salud gratuitas, validadas científicamente, sin registro ni cookies de rastreo.',
    },
    {
      '@type': 'ItemList',
      name: 'Calculadoras de salud CalcFit',
      numberOfItems: 59,
      itemListElement: calculadoras.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.nombre,
        url: `https://www.calcfit.com${c.slug}`,
        description: c.desc,
      })),
    },
  ],
};
---

<Base
  title="CalcFit — 59 Calculadoras de Salud Gratuitas y Validadas Científicamente"
  description="59 calculadoras de salud gratuitas: IMC, calorías, glucosa, colesterol, masa muscular, 1RM, riesgo cardiovascular y más. Sin registro. Validadas científicamente."
  keywords="calculadoras de salud gratis, calculadora IMC, calculadora calorías, calculadora peso ideal, calcular grasa corporal, calculadoras fitness"
  schema={schema}
>

<!-- NAVBAR -->
<nav style="background: var(--ink); padding: 0 32px; display: flex; align-items: center; justify-content: space-between; height: 56px; position: fixed; top: 0; left: 0; right: 0; z-index: 100;">
  <a href="/" style="display: flex; align-items: center; gap: 6px; text-decoration: none;">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="#CAFF00" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="7.5" y="1" width="3" height="16"/>
      <rect x="1" y="7.5" width="16" height="3"/>
    </svg>
    <span style="font-family: var(--font-display); font-size: 26px; color: var(--acid);">CalcFit</span>
  </a>
  <div style="display: flex; align-items: center; gap: 24px;">
    <a href="#fitness"   class="nav-text nav-cat" style="font-size: 12px; color: #888; letter-spacing: 0.5px; text-decoration: none;">Fitness</a>
    <a href="#embarazo"  class="nav-text nav-cat" style="font-size: 12px; color: #888; letter-spacing: 0.5px; text-decoration: none;">Embarazo</a>
    <a href="#fechas"    class="nav-text nav-cat" style="font-size: 12px; color: #888; letter-spacing: 0.5px; text-decoration: none;">Fechas</a>
    <a href="#nutricion" class="nav-text nav-cat" style="font-size: 12px; color: #888; letter-spacing: 0.5px; text-decoration: none;">Nutrición</a>
    <a href="#calculadoras" style="font-size: 12px; font-weight: 600; background: var(--acid); color: var(--ink); padding: 7px 16px; text-decoration: none;">Empezar</a>
  </div>
</nav>
<div style="height: 56px;"></div>

<!-- HERO -->
<section class="hero-grid">
  <div class="hero-left">
    <p class="anim anim-1" style="font-family: var(--font-mono); font-size: 10px; color: #aaa; text-transform: uppercase; letter-spacing: 3px;">
      Calculadoras de salud · Validadas científicamente
    </p>
    <h1 class="anim anim-2 hero-h1" style="font-family: var(--font-display); line-height: 0.92; color: white;">
      Tu cuerpo /<br><span style="color: var(--acid);">tiene</span> /<br>respuestas.
    </h1>
    <p class="anim anim-3" style="font-size: 12px; color: #ccc; font-weight: 300; max-width: 320px; line-height: 1.7;">
      Herramientas de salud precisas y gratuitas. Sin registros, sin publicidad, sin datos almacenados.
    </p>
    <div class="anim anim-4" style="display: flex; gap: 10px; flex-wrap: wrap;">
      <a href="#calculadoras" style="background: var(--acid); color: var(--ink); padding: 12px 24px; font-weight: 600; font-size: 13px; text-decoration: none;">Ver calculadoras</a>
      <a href="#manifesto" style="background: transparent; border: 1px solid rgba(255,255,255,0.2); color: #ccc; padding: 12px 24px; font-size: 13px; text-decoration: none;">Cómo funciona</a>
    </div>
  </div>
  <div class="hero-nums" style="background: var(--ink-2); padding: 28px; border-left: 1px solid var(--ink-3); display: flex; flex-direction: column; justify-content: center;">
    <p style="font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 2px; color: #888; margin-bottom: 20px;">Resultados en tiempo real</p>
    {[
      { nombre: 'IMC', formula: 'kg / m²', valor: '22.4', unidad: '' },
      { nombre: 'Calorías', formula: 'Mifflin-St Jeor', valor: '1850', unidad: 'kcal' },
      { nombre: 'Agua', formula: '35 ml × kg', valor: '2.3', unidad: 'L' },
    ].map((r) => (
      <div style="padding: 18px 0; border-bottom: 1px solid var(--ink-3);">
        <div style="font-size: 11px; color: #888;">{r.nombre}</div>
        <div style="font-size: 9px; color: #888; font-family: var(--font-mono); margin: 2px 0;">{r.formula}</div>
        <div>
          <span style="font-family: var(--font-display); font-size: 44px; color: var(--acid);">{r.valor}</span>
          {r.unidad && <span style="font-size: 11px; color: #999; margin-left: 4px;">{r.unidad}</span>}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- TICKER -->
<div style="background: var(--acid); padding: 10px 32px; display: flex; align-items: center; gap: 24px; flex-wrap: wrap;">
  {[
    { num: '100K+', txt: 'Usuarios activos' },
    { num: '99.9%', txt: 'Precisión científica' },
    { num: '0',     txt: 'Datos almacenados' },
    { num: 'OMS',   txt: 'Validación internacional' },
  ].map((item, i) => (
    <>
      {i > 0 && <span style="color: #9aaa00;">·</span>}
      <div style="display: flex; align-items: baseline; gap: 6px;">
        <span style="font-family: var(--font-display); font-size: 22px; color: var(--ink);">{item.num}</span>
        <span style="font-size: 10px; font-weight: 500; color: #3a3a00;">{item.txt}</span>
      </div>
    </>
  ))}
</div>

<!-- CALCULADORAS -->
<section id="calculadoras" style="background: var(--cream); padding: 48px 32px;">
  <span id="fitness"   style="display: block; height: 0;"></span>
  <span id="embarazo"  style="display: block; height: 0;"></span>
  <span id="fechas"    style="display: block; height: 0;"></span>
  <span id="nutricion" style="display: block; height: 0;"></span>
  <div style="display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding-bottom: 16px; border-bottom: 1px solid var(--border); margin-bottom: 24px;">
    <h2 style="font-family: var(--font-display); font-size: 48px; color: var(--ink);">Calculadoras</h2>
  </div>
  <CalculatorBrowser calculadoras={calcWithCat} categorias={catLabels} client:load />
</section>

<!-- MANIFESTO -->
<section id="manifesto" class="manifesto-grid" style="background: var(--ink); padding: 56px 32px;">
