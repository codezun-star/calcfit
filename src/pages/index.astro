  { slug: '/temperatura-corporal', nombre: 'Temperatura Corporal',        desc: 'Fiebre, febrícula e hipotermia en °C/°F',    badge: 'new',      destacada: false, num: '43', icon: I.tempCorporal },
  { slug: '/carga-glucemica',      nombre: 'Carga Glucémica',             desc: 'Impacto glucémico real de cualquier alimento', badge: 'new',    destacada: false, num: '44', icon: I.cargaGlucemica },
  { slug: '/peso-embarazo',        nombre: 'Peso en el Embarazo',         desc: 'Ganancia de peso gestacional (IOM 2009)',     badge: 'new',      destacada: false, num: '45', icon: I.pesoEmbarazo },
  { slug: '/presion-pulso',        nombre: 'Presión de Pulso',            desc: 'Diferencial sistólica − diastólica (PP)',     badge: 'new',      destacada: false, num: '46', icon: I.presionPulso },
