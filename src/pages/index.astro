// Mapa slug → categoría para pasar al componente React
const catBySlug: Record<string, string> = {};
for (const cat of categorias) {
  for (const slug of cat.slugs) catBySlug[slug] = cat.label;
}
const calcWithCat = calculadoras.map(c => ({ ...c, categoria: catBySlug[c.slug] ?? '' }));
const catLabels = categorias.map(c => c.label);
const categoryPageUrls: Record<string, string> = {
  'Fitness & salud':       '/fitness',
  'Embarazo & fertilidad': '/embarazo',
  'Fechas & tiempo':       '/fechas',
  'Nutrición & bienestar': '/nutricion',
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'CalcFit',
      url: 'https://www.calcfit.com',
      description: 'Calculadoras de salud gratuitas y validadas científicamente para toda Latinoamérica',
      inLanguage: 'es',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: 'https://www.calcfit.com/?q={search_term_string}' },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      name: 'CalcFit',
      url: 'https://www.calcfit.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.calcfit.com/favicon.svg',
        width: 32,
        height: 32,
      },
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'codezun@gmail.com',
        contactType: 'customer support',
        availableLanguage: 'Spanish',
      },
      description: '99 calculadoras de salud gratuitas, validadas científicamente, sin registro ni cookies de rastreo.',
    },
    {
      '@type': 'ItemList',
      name: 'Calculadoras de salud CalcFit',
      numberOfItems: 99,
      itemListElement: calculadoras.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.nombre,
        url: `https://www.calcfit.com${c.slug}`,
        description: c.desc,
      })),
    },
  ],
};

const ultimosArticulos = (await getCollection('blog', e => e.data.publicado !== false))
  .sort((a, b) => b.data.fecha.localeCompare(a.data.fecha))
  .slice(0, 3);
const catNombre: Record<string, string> = { fitness: 'Fitness', nutricion: 'Nutrición', salud: 'Salud', guias: 'Guías', general: 'General' };
function blogThumb(url: string): string {
  return url.replace(/&w=\d+/, '&w=640').replace(/&h=\d+/, '&h=360');
}
---

<Base
  title="CalcFit — 99 Calculadoras de Salud Gratuitas y Validadas Científicamente"
  description="99 calculadoras de salud gratuitas: IMC, calorías, embarazo, glucosa, colesterol, masa muscular, 1RM, riesgo cardiovascular y más. Sin registro. Validadas científicamente."
  keywords="calculadoras de salud gratis, calculadora IMC, calculadora calorías, calculadora peso ideal, calcular grasa corporal, calculadoras fitness"
  schema={schema}
>

<!-- NAVBAR -->
<nav style="background: var(--ink); padding: 0 32px; display: flex; align-items: center; justify-content: space-between; height: 56px; position: fixed; top: 0; left: 0; right: 0; z-index: 100;">
  <a href="/" style="display: flex; align-items: center; text-decoration: none;">
    <img src="/logo.svg" height="44" alt="CalcFit" style="display: block;" />
  </a>
  <div style="display: flex; align-items: center; gap: 24px;">
    <a href="#fitness"   class="nav-text nav-cat" style="font-size: 12px; color: #888; letter-spacing: 0.5px; text-decoration: none;">Fitness</a>
    <a href="#embarazo"  class="nav-text nav-cat" style="font-size: 12px; color: #888; letter-spacing: 0.5px; text-decoration: none;">Embarazo</a>
    <a href="#fechas"    class="nav-text nav-cat" style="font-size: 12px; color: #888; letter-spacing: 0.5px; text-decoration: none;">Fechas</a>
    <a href="#nutricion" class="nav-text nav-cat" style="font-size: 12px; color: #888; letter-spacing: 0.5px; text-decoration: none;">Nutrición</a>
    <a href="/blog" class="nav-text nav-cat" style="font-size: 12px; color: #888; letter-spacing: 0.5px; text-decoration: none;">Blog</a>
    <a href="#calculadoras" style="font-size: 12px; font-weight: 600; background: var(--acid); color: var(--ink); padding: 7px 16px; text-decoration: none;">Empezar</a>
  </div>
</nav>
<div style="height: 56px;"></div>

<!-- HERO -->
<section class="hero-grid">
  <div class="hero-left">
    <p class="anim anim-1" style="font-family: var(--font-mono); font-size: 10px; color: #aaa; text-transform: uppercase; letter-spacing: 3px;">
      Calculadoras de salud · Validadas científicamente
    </p>
    <h1 class="anim anim-2 hero-h1" style="font-family: var(--font-display); line-height: 0.92; color: white;">
      Tu cuerpo /<br><span style="color: var(--acid);">tiene</span> /<br>respuestas.
    </h1>
    <p class="anim anim-3" style="font-size: 12px; color: #ccc; font-weight: 300; max-width: 320px; line-height: 1.7;">
      Herramientas de salud precisas y gratuitas. Sin registros, sin publicidad, sin datos almacenados.
    </p>
    <div class="anim anim-4" style="display: flex; gap: 10px; flex-wrap: wrap;">
      <a href="#calculadoras" style="background: var(--acid); color: var(--ink); padding: 12px 24px; font-weight: 600; font-size: 13px; text-decoration: none;">Ver calculadoras</a>
      <a href="#manifesto" style="background: transparent; border: 1px solid rgba(255,255,255,0.2); color: #ccc; padding: 12px 24px; font-size: 13px; text-decoration: none;">Cómo funciona</a>
    </div>
  </div>
  <div class="hero-nums" style="background: var(--ink-2); padding: 28px; border-left: 1px solid var(--ink-3); display: flex; flex-direction: column; justify-content: center;">
    <p style="font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 2px; color: #888; margin-bottom: 20px;">Resultados en tiempo real</p>
    {[
      { nombre: 'IMC', formula: 'kg / m²', valor: '22.4', unidad: '' },
      { nombre: 'Calorías', formula: 'Mifflin-St Jeor', valor: '1850', unidad: 'kcal' },
      { nombre: 'Agua', formula: '35 ml × kg', valor: '2.3', unidad: 'L' },
    ].map((r) => (
      <div style="padding: 18px 0; border-bottom: 1px solid var(--ink-3);">
        <div style="font-size: 11px; color: #888;">{r.nombre}</div>
        <div style="font-size: 9px; color: #888; font-family: var(--font-mono); margin: 2px 0;">{r.formula}</div>
        <div>
          <span style="font-family: var(--font-display); font-size: 44px; color: var(--acid);">{r.valor}</span>
          {r.unidad && <span style="font-size: 11px; color: #999; margin-left: 4px;">{r.unidad}</span>}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- TICKER -->
<div style="background: var(--acid); padding: 10px 32px; display: flex; align-items: center; gap: 24px; flex-wrap: wrap;">
  {[
    { num: '100K+', txt: 'Usuarios activos' },
    { num: '99.9%', txt: 'Precisión científica' },
    { num: '0',     txt: 'Datos almacenados' },
    { num: 'OMS',   txt: 'Validación internacional' },
  ].map((item, i) => (
    <>
      {i > 0 && <span style="color: #9aaa00;">·</span>}
      <div style="display: flex; align-items: baseline; gap: 6px;">
        <span style="font-family: var(--font-display); font-size: 22px; color: var(--ink);">{item.num}</span>
        <span style="font-size: 10px; font-weight: 500; color: #3a3a00;">{item.txt}</span>
      </div>
    </>
  ))}
</div>

<!-- CALCULADORAS -->
<section id="calculadoras" style="background: var(--cream); padding: 48px 32px;">
  <span id="fitness"   style="display: block; height: 0;"></span>
  <span id="embarazo"  style="display: block; height: 0;"></span>
  <span id="fechas"    style="display: block; height: 0;"></span>
  <span id="nutricion" style="display: block; height: 0;"></span>
  <div style="display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding-bottom: 16px; border-bottom: 1px solid var(--border); margin-bottom: 24px;">
    <h2 style="font-family: var(--font-display); font-size: 48px; color: var(--ink);">Calculadoras</h2>
  </div>
  <CalculatorBrowser calculadoras={calcWithCat} categorias={catLabels} limit={15} categoryPageUrls={categoryPageUrls} client:load />
</section>

<!-- MANIFESTO -->
<section id="manifesto" class="manifesto-grid" style="background: var(--ink); padding: 56px 32px;">
  <div class="manifesto-left" style="display: flex; flex-direction: column; justify-content: center; gap: 16px;">
    <p style="font-family: var(--font-mono); font-size: 10px; color: #888; text-transform: uppercase; letter-spacing: 3px;">Nuestro compromiso</p>
    <h2 style="font-family: var(--font-display); font-size: 62px; color: white; line-height: 0.95;">
      Ciencia, /<br>no /<br><span style="color: var(--acid);">opinión.</span>
    </h2>
  </div>
  <div class="manifesto-right" style="display: flex; flex-direction: column; justify-content: center;">
    {[
      { n: '01', title: 'Validadas científicamente', desc: 'Fórmulas basadas en evidencia: OMS, ACSM y literatura médica peer-reviewed.' },
      { n: '02', title: 'Privacidad total', desc: 'Todo el cálculo ocurre en tu navegador. Cero cookies de rastreo.' },
      { n: '03', title: 'Siempre gratis', desc: 'Sin planes premium, sin registro obligatorio, sin letra pequeña.' },
    ].map((f, i) => (
      <div style={`padding: 20px 0; ${i < 2 ? 'border-bottom: 1px solid #1e1e1e;' : ''}`}>
        <div style="display: flex; align-items: baseline; gap: 10px; margin-bottom: 6px;">
          <span style="font-family: var(--font-mono); font-size: 12px; color: var(--acid);">{f.n} —</span>
          <span style="font-size: 13px; font-weight: 500; color: white;">{f.title}</span>
        </div>
        <p style="font-size: 12px; color: #999; line-height: 1.6;">{f.desc}</p>
      </div>
    ))}
  </div>
</section>

<!-- CTA -->
<section class="cta-section" style="background: var(--acid); padding: 52px 32px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px;">
  <div>
    <h2 style="font-family: var(--font-display); font-size: 58px; color: var(--ink); line-height: 0.95;">Empieza /<br>ahora.</h2>
    <p style="font-size: 13px; color: #3a3900; margin-top: 8px;">99 calculadoras gratuitas te esperan.</p>
  </div>
  <div style="display: flex; gap: 12px; flex-wrap: wrap;">
    <a href="#calculadoras" style="background: var(--ink); color: var(--acid); padding: 14px 28px; font-weight: 600; font-size: 13px; text-decoration: none;">Ver calculadoras</a>
    <a href="/imc" style="background: transparent; border: 1px solid var(--ink); color: var(--ink); padding: 14px 28px; font-size: 13px; text-decoration: none;">Calcular mi IMC</a>
  </div>
</section>

<!-- BLOG -->
{ultimosArticulos.length > 0 && (
<section style="background:var(--cream); border-top:1px solid var(--border); padding:52px 32px;">
  <div style="max-width:1100px; margin:0 auto;">
    <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:32px; flex-wrap:wrap; gap:12px;">
      <h2 style="font-family:var(--font-display); font-size:42px; color:var(--ink); letter-spacing:0.3px; margin:0;">DESDE EL BLOG</h2>
      <a href="/blog" style="font-family:var(--font-mono); font-size:11px; color:var(--muted); text-decoration:none; text-transform:uppercase; letter-spacing:0.05em;">Ver todos →</a>
    </div>
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:1px; background:var(--border); border:1px solid var(--border);">
      {ultimosArticulos.map((art) => (
        <a
          href={`/blog/${art.id}`}
          style="background:var(--cream); text-decoration:none; display:block; overflow:hidden;"
          onmouseover="this.style.background='#EDE9DF'"
          onmouseout="this.style.background='var(--cream)'"
        >
          {art.data.imagen && (
            <div style="overflow:hidden; height:180px;">
              <img
                src={blogThumb(art.data.imagen)}
                alt={art.data.titulo}
                width="640"
                height="360"
                loading="lazy"
                style="width:100%; height:180px; object-fit:cover; display:block; transition:transform 0.3s;"
                onmouseover="this.style.transform='scale(1.03)'"
                onmouseout="this.style.transform='scale(1)'"
              />
            </div>
          )}
          <div style="padding:20px 24px 24px;">
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px; flex-wrap:wrap;">
              {art.data.categoria && (
                <span style="font-family:var(--font-mono); font-size:9px; font-weight:500; text-transform:uppercase; letter-spacing:0.08em; background:var(--ink); color:var(--acid); padding:2px 8px;">
                  {catNombre[art.data.categoria] ?? art.data.categoria}
                </span>
              )}
            </div>
            <p style="font-family:var(--font-body); font-size:15px; font-weight:600; color:var(--ink); margin:0 0 6px; line-height:1.3;">{art.data.titulo}</p>
            <p style="font-family:var(--font-body); font-size:13px; color:var(--muted); margin:0; line-height:1.55;">{art.data.descripcion}</p>
            <span style="display:inline-block; margin-top:14px; font-family:var(--font-mono); font-size:11px; color:var(--ink); text-transform:uppercase; letter-spacing:0.05em;">Leer →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
)}

<Footer />

</Base>

<style>
  /* Hero */
  .hero-grid { display: grid; grid-template-columns: 60% 40%; min-height: 480px; }
  .hero-h1   { font-size: 96px; }
  .hero-left {
    padding: 56px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    position: relative;
    background-color: #0A0A09;
    background-image:
      linear-gradient(rgba(10, 10, 9, 0.72), rgba(10, 10, 9, 0.72)),
      url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1400&q=80&fit=crop&crop=focalpoint&fp-y=0.3');
    background-size: cover;
    background-position: center top;
  }

  /* Calculator grid */
  .calc-grid-3col { display: grid; grid-template-columns: repeat(3, 1fr); }

  /* Manifesto */
  .manifesto-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .manifesto-left { border-right: 1px solid #222; padding-right: 48px; }
  .manifesto-right { padding-left: 48px; }

  /* Smooth scroll con offset para navbar sticky */
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 64px; }

  /* Nav text links (homepage) */
  .nav-text { display: inline; }
  .nav-cat:hover { color: var(--acid) !important; }

  @media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-nums { display: none; }
    .hero-h1   { font-size: 62px; }
    .hero-left { min-height: 420px; background-position: center center; }
    .calc-grid-3col { grid-template-columns: repeat(2, 1fr); }
    .manifesto-grid { grid-template-columns: 1fr; }
    .manifesto-left  { border-right: none; padding-right: 0; border-bottom: 1px solid #222; padding-bottom: 32px; }
    .manifesto-right { padding-left: 0; padding-top: 24px; }
    .nav-text { display: none; }
    #calculadoras { padding-left: 16px !important; padding-right: 16px !important; }
    #manifesto    { padding-left: 16px !important; padding-right: 16px !important; }
    .cta-section  { padding-left: 16px !important; padding-right: 16px !important; }
  }

  @media (max-width: 480px) {
    .hero-h1 { font-size: 48px; }
    .calc-grid-3col { grid-template-columns: 1fr 1fr; }
  }
</style>
