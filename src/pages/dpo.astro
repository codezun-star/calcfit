---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import DPOCalculator from '../components/calculators/DPOCalculator';

const faqs = [
  { q: '¿Qué significa DPO?', a: 'DPO son las siglas de "días post ovulación", es decir, los días transcurridos desde que ovulaste. Es una referencia muy usada por quienes buscan embarazo para seguir su ciclo y saber cuándo hacerse un test.' },
  { q: '¿Cuándo ocurre la implantación según los DPO?', a: 'La implantación del embrión suele producirse entre los 6 y los 12 DPO, con mayor frecuencia alrededor de los 8-10 DPO. A partir de ahí el cuerpo empieza a producir la hormona hCG.' },
  { q: '¿A cuántos DPO puedo hacerme un test de embarazo?', a: 'Un test en orina es bastante fiable a partir de los 12-14 DPO. Antes puede dar un falso negativo porque los niveles de hCG aún son demasiado bajos para detectarse.' },
  { q: '¿Qué síntomas hay a los pocos DPO?', a: 'Muchos síntomas tempranos (sensibilidad mamaria, cansancio, cambios de humor) se solapan con los del síndrome premenstrual, por lo que no son fiables para confirmar un embarazo. El test es el método seguro.' },
  { q: '¿Cómo sé en qué día ovulé?', a: 'Puedes estimarlo con los tests de ovulación (LH), la temperatura basal o nuestra calculadora de ovulación, que aproxima tu día fértil a partir de la duración de tu ciclo.' },
];
---

<CalculatorLayout
  title="Calculadora DPO — Días Post Ovulación | CalcFit"
  description="Calcula tus días post ovulación (DPO), la ventana de implantación y cuándo hacerte el test de embarazo a partir de tu ovulación. Gratis."
  calculatorName="Días Post Ovulación (DPO)"
  breadcrumbSlug="dpo"
  ogImage="/og/dpo.jpg"
  keywords="DPO, días post ovulación, calculadora DPO, cuándo hacer test embarazo, ventana de implantación, DPO test"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Días Post<br><span style="color: var(--acid);">Ovulación</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Calcula tus DPO, la fase en la que estás y cuándo un test de embarazo será fiable.
    </p>
  </div>

  <DPOCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Qué son los DPO?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Los días post ovulación cuentan el tiempo desde tu ovulación, el momento clave de la fertilidad. Sirven para saber en qué fase de la <strong>espera de dos semanas</strong> estás, cuándo puede ocurrir la implantación y a partir de qué día un test de embarazo es fiable.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Qué ocurre en cada fase</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">DPO</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Qué ocurre</th>
        </tr>
      </thead>
      <tbody>
        {[
          { d: '0–5', q: 'Fecundación y viaje del óvulo' },
          { d: '6–12', q: 'Ventana de implantación' },
          { d: '12–14', q: 'Test de embarazo ya fiable' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.d}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.q}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
