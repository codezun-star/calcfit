---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import CaloriasPesasCalculator from '../components/calculators/CaloriasPesasCalculator';

const faqs = [
  { q: '¿Cuántas calorías se queman levantando pesas?', a: 'Una persona de 70 kg quema unas 220 kcal en 45 minutos de entrenamiento vigoroso de fuerza y hasta 290 kcal en un circuito intenso. El gasto sube con la intensidad, la densidad de la sesión y el peso corporal.' },
  { q: '¿Las pesas queman menos calorías que el cardio?', a: 'Durante la sesión, el cardio suele quemar más por minuto. Sin embargo, las pesas aumentan la masa muscular, que eleva tu metabolismo en reposo, y generan un mayor gasto posterior (efecto EPOC).' },
  { q: '¿Levantar pesas adelgaza?', a: 'Sí. Además de quemar calorías durante el entrenamiento, construir músculo aumenta tu gasto diario y mejora la composición corporal. Para perder grasa necesitas mantener un déficit calórico.' },
  { q: '¿Qué quema más, series largas o circuitos?', a: 'Los circuitos con poco descanso elevan la frecuencia cardíaca y queman más calorías por sesión que el entrenamiento tradicional con descansos largos, aunque este último puede ser mejor para ganar fuerza máxima.' },
  { q: '¿Cuánto gasto extra genera tener más músculo?', a: 'Cada kilo de músculo gasta en reposo más que un kilo de grasa. Aunque la diferencia por kilo es modesta, ganar varios kilos de músculo eleva de forma apreciable tu metabolismo basal a largo plazo.' },
];
---

<CalculatorLayout
  title="Calorías Levantando Pesas — Cuántas Quemas | CalcFit"
  description="Calcula cuántas calorías quemas entrenando con pesas según tu peso, los minutos y la intensidad de la sesión. Fuerza y circuito. Gratis."
  calculatorName="Calorías Levantando Pesas"
  breadcrumbSlug="calorias-pesas"
  ogImage="/og/calorias-pesas.jpg"
  keywords="calorías levantando pesas, cuántas calorías quema el gimnasio, gasto calórico pesas, entrenamiento fuerza calorías, pesas adelgaza"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Calorías<br><span style="color: var(--acid);">con Pesas</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Descubre cuántas calorías quemas en el gimnasio levantando pesas, según tu peso, el tiempo y la intensidad.
    </p>
  </div>

  <CaloriasPesasCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Se aplica la fórmula de los METs: <strong>kcal = MET × 3,5 × peso(kg) ÷ 200 × minutos</strong>. El entrenamiento de fuerza suave ronda un MET de 3,5; el vigoroso, 6,0; y el circuito intenso, 8,0. A esto se suma el gasto posterior (EPOC) que el músculo genera tras la sesión.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Calorías por 45 minutos según peso (vigoroso)</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Peso</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Vigoroso</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Circuito</th>
        </tr>
      </thead>
      <tbody>
        {[
          { p: '55 kg', v: '~173 kcal', c: '~231 kcal' },
          { p: '70 kg', v: '~220 kcal', c: '~294 kcal' },
          { p: '85 kg', v: '~268 kcal', c: '~357 kcal' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.p}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.v}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.c}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
