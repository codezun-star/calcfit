---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import PasosCaloriasCalculator from '../components/calculators/PasosCaloriasCalculator';

const faqs = [
  { q: '¿Cuántas calorías se queman con 10.000 pasos?', a: 'Una persona de unos 70 kg quema en torno a 400 kcal al completar 10.000 pasos, lo que equivale a unos 7-8 km. El gasto depende del peso corporal, la zancada y el ritmo: a más peso y mayor velocidad, más calorías.' },
  { q: '¿Cómo se convierten los pasos en calorías?', a: 'Una estimación práctica es multiplicar los pasos por 0,04 kcal y ajustar por tu peso respecto a 70 kg. Caminar quema aproximadamente entre 0,03 y 0,06 kcal por paso según tu masa corporal y la intensidad.' },
  { q: '¿Cuántos kilómetros son 10.000 pasos?', a: 'Dependen de tu zancada, que ronda el 41,5% de tu altura. Para una persona de 1,70 m, 10.000 pasos son unos 7 km; para alguien más alto, algo más. Por eso la calculadora pide tu altura.' },
  { q: '¿Caminar 10.000 pasos al día adelgaza?', a: 'Ayuda. Quemar ~400 kcal diarias adicionales mantenido en el tiempo contribuye al déficit calórico necesario para perder grasa, siempre que la alimentación acompañe. Caminar también mejora la salud cardiovascular.' },
  { q: '¿Es mejor caminar rápido o más tiempo?', a: 'Ambos suman. Caminar más rápido eleva el gasto por minuto y la intensidad cardiovascular; caminar más tiempo acumula más pasos y distancia. Para quemar grasa, lo importante es el volumen total de actividad semanal.' },
];
---

<CalculatorLayout
  title="Pasos a Calorías — Cuántas Quemas al Día | CalcFit"
  description="Convierte tus pasos diarios en calorías quemadas y kilómetros. Descubre cuánto quemas con 10.000 pasos según tu peso y altura. Gratis."
  calculatorName="Pasos a Calorías"
  breadcrumbSlug="pasos-calorias"
  ogImage="/og/pasos-calorias.jpg"
  keywords="pasos a calorías, cuántas calorías quemo caminando, calorías 10000 pasos, pasos a kilómetros, calcular calorías por pasos"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Pasos a<br><span style="color: var(--acid);">Calorías</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Convierte los pasos que das al día en calorías quemadas y kilómetros recorridos, ajustado a tu peso y altura.
    </p>
  </div>

  <PasosCaloriasCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calculan las calorías de los pasos?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      El gasto se estima multiplicando el número de pasos por un factor calórico (~0,04 kcal/paso) y ajustándolo a tu peso corporal. La distancia se obtiene de tu zancada, que equivale aproximadamente al <strong>41,5% de tu altura</strong>. Por eso dos personas con los mismos pasos pueden quemar y recorrer cantidades distintas.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Calorías aproximadas por pasos (70 kg)</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Pasos</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Calorías</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Distancia</th>
        </tr>
      </thead>
      <tbody>
        {[
          { p: '5.000', c: '~200 kcal', d: '~3,5 km' },
          { p: '7.500', c: '~300 kcal', d: '~5,3 km' },
          { p: '10.000', c: '~400 kcal', d: '~7 km' },
          { p: '15.000', c: '~600 kcal', d: '~10,5 km' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.p}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.c}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.d}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
