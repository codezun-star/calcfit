---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import SuperficieCorporalCalculator from '../components/calculators/SuperficieCorporalCalculator';

const faqs = [
  { q: '¿Qué es la superficie corporal (BSA)?', a: 'La superficie corporal (BSA, por sus siglas en inglés) es el área total externa del cuerpo, expresada en metros cuadrados. Se usa en medicina para ajustar dosis de fármacos, quimioterapia e índices fisiológicos.' },
  { q: '¿Cómo se calcula la superficie corporal?', a: 'La fórmula de Mosteller es la más usada: BSA = raíz cuadrada de (altura en cm × peso en kg ÷ 3600). También mostramos la fórmula de DuBois, algo más antigua pero igualmente válida.' },
  { q: '¿Cuál es la superficie corporal media de un adulto?', a: 'Ronda los 1,7 m² en adultos: alrededor de 1,9 m² en hombres y 1,6 m² en mujeres. Varía con el peso y la altura, por lo que cada persona tiene su propio valor.' },
  { q: '¿Para qué se usa el BSA en medicina?', a: 'Se emplea para calcular dosis de quimioterapia, ajustar medicamentos, estimar el gasto cardíaco (índice cardíaco) y valorar la función renal. Es más preciso que el peso para muchas dosis.' },
  { q: '¿Mosteller o DuBois, cuál es mejor?', a: 'La fórmula de Mosteller es la más utilizada hoy por su sencillez y buena precisión. DuBois fue la original de 1916 y da resultados muy similares. Ambas son aceptadas en la práctica clínica.' },
];
---

<CalculatorLayout
  title="Superficie Corporal (BSA) — Fórmula Mosteller | CalcFit"
  description="Calcula tu superficie corporal (BSA) en m² con las fórmulas de Mosteller y DuBois a partir de tu peso y altura. Útil en dosis médicas. Gratis."
  calculatorName="Superficie Corporal (BSA)"
  breadcrumbSlug="superficie-corporal"
  ogImage="/og/superficie-corporal.jpg"
  keywords="superficie corporal, BSA, calcular superficie corporal, fórmula Mosteller, superficie corporal m2, área de superficie corporal"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Superficie<br><span style="color: var(--acid);">Corporal</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Calcula tu superficie corporal (BSA) en metros cuadrados con las fórmulas de Mosteller y DuBois.
    </p>
  </div>

  <SuperficieCorporalCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      La fórmula de <strong>Mosteller</strong> es BSA = √(altura × peso ÷ 3600), donde la altura está en cm y el peso en kg. La de <strong>DuBois</strong> usa 0,007184 × altura<sup>0,725</sup> × peso<sup>0,425</sup>. Ambas dan resultados muy parecidos y se usan para personalizar dosis de medicamentos.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Valores medios de superficie corporal</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Grupo</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">BSA media</th>
        </tr>
      </thead>
      <tbody>
        {[
          { g: 'Recién nacido', v: '~0,25 m²' },
          { g: 'Niño (9 años)', v: '~1,07 m²' },
          { g: 'Mujer adulta', v: '~1,6 m²' },
          { g: 'Hombre adulto', v: '~1,9 m²' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.g}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.v}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
