---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import KetoMacrosCalculator from '../components/calculators/KetoMacrosCalculator';

const faqs = [
  { q: '¿Qué macros se siguen en la dieta keto?', a: 'La dieta cetogénica reparte las calorías en torno al 70% de grasas, 25% de proteína y solo un 5% de carbohidratos. Este reparto mantiene al cuerpo en cetosis, usando grasa como combustible principal.' },
  { q: '¿Cuántos carbohidratos se pueden comer en keto?', a: 'Por lo general entre 20 y 50 g de carbohidratos netos al día. Con un 5% de las calorías, una dieta de 2000 kcal deja unos 25 g de carbohidratos diarios.' },
  { q: '¿Cómo se calculan los macros keto?', a: 'Se parte de tus calorías objetivo y se reparten según los porcentajes keto. Cada gramo de grasa aporta 9 kcal, y cada gramo de proteína o carbohidrato, 4 kcal. La calculadora hace ese reparto por ti.' },
  { q: '¿La dieta keto sirve para adelgazar?', a: 'Puede ayudar a perder grasa porque favorece la saciedad y facilita el déficit calórico. A largo plazo, los resultados dependen de mantener menos calorías de las que gastas, igual que en cualquier dieta.' },
  { q: '¿Es segura la dieta cetogénica?', a: 'Para personas sanas suele ser segura a corto y medio plazo, aunque puede causar la "gripe keto" al inicio. No se recomienda en embarazo, ciertas enfermedades renales o hepáticas sin supervisión médica.' },
];
---

<CalculatorLayout
  title="Macros Keto — Calculadora Dieta Cetogénica | CalcFit"
  description="Calcula tus macros keto (grasas, proteína y carbohidratos) según tus calorías y objetivo. Reparto 70/25/5 para entrar en cetosis. Gratis."
  calculatorName="Macros Keto"
  breadcrumbSlug="keto-macros"
  ogImage="/og/keto-macros.jpg"
  keywords="macros keto, calculadora keto, dieta cetogénica macros, carbohidratos netos keto, macros dieta keto, reparto grasas proteína"
  faqs={faqs}
>
  <div style="background: var(--ink); padding: 40px 32px 32px;">
    <h1 style="font-family: var(--font-display); font-size: clamp(40px, 8vw, 64px); color: white; line-height: 0.92; margin-bottom: 12px;">
      Macros<br><span style="color: var(--acid);">Keto</span>
    </h1>
    <p style="font-size: 13px; color: #999; max-width: 480px; line-height: 1.7;">
      Calcula tus gramos de grasa, proteína y carbohidratos para la dieta cetogénica según tus calorías y objetivo.
    </p>
  </div>

  <KetoMacrosCalculator client:load />

  <div slot="seo">
    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px;">¿Cómo se calcula?</h2>
    <p style="font-size: 14px; line-height: 1.7; color: var(--muted); margin-bottom: 24px;">
      Primero se ajustan tus calorías al objetivo (−20% para perder grasa, +10% para ganar) y luego se reparten con el patrón cetogénico clásico: <strong>70% grasas, 25% proteína y 5% carbohidratos</strong>. Se convierte cada porcentaje a gramos según las calorías por gramo de cada macronutriente.
    </p>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Reparto keto en 2000 kcal</h2>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 24px; min-width: 320px;">
      <thead>
        <tr style="border-bottom: 2px solid var(--border);">
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Macro</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">%</th>
          <th style="text-align: left; padding: 10px 0; font-family: var(--font-mono); font-size: 11px; color: var(--muted); font-weight: 400; text-transform: uppercase; letter-spacing: 1px;">Gramos</th>
        </tr>
      </thead>
      <tbody>
        {[
          { m: 'Grasas', p: '70%', g: '~156 g' },
          { m: 'Proteína', p: '25%', g: '~125 g' },
          { m: 'Carbohidratos', p: '5%', g: '~25 g' },
        ].map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.m}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.p}</td>
            <td style="padding: 10px 0; font-family: var(--font-mono); font-size: 12px; color: var(--ink);">{row.g}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>

    <h2 style="font-family: var(--font-display); font-size: 32px; color: var(--ink); margin-bottom: 16px; margin-top: 32px;">Preguntas frecuentes</h2>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--border); padding-bottom: 14px;">
          <p style="font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 6px;">{faq.q}</p>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.7;">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</CalculatorLayout>
