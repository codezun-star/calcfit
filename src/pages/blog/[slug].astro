---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { searchUnsplash } from '../../lib/unsplash';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const post = await getEntry('blog', slug as string);

if (!post) return Astro.redirect('/blog');

const { Content } = await render(post);

const UNSPLASH_KEY = import.meta.env.UNSPLASH_ACCESS_KEY ?? '';
const imgQuery = post.data.unsplashQuery ?? post.data.keywords.slice(0, 4).join(' ');
const heroPhoto = await searchUnsplash(imgQuery, UNSPLASH_KEY, 'landscape');

const categorias: Record<string, string> = {
  fitness:   'Fitness',
  nutricion: 'Nutrición',
  salud:     'Salud',
  guias:     'Guías',
  general:   'General',
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.titulo,
  description: post.data.descripcion ?? '',
  author: {
    '@type': 'Organization',
    name: post.data.autor,
    url: 'https://www.calcfit.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'CalcFit',
    url: 'https://www.calcfit.com',
    logo: { '@type': 'ImageObject', url: 'https://www.calcfit.com/favicon.svg' },
  },
  datePublished: post.data.fecha,
  url: 'https://www.calcfit.com/blog/' + post.id,
  mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://www.calcfit.com/blog/' + post.id },
  keywords: post.data.keywords.join(', '),
};
---

<Base
  title={`${post.data.titulo} — CalcFit`}
  description={post.data.descripcion ?? ''}
  keywords={post.data.keywords.join(', ')}
  schema={articleSchema}
>
  <Navbar />

  <!-- Header del artículo -->
  <div style="background:var(--ink); padding:40px 20px 32px; margin-top:56px;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:flex; align-items:center; gap:6px; font-size:12px; color:#888; margin-bottom:20px; font-family:var(--font-mono); flex-wrap:wrap;">
        <a href="/" style="text-decoration:none; color:#888;">INICIO</a>
        <span>/</span>
        <a href="/blog" style="text-decoration:none; color:#888;">BLOG</a>
        <span>/</span>
        <span style="color:var(--acid); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:200px;">
          {post.data.titulo.toUpperCase()}
        </span>
      </div>

      {post.data.categoria && (
        <span style="display:inline-block; font-size:10px; font-weight:500; text-transform:uppercase; letter-spacing:0.08em; background:var(--acid); color:var(--ink); padding:3px 10px; font-family:var(--font-mono); margin-bottom:14px;">
          {categorias[post.data.categoria] ?? post.data.categoria}
        </span>
      )}

      <h1 style="font-family:var(--font-display); font-size:clamp(28px, 5vw, 52px); color:var(--cream); margin:0 0 14px; line-height:1.05; letter-spacing:0.3px;">
        {post.data.titulo.toUpperCase()}
      </h1>

      {post.data.descripcion && (
        <p style="font-size:15px; color:#aaa; line-height:1.65; margin:0 0 20px; font-family:var(--font-body);">
          {post.data.descripcion}
        </p>
      )}

      <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
        <span style="font-size:12px; color:#888; font-family:var(--font-mono);">
          {post.data.autor}
        </span>
        {post.data.fecha && (
          <span style="font-size:12px; color:#888; font-family:var(--font-mono);">{post.data.fecha}</span>
        )}
      </div>
    </div>
  </div>

  <!-- Imagen hero -->
  {heroPhoto && (
    <div style="max-width:720px; margin:0 auto; padding:0 20px;">
      <div style="position:relative; overflow:hidden; max-height:420px;">
        <img
          src={heroPhoto.urls.regular}
          alt={heroPhoto.alt_description ?? post.data.titulo}
          width="720"
          height="420"
          loading="eager"
          style="width:100%; height:420px; object-fit:cover; display:block;"
        />
        <a
          href={`${heroPhoto.links.html}?utm_source=calcfit&utm_medium=referral`}
          target="_blank"
          rel="noopener noreferrer"
          style="position:absolute; bottom:0; right:0; background:rgba(0,0,0,0.55); color:#fff; font-size:10px; font-family:var(--font-mono); padding:4px 8px; text-decoration:none; letter-spacing:0.04em;"
        >
          Foto: {heroPhoto.user.name} / Unsplash
        </a>
      </div>
    </div>
  )}

  <!-- Contenido -->
  <main style="max-width:720px; margin:0 auto; padding:32px 20px 60px;">
    <div class="prose">
      <Content />
    </div>

    <!-- CTA calculadoras -->
    <div style="margin-top:48px; border:1px solid var(--ink); padding:24px;">
      <p style="font-family:var(--font-display); font-size:20px; color:var(--ink); margin:0 0 6px; letter-spacing:0.3px;">
        PRUEBA NUESTRAS CALCULADORAS
      </p>
      <p style="font-size:13px; color:var(--muted); line-height:1.55; margin:0 0 16px; font-family:var(--font-body);">
        89 calculadoras de salud gratuitas, sin registro, validadas científicamente.
      </p>
      <a
        href="/"
        style="display:inline-flex; align-items:center; gap:8px; background:var(--acid); color:var(--ink); font-family:var(--font-mono); font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:0.06em; padding:12px 20px; text-decoration:none; transition:opacity 0.15s;"
        onmouseover="this.style.opacity='0.85'"
        onmouseout="this.style.opacity='1'"
      >
        Ver todas las calculadoras
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- Volver -->
    <div style="margin-top:20px;">
      <a
        href="/blog"
        style="display:inline-flex; align-items:center; gap:6px; font-size:12px; color:var(--muted); text-decoration:none; font-family:var(--font-mono); text-transform:uppercase; letter-spacing:0.05em;"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Volver al blog
      </a>
    </div>
  </main>

  <Footer />
</Base>

<style is:global>
  .prose h2 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--ink);
    margin: 2rem 0 0.75rem;
    letter-spacing: 0.3px;
    line-height: 1.1;
  }
  .prose h3 {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    margin: 1.5rem 0 0.5rem;
  }
  .prose p {
    font-family: var(--font-body);
    font-size: 15px;
    color: #3a3830;
    line-height: 1.75;
    margin: 0 0 1rem;
  }
  .prose ul, .prose ol {
    font-family: var(--font-body);
    font-size: 15px;
    color: #3a3830;
    line-height: 1.75;
    padding-left: 1.4rem;
    margin: 0 0 1rem;
  }
  .prose li { margin-bottom: 0.35rem; }
  .prose strong { color: var(--ink); font-weight: 600; }
  .prose a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--acid);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    transition: color 0.15s;
  }
  .prose a:hover { color: #555; }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 14px;
    font-family: var(--font-body);
  }
  .prose th {
    background: var(--ink);
    color: var(--acid);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 8px 12px;
    text-align: left;
  }
  .prose td {
    border-bottom: 1px solid var(--border);
    padding: 8px 12px;
    color: #3a3830;
  }
</style>
