---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import ShareButtons from '../../components/ui/ShareButtons';
import { getCollection, getEntry, render } from 'astro:content';
import AdSlot from '../../components/ads/AdSlot.astro';
import AdRail from '../../components/ads/AdRail.astro';
import AdInContent from '../../components/ads/AdInContent.astro';
import { calculadoras } from '../../lib/calcData';
import { getCalcsForText } from '../../lib/related';
import { organizationSchema, websiteSchema, ORGANIZATION_ID, WEBSITE_ID, SITE_URL } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => e.data.publicado !== false);
  return posts.map((p) => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const post = await getEntry('blog', slug as string);

if (!post || post.data.publicado === false) return Astro.redirect('/blog');

const { Content } = await render(post);

const categorias: Record<string, string> = {
  fitness:   'Fitness',
  nutricion: 'Nutrición',
  salud:     'Salud',
  guias:     'Guías',
  general:   'General',
};

const postUrl = `${SITE_URL}/blog/${post.id}`;

// Artículos relacionados: misma categoría primero, después el resto, y dentro
// de cada grupo los más recientes. Sin esto cada artículo era un callejón sin
// salida —sólo enlazaba a la home y al índice del blog— y los 70 artículos no
// se pasaban autoridad entre sí.
const allPosts = (await getCollection('blog', (e) => e.data.publicado !== false))
  .filter((p) => p.id !== post.id);
const relatedPosts = allPosts
  .map((p) => {
    const sharedKeywords = p.data.keywords.filter((k) =>
      post.data.keywords.some((own) => own.toLowerCase() === k.toLowerCase()),
    ).length;
    return {
      post: p,
      score: (p.data.categoria === post.data.categoria ? 10 : 0) + sharedKeywords * 3,
    };
  })
  .sort((a, b) => b.score - a.score || b.post.data.fecha.localeCompare(a.post.data.fecha))
  .slice(0, 3)
  .map((r) => r.post);

// Calculadoras de las que habla el artículo (enlazado blog → calculadora).
const relatedCalcs = getCalcsForText(
  `${post.data.titulo} ${post.data.descripcion ?? ''} ${post.data.keywords.join(' ')}`,
  3,
);

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    // Organization y WebSite se repiten aquí porque el prop `schema`
    // SUSTITUYE al @graph por defecto de Base.astro: sin ellos los 70
    // artículos quedaban sin esos nodos y con un publisher duplicado y sin
    // `@id`, que es el mismo fallo que ya se corrigió en las calculadoras.
    organizationSchema,
    websiteSchema,
    {
      '@type': 'Article',
      '@id': `${postUrl}#article`,
      headline: post.data.titulo,
      description: post.data.descripcion ?? '',
      inLanguage: 'es',
      isAccessibleForFree: true,
      articleSection: categorias[post.data.categoria] ?? post.data.categoria,
      author: { '@id': ORGANIZATION_ID },
      publisher: { '@id': ORGANIZATION_ID },
      isPartOf: { '@id': WEBSITE_ID },
      datePublished: post.data.fecha + 'T00:00:00Z',
      dateModified: (post.data.fechaModificada ?? post.data.fecha) + 'T00:00:00Z',
      url: postUrl,
      mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
      breadcrumb: { '@id': `${postUrl}#breadcrumb` },
      keywords: post.data.keywords.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${postUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
        { '@type': 'ListItem', position: 3, name: post.data.titulo, item: postUrl },
      ],
    },
  ],
};
---

<Base
  title={`${post.data.tituloSeo ?? post.data.titulo} — CalcFit`}
  description={post.data.descripcion ?? ''}
  keywords={post.data.keywords.join(', ')}
  schema={articleSchema}
  ogType="article"
>
  <Navbar />

  <!-- Header del artículo -->
  <div style="background:var(--ink); padding:40px 20px 32px; margin-top:56px;">
    <div style="max-width:720px; margin:0 auto;">
      <div style="display:flex; align-items:center; gap:6px; font-size:12px; color:#888; margin-bottom:20px; font-family:var(--font-mono); flex-wrap:wrap;">
        <a href="/" style="text-decoration:none; color:#888;">INICIO</a>
        <span>/</span>
        <a href="/blog" style="text-decoration:none; color:#888;">BLOG</a>
        <span>/</span>
        <span style="color:var(--acid); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:200px;">
          {post.data.titulo.toUpperCase()}
        </span>
      </div>

      {post.data.categoria && (
        <span style="display:inline-block; font-size:10px; font-weight:500; text-transform:uppercase; letter-spacing:0.08em; background:var(--acid); color:var(--ink); padding:3px 10px; font-family:var(--font-mono); margin-bottom:14px;">
          {categorias[post.data.categoria] ?? post.data.categoria}
        </span>
      )}

      <h1 style="font-family:var(--font-display); font-size:clamp(28px, 5vw, 52px); color:var(--cream); margin:0 0 14px; line-height:1.05; letter-spacing:0.3px;">
        {post.data.titulo.toUpperCase()}
      </h1>

      {post.data.descripcion && (
        <p style="font-size:15px; color:#aaa; line-height:1.65; margin:0 0 20px; font-family:var(--font-body);">
          {post.data.descripcion}
        </p>
      )}

      <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
        <span style="font-size:12px; color:#888; font-family:var(--font-mono);">
          {post.data.autor}
        </span>
      </div>
    </div>
  </div>

  <!-- Publicidad — cabecera -->
  <div style="background: var(--cream); border-bottom: 1px solid var(--border);">
    <AdSlot format="leaderboard" mobile="mobile" eager gap="14px" />
  </div>

  <!-- Contenido -->
  <div class="blog-shell">
  <main style="padding:32px 20px 60px; min-height:50vh;">
    <div class="prose">
      <Content />
    </div>

    <!-- Publicidad — final del artículo -->
    <AdSlot format="native" gap="36px" />

    <!-- Compartir -->
    <div style="margin-top:40px; padding-top:32px; border-top:1px solid var(--border);">
      <p style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted); margin:0 0 4px;">
        Compartir este artículo
      </p>
      <ShareButtons
        client:load
        text={`${post.data.titulo} — CalcFit`}
        url={`https://www.calcfit.com/blog/${post.id}`}
      />
    </div>

    <!-- Calculadoras que trata el artículo -->
    {relatedCalcs.length > 0 && (
      <section style="margin-top:32px; border-top:1px solid var(--border); padding-top:28px;">
        <p style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted); margin:0 0 14px;">
          Calcúlalo tú
        </p>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:10px;">
          {relatedCalcs.map(calc => (
            <a href={calc.slug} style="display:flex; align-items:flex-start; gap:10px; border:1px solid var(--border); padding:14px; text-decoration:none;">
              <span style="display:inline-flex; flex-shrink:0; width:28px; height:28px; align-items:center; justify-content:center; background:var(--ink); color:var(--acid);">
                <Fragment set:html={calc.icon} />
              </span>
              <span>
                <span style="display:block; font-size:13px; font-weight:600; color:var(--ink); line-height:1.3;">{calc.nombre}</span>
                <span style="display:block; font-size:11px; color:var(--muted); margin-top:3px; line-height:1.45;">{calc.desc}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- CTA calculadoras -->
    <div style="margin-top:32px; border:1px solid var(--ink); padding:24px;">
      <p style="font-family:var(--font-display); font-size:20px; color:var(--ink); margin:0 0 6px; letter-spacing:0.3px;">
        PRUEBA NUESTRAS CALCULADORAS
      </p>
      <p style="font-size:13px; color:var(--muted); line-height:1.55; margin:0 0 16px; font-family:var(--font-body);">
        {calculadoras.length} calculadoras de salud gratuitas, sin registro, validadas científicamente.
      </p>
      <a
        href="/"
        style="display:inline-flex; align-items:center; gap:8px; background:var(--acid); color:var(--ink); font-family:var(--font-mono); font-size:12px; font-weight:500; text-transform:uppercase; letter-spacing:0.06em; padding:12px 20px; text-decoration:none; transition:opacity 0.15s;"
        onmouseover="this.style.opacity='0.85'"
        onmouseout="this.style.opacity='1'"
      >
        Ver todas las calculadoras
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- Seguir leyendo -->
    {relatedPosts.length > 0 && (
      <section style="margin-top:32px; border-top:1px solid var(--border); padding-top:28px;">
        <p style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted); margin:0 0 14px;">
          Seguir leyendo
        </p>
        <div style="display:flex; flex-direction:column;">
          {relatedPosts.map(p => (
            <a href={`/blog/${p.id}`} style="display:block; padding:14px 0; border-bottom:1px solid var(--border); text-decoration:none;">
              <span style="display:block; font-size:14px; font-weight:600; color:var(--ink); line-height:1.4;">{p.data.titulo}</span>
              {p.data.descripcion && (
                <span style="display:block; font-size:12px; color:var(--muted); margin-top:4px; line-height:1.55;">{p.data.descripcion}</span>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    <AdSlot format="banner" mobile="mobile" gap="32px" />

    <!-- Volver -->
    <div style="margin-top:20px;">
      <a
        href="/blog"
        style="display:inline-flex; align-items:center; gap:6px; font-size:12px; color:var(--muted); text-decoration:none; font-family:var(--font-mono); text-transform:uppercase; letter-spacing:0.05em;"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Volver al blog
      </a>
    </div>
  </main>
  <AdRail from={1100} />
  </div>

  <!-- Anuncio dentro del texto: antes del 3.er H2 del artículo -->
  <AdInContent target=".prose" after={2} />

  <Footer />
</Base>

<style is:global>
  .blog-shell { position: relative; max-width: 720px; margin: 0 auto; }
  .prose h2 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--ink);
    margin: 2rem 0 0.75rem;
    letter-spacing: 0.3px;
    line-height: 1.1;
  }
  .prose h3 {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    margin: 1.5rem 0 0.5rem;
  }
  .prose p {
    font-family: var(--font-body);
    font-size: 15px;
    color: #3a3830;
    line-height: 1.75;
    margin: 0 0 1rem;
  }
  .prose ul, .prose ol {
    font-family: var(--font-body);
    font-size: 15px;
    color: #3a3830;
    line-height: 1.75;
    padding-left: 1.4rem;
    margin: 0 0 1rem;
  }
  .prose li { margin-bottom: 0.35rem; }
  .prose strong { color: var(--ink); font-weight: 600; }
  .prose a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--acid);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    transition: color 0.15s;
  }
  .prose a:hover { color: #555; }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 14px;
    font-family: var(--font-body);
  }
  .prose th {
    background: var(--ink);
    color: var(--acid);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 8px 12px;
    text-align: left;
  }
  .prose td {
    border-bottom: 1px solid var(--border);
    padding: 8px 12px;
    color: #3a3830;
  }
  .prose hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
</style>
