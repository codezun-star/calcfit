---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPathsOptions, Page } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const todos = await getCollection('blog', (e) => e.data.publicado !== false);
  const sorted = todos.sort((a, b) => b.data.fecha.localeCompare(a.data.fecha));
  return paginate(sorted, { pageSize: 20 });
}

const { page } = Astro.props as { page: Page<CollectionEntry<'blog'>> };

function thumbUrl(url: string): string {
  return url.replace(/&w=\d+/, '&w=400').replace(/&h=\d+/, '&h=267');
}

const categorias: Record<string, string> = {
  fitness:  'Fitness',
  nutricion: 'Nutrición',
  salud:    'Salud',
  guias:    'Guías',
  general:  'General',
};

const titleSuffix = page.currentPage > 1 ? ` — Página ${page.currentPage}` : '';
---

<Base
  title={`Blog de Fitness y Nutrición — Artículos con Evidencia Científica${titleSuffix} | CalcFit`}
  description="Artículos sobre fitness, nutrición y salud respaldados por evidencia científica. Aprende a calcular calorías, perder grasa, mejorar tu rendimiento y más."
>
  <Navbar />

  <!-- Header -->
  <div style="background:var(--ink); padding:40px 20px 32px; margin-top:56px;">
    <div style="max-width:1000px; margin:0 auto;">
      <div style="display:flex; align-items:center; gap:6px; font-size:12px; color:#888; margin-bottom:16px; font-family:var(--font-mono);">
        <a href="/" style="text-decoration:none; color:#888;">INICIO</a>
        <span>/</span>
        <span style="color:var(--acid);">BLOG</span>
      </div>
      <h1 style="font-family:var(--font-display); font-size:clamp(36px, 6vw, 60px); color:var(--cream); margin:0 0 8px; letter-spacing:0.5px; line-height:1;">
        BLOG
      </h1>
      <p style="font-size:15px; color:#888; line-height:1.6; max-width:480px; margin:0; font-family:var(--font-body);">
        Artículos sobre fitness, nutrición y salud respaldados por evidencia científica.
      </p>
    </div>
  </div>

  <!-- Lista -->
  <main style="max-width:1000px; margin:0 auto; padding:40px 20px 80px; min-height:60vh;">
    {page.data.length === 0 ? (
      <div style="text-align:center; padding:80px 20px;">
        <p style="font-size:15px; color:var(--muted); font-family:var(--font-body);">No hay artículos publicados aún.</p>
      </div>
    ) : (
      <>
        <div style="display:flex; flex-direction:column; gap:1px; background:var(--border);">
          {page.data.map((art: any) => (
            <a
              href={`/blog/${art.id}`}
              style="display:flex; align-items:flex-start; gap:0; background:var(--cream); text-decoration:none; border-left:3px solid transparent; transition:background 0.15s, border-color 0.15s; overflow:hidden;"
              onmouseover="this.style.background='#EDE9DF'; this.style.borderLeftColor='var(--acid)'"
              onmouseout="this.style.background='var(--cream)'; this.style.borderLeftColor='transparent'"
            >
              {art.data.imagen && (
                <div class="blog-thumb" style="flex-shrink:0; width:160px; min-height:107px; overflow:hidden;">
                  <img
                    src={thumbUrl(art.data.imagen)}
                    alt={art.data.titulo}
                    width="160"
                    height="107"
                    loading="lazy"
                    style="width:160px; height:107px; object-fit:cover; display:block;"
                    onerror="this.closest('.blog-thumb').style.display='none'"
                  />
                </div>
              )}
              <div style="flex:1; min-width:0; padding:18px 16px 18px 20px;">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px; flex-wrap:wrap;">
                  {art.data.categoria && (
                    <span style="font-size:10px; font-weight:500; text-transform:uppercase; letter-spacing:0.08em; background:var(--ink); color:var(--acid); padding:2px 8px; font-family:var(--font-mono);">
                      {categorias[art.data.categoria] ?? art.data.categoria}
                    </span>
                  )}
                </div>
                <p style="font-size:16px; font-weight:600; color:var(--ink); margin:0 0 6px; line-height:1.3; font-family:var(--font-body);">
                  {art.data.titulo}
                </p>
                {art.data.descripcion && (
                  <p style="font-size:13px; color:var(--muted); margin:0; line-height:1.6; font-family:var(--font-body); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                    {art.data.descripcion}
                  </p>
                )}
              </div>
              <div style="padding:18px 16px 0 0; flex-shrink:0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          ))}
        </div>

        <!-- Paginación -->
        {page.lastPage > 1 && (
          <nav style="display:flex; align-items:center; justify-content:space-between; margin-top:40px; gap:12px; flex-wrap:wrap;">
            <!-- Prev -->
            <div style="flex:1; display:flex; justify-content:flex-start;">
              {page.url.prev ? (
                <a
                  href={page.url.prev}
                  style="display:inline-flex; align-items:center; gap:8px; font-size:13px; font-family:var(--font-mono); color:var(--ink); text-decoration:none; border:1px solid var(--border); padding:8px 16px; background:var(--cream); transition:border-color 0.15s;"
                  onmouseover="this.style.borderColor='var(--ink)'"
                  onmouseout="this.style.borderColor='var(--border)'"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                  </svg>
                  ANTERIOR
                </a>
              ) : (
                <span style="display:inline-flex; align-items:center; gap:8px; font-size:13px; font-family:var(--font-mono); color:var(--border); border:1px solid var(--border); padding:8px 16px; cursor:default;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                  </svg>
                  ANTERIOR
                </span>
              )}
            </div>

            <!-- Números de página -->
            <div style="display:flex; align-items:center; gap:4px; flex-wrap:wrap; justify-content:center;">
              {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => (
                <a
                  href={n === 1 ? '/blog' : `/blog/${n}`}
                  style={`display:inline-flex; align-items:center; justify-content:center; width:36px; height:36px; font-size:13px; font-family:var(--font-mono); text-decoration:none; border:1px solid ${n === page.currentPage ? 'var(--ink)' : 'var(--border)'}; background:${n === page.currentPage ? 'var(--ink)' : 'var(--cream)'}; color:${n === page.currentPage ? 'var(--acid)' : 'var(--muted)'}; font-weight:${n === page.currentPage ? '600' : '400'};`}
                  aria-current={n === page.currentPage ? 'page' : undefined}
                  onmouseover={n !== page.currentPage ? "this.style.borderColor='var(--ink)'; this.style.color='var(--ink)'" : undefined}
                  onmouseout={n !== page.currentPage ? "this.style.borderColor='var(--border)'; this.style.color='var(--muted)'" : undefined}
                >
                  {n}
                </a>
              ))}
            </div>

            <!-- Next -->
            <div style="flex:1; display:flex; justify-content:flex-end;">
              {page.url.next ? (
                <a
                  href={page.url.next}
                  style="display:inline-flex; align-items:center; gap:8px; font-size:13px; font-family:var(--font-mono); color:var(--ink); text-decoration:none; border:1px solid var(--border); padding:8px 16px; background:var(--cream); transition:border-color 0.15s;"
                  onmouseover="this.style.borderColor='var(--ink)'"
                  onmouseout="this.style.borderColor='var(--border)'"
                >
                  SIGUIENTE
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              ) : (
                <span style="display:inline-flex; align-items:center; gap:8px; font-size:13px; font-family:var(--font-mono); color:var(--border); border:1px solid var(--border); padding:8px 16px; cursor:default;">
                  SIGUIENTE
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              )}
            </div>
          </nav>
        )}
      </>
    )}
  </main>

  <Footer />
</Base>

<style>
  @media (max-width: 480px) {
    .blog-thumb { display: none !important; }
  }
</style>
