---
import Base from './Base.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { calculadoras, categorias } from '../lib/calcData';
import { organizationSchema, websiteSchema, ORGANIZATION_ID, WEBSITE_ID, SITE_DATE_MODIFIED } from '../lib/schema';
import AdSlot from '../components/ads/AdSlot.astro';
import AdRail from '../components/ads/AdRail.astro';
import AdInContent from '../components/ads/AdInContent.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schema?: object;
  calculatorName: string;
  breadcrumbSlug: string;
  keywords?: string;
  faqs?: Array<{ q: string; a: string }>;
  dateModified?: string;
  related?: string[];
  /** Pasos propios para el schema HowTo. Si se omite se generan los del patrón estándar. */
  howTo?: string[];
  /** Respuesta directa de 1-2 frases para el bloque "En resumen". Por defecto usa `description`. */
  answer?: string;
}

const {
  title,
  description,
  ogImage,
  schema,
  calculatorName,
  breadcrumbSlug,
  keywords,
  faqs,
  dateModified = SITE_DATE_MODIFIED,
  related = [],
  howTo,
  answer,
} = Astro.props;

// Respuesta directa: primer bloque de la zona de contenido, extractable por
// buscadores y motores de respuesta sin ejecutar JavaScript.
const directAnswer = answer ?? description;
const fechaRevision = new Date(`${dateModified}T00:00:00Z`).toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

// Calculadoras relacionadas (enlazado interno) — datos desde calcData.ts
const relatedCalcs = related
  .map((slug) => calculadoras.find((c) => c.slug === `/${slug}`))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const pageUrl = `https://www.calcfit.com/${breadcrumbSlug}`;

const medicalContent = schema ?? {
  '@type': 'MedicalWebContent',
  '@id': `${pageUrl}#content`,
  name: calculatorName,
  description,
  url: pageUrl,
  inLanguage: 'es',
  audience: { '@type': 'Patient' },
  lastReviewed: dateModified,
  dateModified,
  isAccessibleForFree: true,
  isPartOf: { '@id': WEBSITE_ID },
  breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
  // Bloques que un asistente de voz o un motor de respuesta puede leer literalmente
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.aeo-answer'],
  },
  publisher: { '@id': ORGANIZATION_ID },
};

// HowTo — pasos reales de uso de cualquier calculadora del sitio
const howToSteps = howTo ?? [
  'Introduce tus datos en el formulario (si la calculadora usa peso o altura puedes alternar entre kg · cm y lb · pies).',
  'Pulsa el botón de calcular para obtener el resultado al instante.',
  'Consulta la interpretación del resultado y la tabla de rangos de referencia de esta misma página.',
];

const howToSchema = {
  '@type': 'HowTo',
  '@id': `${pageUrl}#howto`,
  name: `Cómo usar la ${calculatorName}`,
  description: `Pasos para calcular con la ${calculatorName} de CalcFit, gratis y sin registro.`,
  inLanguage: 'es',
  totalTime: 'PT1M',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
  step: howToSteps.map((text, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: `Paso ${i + 1}`,
    text,
    url: `${pageUrl}#paso-${i + 1}`,
  })),
};

// Categoría de la calculadora (para breadcrumb de 3 niveles)
const cat = categorias.find((c) => c.slugs.includes(`/${breadcrumbSlug}`));
const categoryName = cat?.label ?? null;
const categoryUrl = cat ? `https://www.calcfit.com/${cat.slug}` : null;

const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.calcfit.com' },
];
if (categoryName && categoryUrl) {
  breadcrumbItems.push({ '@type': 'ListItem', position: 2, name: categoryName, item: categoryUrl });
}
breadcrumbItems.push({ '@type': 'ListItem', position: breadcrumbItems.length + 1, name: calculatorName, item: pageUrl });
const breadcrumbSchema = { '@type': 'BreadcrumbList', '@id': `${pageUrl}#breadcrumb`, itemListElement: breadcrumbItems };

const faqSchema = faqs && faqs.length > 0
  ? {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      inLanguage: 'es',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    }
  : null;

// Organization y WebSite se repiten en cada página para que las referencias por
// `@id` del resto del @graph resuelvan sin depender del rastreo de la home.
const graphItems = [
  organizationSchema,
  websiteSchema,
  medicalContent,
  breadcrumbSchema,
  howToSchema,
  ...(faqSchema ? [faqSchema] : []),
];
const combinedSchema = { '@context': 'https://schema.org', '@graph': graphItems };
---

<Base title={title} description={description} keywords={keywords} ogImage={ogImage} schema={combinedSchema}>
  <Navbar />
  <div style="height: 56px;"></div>

  <!-- Breadcrumb -->
  <div class="breadcrumb" style="background: var(--cream); border-bottom: 1px solid var(--border);">
    <span style="font-family: var(--font-mono); font-size: 10px; color: var(--muted);">
      <a href="/" style="color: var(--muted); text-decoration: none;">Inicio</a>
      <span style="margin: 0 6px;">→</span>
      {categoryName && categoryUrl && (
        <>
          <a href={categoryUrl} style="color: var(--muted); text-decoration: none;">{categoryName}</a>
          <span style="margin: 0 6px;">→</span>
        </>
      )}
      <span style="color: var(--ink);">{calculatorName}</span>
    </span>
  </div>

  <!-- Publicidad — cabecera -->
  <div style="background: var(--cream); border-bottom: 1px solid var(--border);">
    <AdSlot format="leaderboard" mobile="mobile" eager gap="14px" />
  </div>

  <!-- Main calculator slot -->
  <main class="calc-main" style="min-height: calc(100vh - 200px);">
    <slot />
  </main>

  <!-- Publicidad — bajo el resultado, el punto de mayor atención de la página -->
  <div style="background: var(--cream); max-width: 860px; margin: 0 auto; padding: 0 32px;">
    <AdSlot format="native" gap="8px" />
  </div>

  <!-- SEO content slot (server rendered) -->
  <div class="seo-outer" style="background: var(--cream); border-top: 1px solid var(--border);">
   <div class="seo-shell">
    <div class="seo-section">
      <!-- Respuesta directa — primer bloque que lee un motor de respuesta -->
      <div style="border-left: 2px solid var(--acid); padding: 4px 0 4px 16px; margin-bottom: 32px;">
        <p style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin-bottom: 8px;">En resumen</p>
        <p class="aeo-answer" style="font-size: 15px; line-height: 1.7; color: var(--ink);">{directAnswer}</p>
        <p style="font-size: 12px; color: var(--muted); margin-top: 10px;">
          Cálculo gratuito, sin registro y realizado en tu navegador · Revisado el <time datetime={dateModified}>{fechaRevision}</time>
        </p>
      </div>

      <div class="seo-body"><slot name="seo" /></div>

      <AdSlot format="banner" mobile="mobile" gap="36px" />
    </div>
    <AdRail />
   </div>
  </div>

  <!-- Anuncio dentro del texto: se inserta antes del 2.º H2 de la zona SEO -->
  <AdInContent target=".seo-body" after={1} />

  <!-- Calculadoras relacionadas (server rendered) -->
  {relatedCalcs.length > 0 && (
    <section class="related-section" style="background: var(--ink);">
      <p style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #888; margin-bottom: 20px;">Calculadoras relacionadas</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
        {relatedCalcs.map((c) => (
          <a href={c.slug} style="display: block; border: 1px solid var(--ink-3); border-radius: 2px; padding: 16px; text-decoration: none;">
            <span style="display: inline-flex; color: var(--acid); margin-bottom: 10px;"><Fragment set:html={c.icon} /></span>
            <span style="display: block; font-family: var(--font-display); font-size: 20px; color: white; line-height: 1;">{c.nombre}</span>
            <span style="display: block; font-size: 12px; color: #999; margin-top: 6px; line-height: 1.5;">{c.desc}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <Footer />
</Base>

<style>
  .breadcrumb  { padding: 10px 32px; }
  .seo-shell   { display: flex; gap: 24px; align-items: flex-start; max-width: 1064px; margin: 0 auto; }
  .seo-section { padding: 48px 32px; flex: 1 1 auto; min-width: 0; max-width: 860px; margin: 0 auto; }
  .related-section { padding: 40px 32px; }
  @media (max-width: 640px) {
    .breadcrumb  { padding: 10px 16px; }
    .seo-section { padding: 32px 16px; }
    .related-section { padding: 32px 16px; }
    :global(.calc-main > div:first-child) {
      padding-left: 16px !important;
      padding-right: 16px !important;
    }
  }
</style>
