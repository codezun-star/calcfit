---
import Base from './Base.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { calculadoras, categorias } from '../lib/calcData';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schema?: object;
  calculatorName: string;
  breadcrumbSlug: string;
  keywords?: string;
  faqs?: Array<{ q: string; a: string }>;
  dateModified?: string;
  related?: string[];
}

const {
  title,
  description,
  ogImage,
  schema,
  calculatorName,
  breadcrumbSlug,
  keywords,
  faqs,
  dateModified = '2026-05-16',
  related = [],
} = Astro.props;

// Calculadoras relacionadas (enlazado interno) — datos desde calcData.ts
const relatedCalcs = related
  .map((slug) => calculadoras.find((c) => c.slug === `/${slug}`))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const pageUrl = `https://www.calcfit.com/${breadcrumbSlug}`;

const medicalContent = schema ?? {
  '@type': 'MedicalWebContent',
  name: calculatorName,
  description,
  url: pageUrl,
  inLanguage: 'es',
  audience: { '@type': 'Patient' },
  lastReviewed: dateModified,
  dateModified,
  publisher: {
    '@type': 'Organization',
    name: 'CalcFit',
    url: 'https://www.calcfit.com',
  },
};

// Categoría de la calculadora (para breadcrumb de 3 niveles)
const cat = categorias.find((c) => c.slugs.includes(`/${breadcrumbSlug}`));
const categoryName = cat?.label ?? null;
const categoryUrl = cat ? `https://www.calcfit.com/${cat.slug}` : null;

const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.calcfit.com' },
];
if (categoryName && categoryUrl) {
  breadcrumbItems.push({ '@type': 'ListItem', position: 2, name: categoryName, item: categoryUrl });
}
breadcrumbItems.push({ '@type': 'ListItem', position: breadcrumbItems.length + 1, name: calculatorName, item: pageUrl });
const breadcrumbSchema = { '@type': 'BreadcrumbList', itemListElement: breadcrumbItems };

const faqSchema = faqs && faqs.length > 0
  ? {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    }
  : null;

const graphItems = [medicalContent, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
const combinedSchema = { '@context': 'https://schema.org', '@graph': graphItems };
---

<Base title={title} description={description} keywords={keywords} ogImage={ogImage} schema={combinedSchema}>
  <Navbar />
  <div style="height: 56px;"></div>

  <!-- Breadcrumb -->
  <div class="breadcrumb" style="background: var(--cream); border-bottom: 1px solid var(--border);">
    <span style="font-family: var(--font-mono); font-size: 10px; color: var(--muted);">
      <a href="/" style="color: var(--muted); text-decoration: none;">Inicio</a>
      <span style="margin: 0 6px;">→</span>
      {categoryName && categoryUrl && (
        <>
          <a href={categoryUrl} style="color: var(--muted); text-decoration: none;">{categoryName}</a>
          <span style="margin: 0 6px;">→</span>
        </>
      )}
      <span style="color: var(--ink);">{calculatorName}</span>
    </span>
  </div>

  <!-- Main calculator slot -->
  <main class="calc-main" style="min-height: calc(100vh - 200px);">
    <slot />
  </main>

  <!-- SEO content slot (server rendered) -->
  <div class="seo-section" style="background: var(--cream); border-top: 1px solid var(--border); max-width: 860px; margin: 0 auto;">
    <slot name="seo" />
  </div>

  <!-- Calculadoras relacionadas (server rendered) -->
  {relatedCalcs.length > 0 && (
    <section class="related-section" style="background: var(--ink);">
      <p style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #888; margin-bottom: 20px;">Calculadoras relacionadas</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
        {relatedCalcs.map((c) => (
          <a href={c.slug} style="display: block; border: 1px solid var(--ink-3); border-radius: 2px; padding: 16px; text-decoration: none;">
            <span style="display: inline-flex; color: var(--acid); margin-bottom: 10px;"><Fragment set:html={c.icon} /></span>
            <span style="display: block; font-family: var(--font-display); font-size: 20px; color: white; line-height: 1;">{c.nombre}</span>
            <span style="display: block; font-size: 12px; color: #999; margin-top: 6px; line-height: 1.5;">{c.desc}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <Footer />
</Base>

<style>
  .breadcrumb  { padding: 10px 32px; }
  .seo-section { padding: 48px 32px; }
  .related-section { padding: 40px 32px; }
  @media (max-width: 640px) {
    .breadcrumb  { padding: 10px 16px; }
    .seo-section { padding: 32px 16px; }
    .related-section { padding: 32px 16px; }
    :global(.calc-main > div:first-child) {
      padding-left: 16px !important;
      padding-right: 16px !important;
    }
  }
</style>
