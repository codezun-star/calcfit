---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  schema?: object;
}

const {
  title,
  description,
  keywords,
  ogImage = '/og/default.jpg',
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'CalcFit',
      url: 'https://www.calcfit.com',
      description: 'Calculadoras de salud gratuitas y validadas científicamente para toda Latinoamérica',
      inLanguage: 'es',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: 'https://www.calcfit.com/?q={search_term_string}' },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      name: 'CalcFit',
      url: 'https://www.calcfit.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.calcfit.com/favicon.svg',
        width: 32,
        height: 32,
      },
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'codezun@gmail.com',
        contactType: 'customer support',
        availableLanguage: 'Spanish',
      },
      sameAs: ['https://github.com/codezun-star/calcfit'],
      description: 'Calculadoras de salud gratuitas, validadas científicamente',
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0F0E0D" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="CalcFit" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="google-adsense-account" content="ca-pub-7534323109643359">

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_419" />
    <meta property="og:locale:alternate" content="es_ES" />
    <meta property="og:locale:alternate" content="es_MX" />
    <meta property="og:locale:alternate" content="es_AR" />
    <meta property="og:site_name" content="CalcFit" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:site" content="@calcfit" />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema ?? websiteSchema)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Google AdSense -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7534323109643359" crossorigin="anonymous"></script>

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NRM0FZ5W8S"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NRM0FZ5W8S');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
