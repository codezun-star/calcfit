---
import '../styles/global.css';
import { organizationSchema, websiteSchema as siteNode } from '../lib/schema';
import { jsonLd } from '../lib/jsonld';
import AdEngine from '../components/ads/AdEngine.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  schema?: object;
  /** Monetización: `false` deja la página sin publicidad (páginas legales) */
  ads?: boolean;
  /** Barra publicitaria inferior fija */
  anchorAd?: boolean;
}

const {
  title,
  description,
  keywords,
  ogImage = '/og/default.jpg',
  ogType = 'website',
  schema,
  ads = true,
  anchorAd = true,
} = Astro.props;

// Con build.format: 'file' el pathname en build lleva extensión (.html) — la URL pública no
const cleanPathname = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonicalURL = new URL(cleanPathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [siteNode, organizationSchema],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0F0E0D" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="CalcFit" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="text/plain" href="https://www.calcfit.com/llms.txt" title="Índice para motores de respuesta (llms.txt)" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_419" />
    <meta property="og:locale:alternate" content="es_ES" />
    <meta property="og:locale:alternate" content="es_MX" />
    <meta property="og:locale:alternate" content="es_AR" />
    <meta property="og:site_name" content="CalcFit" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={jsonLd(schema ?? websiteSchema)} />

    {ads && (
      <>
        <link rel="preconnect" href="https://www.highrevenueformat.com" crossorigin />
        <link rel="dns-prefetch" href="https://www.highrevenueformat.com" />
        <link rel="dns-prefetch" href="https://pl31073381.profitableratecpmnetwork.com" />
        <link rel="dns-prefetch" href="https://pl31073382.profitableratecpmnetwork.com" />
      </>
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NRM0FZ5W8S"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NRM0FZ5W8S');
    </script>
  </head>
  <body>
    <slot />
    {ads && <AdEngine anchor={anchorAd} />}
  </body>
</html>
