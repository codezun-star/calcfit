  <button type="button" class:list={['tab', active === 'menu' && 'is-active']} data-sheet-open="menu" aria-haspopup="dialog" aria-expanded="false">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" /></svg>
    <span>Menú</span>
  </button>
</nav>

<!-- Hoja: categorías -->
<dialog class="sheet" id="sheet-calcs" aria-labelledby="sheet-calcs-title">
  <div class="sheet__head" data-sheet-drag>
    <span class="sheet__grip" aria-hidden="true"></span>
    <p class="sheet__title" id="sheet-calcs-title">Categorías</p>
    <button type="button" class="sheet__close" data-sheet-close aria-label="Cerrar"><Fragment set:html={closeIcon} /></button>
  </div>
  <div class="sheet__body">
    <ul class="sheet-list">
      {cats.map((c) => (
        <li>
          <a href={c.href} class="sheet-row">
            <span class="sheet-row__icon"><Fragment set:html={c.icon} /></span>
            <span class="sheet-row__text">
              <span class="sheet-row__label">{c.label}</span>
              <span class="sheet-row__sub">{c.count} calculadoras</span>
            </span>
            <span class="sheet-row__chev"><Fragment set:html={chevron} /></span>
          </a>
        </li>
      ))}
    </ul>

    <p class="sheet__section">Más usadas</p>
    <div class="sheet-chips">
      {populares.map((c) => (
        <a href={c.slug} class="sheet-chip">
          <Fragment set:html={c.icon} />
          <span>{c.nombre}</span>
        </a>
      ))}
    </div>

    <a href="/#calculadoras" class="sheet__all">Ver las {total} calculadoras</a>
  </div>
</dialog>

