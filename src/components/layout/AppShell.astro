---
/**
 * Capa de "app nativa" para móvil (≤767px). Se incluye una vez por página
 * desde `Base.astro`:
 *
 * - Barra de pestañas inferior fija: Inicio · Categorías · Buscar · Blog · Menú.
 * - Tres hojas (`<dialog>` modal, capa superior del navegador): categorías,
 *   menú y buscador a pantalla completa. Se cierran con el botón, tocando el
 *   fondo, deslizando hacia abajo, con Escape o con el gesto «atrás» de Android.
 *
 * El buscador también funciona en escritorio (lo abre la lupa de la Navbar)
 * y atiende `?q=` para el SearchAction del schema de la home. Su índice
 * (`/search.json`) se pide la primera vez que se abre: no pesa en la página.
 *
 * Todo el contenido de las hojas se renderiza en el servidor: son enlaces
 * rastreables y funcionan aunque el JavaScript tarde en llegar.
 */
import { calculadoras, categorias } from '../../lib/calcData';

export type AppSection = 'inicio' | 'categorias' | 'blog' | 'menu' | null;

interface Props {
  /** Pestaña resaltada */
  active?: AppSection;
}

const { active = null } = Astro.props;

const bySlug = new Map(calculadoras.map((c) => [c.slug, c]));

// Icono de cada categoría: el de su calculadora más representativa
const CAT_ICON: Record<string, string> = {
  fitness: '/frecuencia-cardiaca',
  embarazo: '/semana-embarazo',
  fechas: '/edad',
  nutricion: '/macronutrientes',
};
const cats = categorias.map((c) => ({
  label: c.label,
  href: `/${c.slug}`,
  count: c.slugs.length,
  icon: bySlug.get(CAT_ICON[c.slug] ?? '')?.icon ?? '',
}));

// Accesos rápidos: las calculadoras con más demanda del sitio
const POPULARES = [
  '/imc',
  '/calorias-diarias',
  '/grasa-corporal',
  '/peso-ideal',
  '/deficit-calorico',
  '/frecuencia-cardiaca',
  '/fecha-parto',
  '/ovulacion',
];
const populares = POPULARES.map((s) => bySlug.get(s)).filter((c): c is NonNullable<typeof c> => Boolean(c));

const total = calculadoras.length;

const chevron = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true"><polyline points="6,3 11,8 6,13"/></svg>';
const closeIcon = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true"><line x1="4" y1="4" x2="14" y2="14"/><line x1="14" y1="4" x2="4" y2="14"/></svg>';
---

<!-- Barra de pestañas (sólo móvil) -->
<nav class="tabbar" aria-label="Navegación de la app">
  <a href="/" class:list={['tab', active === 'inicio' && 'is-active']} aria-current={active === 'inicio' ? 'page' : undefined}>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="miter" aria-hidden="true"><path d="M3.5 10.5 12 3.5l8.5 7v10h-6v-6h-5v6h-6z" /></svg>
    <span>Inicio</span>
  </a>
  <button type="button" class:list={['tab', active === 'categorias' && 'is-active']} data-sheet-open="calcs" aria-haspopup="dialog" aria-expanded="false">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" /><rect x="13.5" y="3.5" width="7" height="7" /><rect x="3.5" y="13.5" width="7" height="7" /><rect x="13.5" y="13.5" width="7" height="7" /></svg>
    <span>Categorías</span>
  </button>
  <button type="button" class="tab" data-sheet-open="search" aria-haspopup="dialog" aria-expanded="false">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><line x1="15.5" y1="15.5" x2="20.5" y2="20.5" /></svg>
    <span>Buscar</span>
  </button>
  <a href="/blog" class:list={['tab', active === 'blog' && 'is-active']} aria-current={active === 'blog' ? 'page' : undefined}>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true"><path d="M5.5 3.5h9l4 4v13h-13z" /><line x1="9" y1="11.5" x2="15" y2="11.5" /><line x1="9" y1="15.5" x2="15" y2="15.5" /></svg>
    <span>Blog</span>
