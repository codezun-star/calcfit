<!-- Buscador: pantalla completa en móvil, panel centrado en escritorio -->
<dialog class="search" id="sheet-search" aria-label="Buscar calculadora">
  <form class="search__bar" role="search" data-search-form>
    <label class="search__field">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.75" /><line x1="12.8" y1="12.8" x2="17.5" y2="17.5" /></svg>
      <input
        type="search"
        name="q"
        class="search__input"
        placeholder={`Buscar entre ${total} calculadoras`}
        aria-label="Buscar calculadora o artículo"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        data-search-input
      />
      <button type="button" class="search__clear" data-search-clear aria-label="Borrar búsqueda" hidden><Fragment set:html={closeIcon} /></button>
    </label>
    <button type="button" class="search__cancel" data-sheet-close>Cancelar</button>
  </form>

  <div class="search__body" data-search-body>
    <div data-search-empty>
      <p class="search__section">Más usadas</p>
      <ul class="search-list">
        {populares.map((c) => (
          <li>
            <a href={c.slug} class="search-row">
              <span class="search-row__icon"><Fragment set:html={c.icon} /></span>
              <span class="search-row__text">
                <span class="search-row__name">{c.nombre}</span>
                <span class="search-row__meta">{c.desc}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="search__section">Categorías</p>
      <div class="search-cats">
        {cats.map((c) => <a href={c.href} class="search-cat">{c.label}</a>)}
      </div>
    </div>
    <ul class="search-list" data-search-results hidden></ul>
    <p class="search__none" data-search-none hidden></p>
    <p class="cf-sr-only" aria-live="polite" data-search-status></p>
  </div>
</dialog>

<script>
  type SheetName = 'calcs' | 'menu' | 'search';

  interface SearchData {
    i: string[];
    c: [string, string, string, string, number][];
    b: [string, string, string][];
  }

  interface Entry {
    url: string;
    name: string;
    meta: string;
    icon: string;
    /** Nombre normalizado (sin tildes, minúsculas) */
    nn: string;
    /** Todo el texto buscable, normalizado */
    hay: string;
    blog: boolean;
  }

  interface BeforeInstallPromptEvent extends Event {
    prompt(): Promise<void>;
    userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>;
  }

  const html = document.documentElement;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const CLOSE_MS = 240;

  const dialogOf = (name: string) => document.getElementById(`sheet-${name}`) as HTMLDialogElement | null;
  const allDialogs = () => document.querySelectorAll<HTMLDialogElement>('dialog.sheet, dialog.search');

  function setExpanded(name: string, value: boolean): void {
    document
      .querySelectorAll(`[data-sheet-open="${name}"]`)
      .forEach((el) => el.setAttribute('aria-expanded', String(value)));
  }

  /* ── Abrir y cerrar ─────────────────────────────────────────────── */

  /** Cierres animados pendientes: si la hoja se reabre, se cancelan */
  const pendingClose = new WeakMap<HTMLDialogElement, () => void>();

  function finishClose(dlg: HTMLDialogElement): void {
    pendingClose.get(dlg)?.();
    dlg.classList.remove('is-closing');
    dlg.style.transform = '';
    if (dlg.open) dlg.close();
  }

  function closeSheet(dlg: HTMLDialogElement): void {
    if (!dlg.open || dlg.classList.contains('is-closing')) return;
    if (reducedMotion.matches) {
      finishClose(dlg);
      return;
    }
    dlg.classList.add('is-closing');
    const onEnd = (e: AnimationEvent) => {
      if (e.target === dlg) finishClose(dlg);
    };
    const timer = window.setTimeout(() => finishClose(dlg), CLOSE_MS + 80);
    dlg.addEventListener('animationend', onEnd);
    pendingClose.set(dlg, () => {
      window.clearTimeout(timer);
      dlg.removeEventListener('animationend', onEnd);
      pendingClose.delete(dlg);
    });
  }

  function openSheet(name: SheetName): void {
    const dlg = dialogOf(name);
    if (!dlg || typeof dlg.showModal !== 'function') {
      // Navegador sin <dialog>: la home tiene el listado completo
      if (name !== 'menu') location.href = '/#calculadoras';
      return;
    }
    allDialogs().forEach((d) => {
      if (d !== dlg && d.open) finishClose(d);
    });
    pendingClose.get(dlg)?.();
    dlg.classList.remove('is-closing');
    dlg.style.transform = '';
    if (!dlg.open) dlg.showModal();
    html.classList.add('sheet-lock');
    setExpanded(name, true);
    if (name === 'search') {
      // En el mismo gesto del usuario: así iOS sí despliega el teclado
      searchInput?.focus();
      loadIndex().catch(() => undefined);
    }
  }

  allDialogs().forEach((dlg) => {
    const name = dlg.id.replace('sheet-', '');
    dlg.addEventListener('close', () => {
      setExpanded(name, false);
      if (!document.querySelector('dialog.sheet[open], dialog.search[open]')) html.classList.remove('sheet-lock');
    });
    // Escape y el gesto «atrás» de Android: cierre animado si se puede
    dlg.addEventListener('cancel', (e) => {
      if (!e.cancelable) return;
      e.preventDefault();
      closeSheet(dlg);
    });
    // Toque en el fondo oscuro
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) closeSheet(dlg);
    });
    // Enlace a la misma página (p. ej. /#calculadoras desde la home): cerrar ya
    dlg.addEventListener('click', (e) => {
      const link = (e.target as Element).closest('a');
      if (link && link.pathname === location.pathname && link.origin === location.origin) finishClose(dlg);
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    const opener = target.closest<HTMLElement>('[data-sheet-open]');
    if (opener) {
      e.preventDefault();
      openSheet(opener.dataset.sheetOpen as SheetName);
      return;
    }
    const closer = target.closest<HTMLElement>('[data-sheet-close]');
    const dlg = closer?.closest('dialog');
    if (dlg) closeSheet(dlg);
  });

  // Volver con el botón atrás a una página guardada en caché: sin hojas abiertas
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) allDialogs().forEach(finishClose);
  });

  /* ── Deslizar hacia abajo para cerrar ───────────────────────────── */

  document.querySelectorAll<HTMLElement>('[data-sheet-drag]').forEach((handle) => {
    const dlg = handle.closest('dialog');
    if (!dlg) return;
    let startY = 0;
    let dy = 0;
    let dragging = false;

    handle.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' || (e.target as Element).closest('button')) return;
      dragging = true;
      startY = e.clientY;
      dy = 0;
      try {
        handle.setPointerCapture(e.pointerId);
      } catch {
        /* puntero ya liberado: el arrastre sigue sin captura */
      }
      dlg.style.transition = 'none';
    });
    handle.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      dy = Math.max(0, e.clientY - startY);
      dlg.style.transform = `translateY(${dy}px)`;
    });
    const end = () => {
      if (!dragging) return;
      dragging = false;
      dlg.style.transition = '';
      if (dy > Math.min(120, dlg.offsetHeight * 0.25)) {
        closeSheet(dlg);
      } else {
        dlg.style.transform = '';
      }
    };
    handle.addEventListener('pointerup', end);
    handle.addEventListener('pointercancel', end);
  });

  /* ── Pestañas: tocar la activa sube al principio, como en una app ── */

  document.querySelectorAll<HTMLAnchorElement>('.tabbar a.tab').forEach((tab) => {
    tab.addEventListener('click', (e) => {
      if (tab.pathname !== location.pathname) return;
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    });
  });

  /* ── Buscador ───────────────────────────────────────────────────── */

  const searchForm = document.querySelector<HTMLFormElement>('[data-search-form]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
  const searchClear = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const searchBody = document.querySelector<HTMLElement>('[data-search-body]');
  const emptyState = document.querySelector<HTMLElement>('[data-search-empty]');
  const resultsList = document.querySelector<HTMLUListElement>('[data-search-results]');
  const noResults = document.querySelector<HTMLElement>('[data-search-none]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');

  const BLOG_ICON =
    '<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M3.5 1.5h7l4 4v11h-11z"/><line x1="6.5" y1="9" x2="11.5" y2="9"/><line x1="6.5" y1="12" x2="11.5" y2="12"/></svg>';
  const MAX_RESULTS = 40;

  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

  let index: Entry[] | null = null;
  let indexPromise: Promise<Entry[]> | null = null;

  function loadIndex(): Promise<Entry[]> {
    if (!indexPromise) {
      indexPromise = fetch('/search.json')
        .then((r) => {
          if (!r.ok) throw new Error(`search.json ${r.status}`);
          return r.json() as Promise<SearchData>;
        })
        .then((data) => {
          const calcs: Entry[] = data.c.map(([url, name, desc, cat, icon]) => ({
            url,
            name,
            meta: cat ? `${cat} · ${desc}` : desc,
            icon: data.i[icon] ?? '',
            nn: norm(name),
            hay: norm(`${name} ${desc} ${cat} ${url.replace(/[/-]/g, ' ')}`),
            blog: false,
          }));
          const posts: Entry[] = data.b.map(([url, name, desc]) => ({
            url,
            name,
            meta: `Blog · ${desc}`,
            icon: BLOG_ICON,
            nn: norm(name),
            hay: norm(`${name} ${desc}`),
            blog: true,
          }));
          index = [...calcs, ...posts];
          return index;
        })
        .catch((err: unknown) => {
          indexPromise = null;
          throw err;
        });
    }
    return indexPromise;
  }

  /** Raíz de una palabra: "embarazada" → "embaraz", "corriendo" → "corrie" */
  const stem = (t: string) => (t.length >= 5 ? t.slice(0, Math.max(4, t.length - 3)) : t);

  function rank(terms: string[], entries: Entry[], loose: boolean): Entry[] {
    const scored: { s: number; e: Entry }[] = [];
    for (const e of entries) {
      const keys = loose ? terms.map(stem) : terms;
      if (!keys.every((t) => e.hay.includes(t))) continue;
      let s = e.blog ? 0 : 40;
      // "imc" → /imc antes que /imc-infantil
      if (e.url === `/${keys.join('-')}`) s += 200;
      if (e.nn.startsWith(keys[0])) s += 100;
      for (const t of keys) {
        if (e.nn.includes(t)) s += 30;
        if (` ${e.nn}`.includes(` ${t}`)) s += 15;
      }
      scored.push({ s, e });
    }
    scored.sort((a, b) => b.s - a.s || a.e.name.length - b.e.name.length || a.e.name.localeCompare(b.e.name, 'es'));
    return scored.slice(0, MAX_RESULTS).map((x) => x.e);
  }

  function row(e: Entry): HTMLLIElement {
    const li = document.createElement('li');
    const a = document.createElement('a');
    a.href = e.url;
    a.className = 'search-row';
    const icon = document.createElement('span');
    icon.className = 'search-row__icon';
    icon.innerHTML = e.icon; // SVG propio, generado en build desde calcData.ts
    const text = document.createElement('span');
    text.className = 'search-row__text';
    const name = document.createElement('span');
    name.className = 'search-row__name';
    name.textContent = e.name;
    const meta = document.createElement('span');
    meta.className = 'search-row__meta';
    meta.textContent = e.meta;
    text.append(name, meta);
    a.append(icon, text);
    li.append(a);
    return li;
  }

  function runSearch(): void {
    if (!searchInput || !emptyState || !resultsList || !noResults || !status) return;
    const q = searchInput.value;
    if (searchClear) searchClear.hidden = q.length === 0;
    const terms = norm(q).trim().split(/\s+/).filter(Boolean);

    if (terms.length === 0) {
      emptyState.hidden = false;
      resultsList.hidden = true;
      noResults.hidden = true;
      status.textContent = '';
      return;
    }
    if (!index) {
      loadIndex()
        .then(() => runSearch())
        .catch(() => {
          emptyState.hidden = true;
          resultsList.hidden = true;
          noResults.hidden = false;
          noResults.textContent = 'No se pudo cargar el buscador. Revisa tu conexión.';
        });
      return;
    }

    let found = rank(terms, index, false);
    if (found.length === 0) found = rank(terms, index, true);

    emptyState.hidden = true;
    resultsList.replaceChildren(...found.map(row));
    resultsList.hidden = found.length === 0;
    noResults.hidden = found.length > 0;
    noResults.textContent = found.length ? '' : `Sin resultados para «${q.trim()}»`;
    status.textContent = found.length ? `${found.length} resultados` : 'Sin resultados';
  }

  searchInput?.addEventListener('input', runSearch);
  searchClear?.addEventListener('click', (e) => {
    e.preventDefault();
    if (!searchInput) return;
    searchInput.value = '';
    runSearch();
    searchInput.focus();
  });
  // Intro abre el primer resultado
  searchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const first = resultsList && !resultsList.hidden ? resultsList.querySelector('a') : null;
    if (first) location.href = first.href;
  });
  // Deslizar la lista esconde el teclado, como en las apps
  searchBody?.addEventListener('touchmove', () => searchInput?.blur(), { passive: true });
  // El índice se pide en cuanto el dedo toca la lupa, antes del click
  document.addEventListener('pointerdown', (e) => {
    if ((e.target as Element).closest('[data-sheet-open="search"]')) loadIndex().catch(() => undefined);
  });

  // SearchAction del schema (https://www.calcfit.com/?q=imc) y acceso directo
  // «Buscar» del icono de la app instalada (/?q=)
  const params = new URLSearchParams(location.search);
  if (params.has('q') && searchInput) {
    searchInput.value = params.get('q') ?? '';
    history.replaceState(history.state, '', location.pathname + location.hash);
    openSheet('search');
    runSearch();
  }

  /* ── Instalar como app y compartir ──────────────────────────────── */

  const nav = navigator as Navigator & { standalone?: boolean };
  const standalone = window.matchMedia('(display-mode: standalone)').matches || nav.standalone === true;
  if (standalone) html.classList.add('is-standalone');

  const installItem = document.querySelector<HTMLElement>('[data-install]');
  const installBtn = document.querySelector<HTMLButtonElement>('[data-install-btn]');
  const installHint = document.querySelector<HTMLElement>('[data-install-hint]');
  let installEvent: BeforeInstallPromptEvent | null = null;

  const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent) || (/macintosh/i.test(navigator.userAgent) && navigator.maxTouchPoints > 1);
  if (installItem && !standalone && isIOS) installItem.hidden = false;

  window.addEventListener('beforeinstallprompt', (e) => {
    installEvent = e as BeforeInstallPromptEvent;
    if (installItem) installItem.hidden = false;
  });
  window.addEventListener('appinstalled', () => {
    installEvent = null;
    if (installItem) installItem.hidden = true;
  });
  installBtn?.addEventListener('click', () => {
    if (installEvent) {
      const evt = installEvent;
      installEvent = null;
      evt
        .prompt()
        .then(() => evt.userChoice)
        .then((choice) => {
          if (choice.outcome === 'accepted' && installItem) installItem.hidden = true;
        })
        .catch(() => undefined);
    } else if (installHint) {
      installHint.hidden = !installHint.hidden;
    }
  });

  const shareItem = document.querySelector<HTMLElement>('[data-share]');
  if (shareItem && typeof navigator.share === 'function') {
    shareItem.hidden = false;
    document.querySelector('[data-share-btn]')?.addEventListener('click', () => {
      const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href;
      navigator.share({ title: document.title, url: canonical || location.href }).catch(() => undefined);
    });
  }
</script>

