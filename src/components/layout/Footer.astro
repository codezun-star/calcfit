---
---
<footer class="site-footer" style="background: #0A0A09; border-top: 1px solid #111;">

<style>
  .site-footer { padding: 32px 32px 24px; }
  @media (max-width: 640px) {
    .site-footer { padding: 24px 20px 20px; }
  }
</style>

  <!-- Top row -->
  <div style="display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 32px; padding-bottom: 28px; border-bottom: 1px solid #111; margin-bottom: 20px;">

    <!-- Logo + tagline -->
    <div>
      <a href="/" style="display: flex; align-items: center; gap: 6px; text-decoration: none; margin-bottom: 8px;">
        <svg width="15" height="15" viewBox="0 0 18 18" fill="#CAFF00" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="7.5" y="1" width="3" height="16"/>
          <rect x="1" y="7.5" width="16" height="3"/>
        </svg>
        <span style="font-family: var(--font-display); font-size: 22px; color: var(--acid);">CalcFit</span>
      </a>
      <p style="font-size: 12px; color: #888; max-width: 220px; line-height: 1.6;">Calculadoras de salud gratuitas y validadas científicamente.</p>
    </div>

    <!-- Links en columnas -->
    <div style="display: flex; gap: 48px; flex-wrap: wrap;">
      <div>
        <p style="font-family: var(--font-mono); font-size: 9px; color: #666; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 10px;">Herramientas</p>
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <a href="/imc"                style="font-size: 12px; color: #999; text-decoration: none;">Calculadora IMC</a>
          <a href="/calorias-diarias"   style="font-size: 12px; color: #999; text-decoration: none;">Calorías Diarias</a>
          <a href="/grasa-corporal"     style="font-size: 12px; color: #999; text-decoration: none;">Grasa Corporal</a>
          <a href="/frecuencia-cardiaca"style="font-size: 12px; color: #999; text-decoration: none;">Frecuencia Cardíaca</a>
          <a href="/#calculadoras"      style="font-size: 12px; color: #888; text-decoration: none;">Ver todas →</a>
        </div>
      </div>
      <div>
        <p style="font-family: var(--font-mono); font-size: 9px; color: #666; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 10px;">CalcFit</p>
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <a href="/sobre-nosotros"    style="font-size: 12px; color: #999; text-decoration: none;">Sobre nosotros</a>
          <a href="/contacto"          style="font-size: 12px; color: #999; text-decoration: none;">Contacto</a>
        </div>
      </div>
      <div>
        <p style="font-family: var(--font-mono); font-size: 9px; color: #666; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 10px;">Legal</p>
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <a href="/aviso-legal"          style="font-size: 12px; color: #999; text-decoration: none;">Aviso legal</a>
          <a href="/politica-privacidad"  style="font-size: 12px; color: #999; text-decoration: none;">Privacidad</a>
          <a href="/politica-cookies"     style="font-size: 12px; color: #999; text-decoration: none;">Cookies</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom row -->
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
    <span style="font-family: var(--font-mono); font-size: 10px; color: #666;">© 2026 CalcFit. Todos los derechos reservados.</span>
    <span style="font-family: var(--font-mono); font-size: 10px; color: #555;">Sin cookies de rastreo · Sin registros · Sin publicidad</span>
  </div>

</footer>
