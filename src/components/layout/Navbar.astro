---
/**
 * Barra superior fija de todas las páginas.
 *
 * - Escritorio: logo + enlaces + búsqueda + CTA, como siempre.
 * - Móvil (≤767px): barra de app nativa. Botón «atrás» en las pantallas que
 *   tienen padre, logo que se convierte en el título de la página cuando el H1
 *   sale de la pantalla (como el título grande de iOS) y botón de búsqueda.
 *   La navegación principal vive en la barra de pestañas (`AppShell.astro`).
 *
 * Incluye su propio espaciador: las páginas NO deben añadir otro.
 */
interface Props {
  /** Destino del botón atrás en móvil. Sin él se muestra sólo el logo (pantallas raíz). */
  back?: string;
  /** Nombre de la pantalla de destino, para el texto accesible del botón atrás */
  backLabel?: string;
  /** Título compacto que sustituye al logo al desplazar el H1 fuera de pantalla */
  title?: string;
  /** Home: los enlaces de escritorio son las anclas de categoría */
  home?: boolean;
}

const { back, backLabel = 'Inicio', title, home = false } = Astro.props;

const links = home
  ? [
      { href: '#fitness', label: 'Fitness' },
      { href: '#embarazo', label: 'Embarazo' },
      { href: '#fechas', label: 'Fechas' },
      { href: '#nutricion', label: 'Nutrición' },
      { href: '/blog', label: 'Blog' },
    ]
  : [
      { href: '/#calculadoras', label: 'Calculadoras' },
      { href: '/sobre-nosotros', label: 'Nosotros' },
      { href: '/blog', label: 'Blog' },
    ];
const ctaHref = home ? '#calculadoras' : '/#calculadoras';
---

<nav class:list={['app-bar', back && 'app-bar--back']} data-app-bar aria-label="Principal">
  <div class="app-bar__lead">
    {back && (
      <a href={back} class="app-bar__back" data-app-back aria-label={`Volver a ${backLabel}`}>
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <polyline points="13.5,4 6.5,11 13.5,18" />
        </svg>
      </a>
    )}
    <div class="app-bar__id">
      <a href="/" class="app-bar__brand">
        <img src="/logo.svg" width="147" height="44" alt="CalcFit" />
      </a>
      {title && <span class="app-bar__title" aria-hidden="true">{title}</span>}
    </div>
  </div>

  <div class="app-bar__actions">
    {links.map((l) => (
      <a href={l.href} class="app-bar__link">{l.label}</a>
    ))}
    <button type="button" class="app-bar__icon" data-sheet-open="search" aria-haspopup="dialog" aria-label="Buscar calculadora">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true">
        <circle cx="8.5" cy="8.5" r="5.75" />
        <line x1="12.8" y1="12.8" x2="17.5" y2="17.5" />
      </svg>
    </button>
    <a href={ctaHref} class="app-bar__cta">Empezar</a>
  </div>
</nav>
<div class="app-bar-spacer" aria-hidden="true"></div>

<script>
  /* Botón atrás: si se llegó desde otra página del sitio, «atrás» vuelve a
     ella (con su scroll), como en una app. Si se entró directo —buscador,
     enlace compartido, pestaña nueva—, lleva a la pantalla padre. */
  document.querySelector<HTMLAnchorElement>('[data-app-back]')?.addEventListener('click', (e) => {
    try {
      const ref = document.referrer ? new URL(document.referrer) : null;
      if (ref && ref.origin === location.origin && ref.href !== location.href && history.length > 1) {
        e.preventDefault();
        history.back();
      }
    } catch {
      /* referrer ilegible: se sigue el enlace */
    }
  });

  /* Título compacto: aparece en la barra cuando el H1 sale de la pantalla */
  const bar = document.querySelector<HTMLElement>('[data-app-bar]');
  const h1 = document.querySelector('h1');
  if (bar && h1 && bar.querySelector('.app-bar__title') && 'IntersectionObserver' in window) {
    const barH = bar.offsetHeight || 56;
    new IntersectionObserver(
      ([entry]) => bar.classList.toggle('is-titled', !entry.isIntersecting && entry.boundingClientRect.top < barH),
      { rootMargin: `-${barH}px 0px 0px 0px` },
    ).observe(h1);
  }
</script>

<style is:global>
  .app-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--appbar-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 max(32px, env(safe-area-inset-right, 0px)) 0 max(32px, env(safe-area-inset-left, 0px));
    background: var(--ink);
    border-bottom: 1px solid var(--ink);
    transition: border-color 0.2s;
  }
  .app-bar-spacer { height: var(--appbar-h); }

  .app-bar__lead { display: flex; align-items: center; min-width: 0; flex: 1 1 auto; }
  .app-bar__id   { position: relative; display: flex; align-items: center; min-width: 0; flex: 1 1 auto; height: var(--appbar-h); }
  .app-bar__brand { display: flex; align-items: center; text-decoration: none; transition: opacity 0.2s, transform 0.2s; }
  .app-bar__brand img { display: block; width: auto; height: 44px; }

  .app-bar__back,
  .app-bar__title { display: none; }

  .app-bar__actions { display: flex; align-items: center; gap: 28px; flex: none; }
  .app-bar__link {
    font-size: 12px;
    color: #888;
    letter-spacing: 0.5px;
    text-decoration: none;
  }
  .app-bar__link:hover { color: var(--acid); }
  .app-bar__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin: 0 -10px 0 -8px;
    padding: 0;
    color: #999;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .app-bar__icon:hover { color: var(--acid); }
  .app-bar__cta {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    background: var(--acid);
    color: var(--ink);
    padding: 7px 16px;
    text-decoration: none;
  }

  /* ── Móvil: barra de app ─────────────────────────────────────────── */
  @media (max-width: 767px) {
    .app-bar {
      padding: 0 max(4px, env(safe-area-inset-right, 0px)) 0 max(16px, env(safe-area-inset-left, 0px));
      view-transition-name: app-bar;
      -webkit-user-select: none;
      user-select: none;
    }
    .app-bar--back { padding-left: max(2px, env(safe-area-inset-left, 0px)); }
    .app-bar.is-titled { border-bottom-color: var(--ink-3); }

    .app-bar__back {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: none;
      width: 44px;
      height: 44px;
      color: var(--acid);
      text-decoration: none;
    }
    .app-bar__brand img { height: 38px; }

    .app-bar__title {
      display: block;
      position: absolute;
      inset: 0;
      padding-right: 8px;
      font-family: var(--font-display);
      font-size: 23px;
      letter-spacing: 0.3px;
      line-height: var(--appbar-h);
      color: #fff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.2s, transform 0.2s;
      pointer-events: none;
    }
    .app-bar.is-titled .app-bar__brand { opacity: 0; transform: translateY(-8px); pointer-events: none; }
    .app-bar.is-titled .app-bar__title { opacity: 1; transform: none; }

    .app-bar__link,
    .app-bar__cta { display: none; }
    .app-bar__actions { gap: 0; }
    .app-bar__icon { width: 44px; height: 44px; margin: 0; color: #ccc; }
  }
</style>
