---
/**
 * Columna lateral pegajosa con los formatos verticales (160×600 + 160×300).
 * Sólo aparece a partir de 1200px, donde sobra espacio junto a la columna de
 * contenido: nunca se superpone al texto ni existe en móvil.
 */
import AdSlot from './AdSlot.astro';
---

<aside class="ad-rail" aria-label="Publicidad">
  <div class="ad-rail__inner">
    <AdSlot format="skyscraper" mobile="none" gap="0" />
    <AdSlot format="halfsky" mobile="none" gap="0" />
  </div>
</aside>

<style is:global>
  .ad-rail { display: none; }
  @media (min-width: 1200px) {
    .ad-rail {
      display: block;
      flex: 0 0 160px;
      width: 160px;
    }
    .ad-rail__inner {
      position: sticky;
      top: 76px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .ad-rail .ad-unit { margin: 0 !important; }
  }
</style>
